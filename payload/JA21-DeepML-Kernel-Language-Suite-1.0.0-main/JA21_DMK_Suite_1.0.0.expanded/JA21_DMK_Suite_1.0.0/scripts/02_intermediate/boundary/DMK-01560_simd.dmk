module corpus.deepml_kernel.example_01560
use DeepMLKernel
policy no_network

kernel DMK_01560(input: Tensor<f32>[10,1]) -> Tensor<f32>[10,1]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..10 tile 1 {
        vectorize 1
        output[i] = input[i] * 11.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01560.dmk"
