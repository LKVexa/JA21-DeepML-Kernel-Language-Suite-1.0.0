module corpus.deepml_kernel.example_01561
use DeepMLKernel
policy no_network

kernel DMK_01561(input: Tensor<f32>[11,1]) -> Tensor<f32>[11,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..11 tile 1 {
        vectorize 1
        output[i] = input[i] * 12.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01561.dmk"
