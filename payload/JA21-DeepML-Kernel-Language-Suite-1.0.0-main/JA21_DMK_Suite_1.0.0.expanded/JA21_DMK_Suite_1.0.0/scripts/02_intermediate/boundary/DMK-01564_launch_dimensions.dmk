module corpus.deepml_kernel.example_01564
use DeepMLKernel
policy no_network

kernel DMK_01564(input: Tensor<f32>[14,1]) -> Tensor<f32>[14,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..14 tile 1 {
        vectorize 1
        output[i] = input[i] * 15.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01564.dmk"
