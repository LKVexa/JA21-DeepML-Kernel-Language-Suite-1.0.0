module corpus.deepml_kernel.example_01644
use DeepMLKernel
policy no_network

kernel DMK_01644(input: Tensor<f32>[94,1]) -> Tensor<f32>[94,1]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..94 tile 1 {
        vectorize 1
        output[i] = input[i] * 2.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01644.dmk"
