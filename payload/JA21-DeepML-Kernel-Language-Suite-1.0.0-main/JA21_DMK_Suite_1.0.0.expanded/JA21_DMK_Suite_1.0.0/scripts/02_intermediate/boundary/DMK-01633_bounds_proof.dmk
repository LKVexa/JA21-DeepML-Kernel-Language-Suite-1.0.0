module corpus.deepml_kernel.example_01633
use DeepMLKernel
policy no_network

kernel DMK_01633(input: Tensor<f32>[83,1]) -> Tensor<f32>[83,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..83 tile 1 {
        vectorize 1
        output[i] = input[i] * 22.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01633.dmk"
