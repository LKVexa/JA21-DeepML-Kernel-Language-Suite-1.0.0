module corpus.deepml_kernel.example_01643
use DeepMLKernel
policy no_network

kernel DMK_01643(input: Tensor<f32>[93,1]) -> Tensor<f32>[93,1]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..93 tile 1 {
        vectorize 1
        output[i] = input[i] * 1.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01643.dmk"
