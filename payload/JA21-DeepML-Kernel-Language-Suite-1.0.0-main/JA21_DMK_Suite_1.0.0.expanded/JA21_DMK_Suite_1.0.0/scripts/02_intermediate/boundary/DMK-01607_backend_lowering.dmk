module corpus.deepml_kernel.example_01607
use DeepMLKernel
policy no_network

kernel DMK_01607(input: Tensor<f32>[57,1]) -> Tensor<f32>[57,1]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..57 tile 1 {
        vectorize 1
        output[i] = input[i] * 27.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01607.dmk"
