module corpus.deepml_kernel.example_01603
use DeepMLKernel
policy no_network

kernel DMK_01603(input: Tensor<f32>[53,1]) -> Tensor<f32>[53,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..53 tile 1 {
        vectorize 1
        output[i] = input[i] * 23.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01603.dmk"
