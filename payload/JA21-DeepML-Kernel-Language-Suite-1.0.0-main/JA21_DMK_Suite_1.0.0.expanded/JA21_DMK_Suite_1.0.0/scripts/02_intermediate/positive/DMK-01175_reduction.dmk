module corpus.deepml_kernel.example_01175
use DeepMLKernel
policy no_network

kernel DMK_01175(input: Tensor<f32>[13,64]) -> Tensor<f32>[13,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..13 tile 32 {
        vectorize 16
        output[i] = input[i] * 29.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01175.dmk"
