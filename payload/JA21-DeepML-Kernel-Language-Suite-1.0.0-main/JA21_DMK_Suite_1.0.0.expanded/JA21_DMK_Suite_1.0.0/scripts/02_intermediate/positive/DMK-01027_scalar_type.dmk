module corpus.deepml_kernel.example_01027
use DeepMLKernel
policy no_network

kernel DMK_01027(input: Tensor<f32>[59,64]) -> Tensor<f32>[59,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..59 tile 32 {
        vectorize 16
        output[i] = input[i] * 5.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01027.dmk"
