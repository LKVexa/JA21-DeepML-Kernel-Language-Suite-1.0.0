module corpus.deepml_kernel.example_01004
use DeepMLKernel
policy no_network

kernel DMK_01004(input: Tensor<f32>[36,16]) -> Tensor<f32>[36,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..36 tile 16 {
        vectorize 16
        output[i] = input[i] * 13.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01004.dmk"
