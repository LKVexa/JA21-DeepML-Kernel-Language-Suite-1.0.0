ja source 0.3
module corpus.deepml_kernel.example_01120
use DeepMLKernel
policy no_network

kernel DMK_01120(input: Tensor<f32>[55,16]) -> Tensor<f32>[55,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..55 tile 16 {
        vectorize 16
        output[i] = input[i] * 5.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01120.dmk"
