module corpus.deepml_kernel.example_01301
use DeepMLKernel
policy no_network

kernel DMK_01301(input: Tensor<f32>[42,32]) -> Tensor<f32>[42,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..42 tile 32 {
        vectorize 16
        output[i] = input[i] * 31.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01301.dmk"
