module corpus.deepml_kernel.example_01376
use DeepMLKernel
policy no_network

kernel DMK_01376(input: Tensor<f32>[20,16]) -> Tensor<f32>[20,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..20 tile 16 {
        vectorize 16
        output[i] = input[i] * 13.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01376.dmk"
