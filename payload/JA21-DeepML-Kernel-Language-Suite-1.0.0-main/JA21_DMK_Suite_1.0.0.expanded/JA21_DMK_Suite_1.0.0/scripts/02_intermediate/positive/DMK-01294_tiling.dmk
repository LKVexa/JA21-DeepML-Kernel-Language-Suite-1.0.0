module corpus.deepml_kernel.example_01294
use DeepMLKernel
policy no_network

kernel DMK_01294(input: Tensor<f32>[35,48]) -> Tensor<f32>[35,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..35 tile 32 {
        vectorize 16
        output[i] = input[i] * 24.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01294.dmk"
