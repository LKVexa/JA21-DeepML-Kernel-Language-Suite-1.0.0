module corpus.deepml_kernel.example_01239
use DeepMLKernel
policy no_network

kernel DMK_01239(input: Tensor<f32>[77,64]) -> Tensor<f32>[77,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..77 tile 32 {
        vectorize 16
        output[i] = input[i] * 31.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01239.dmk"
