module corpus.deepml_kernel.example_01263
use DeepMLKernel
policy no_network

kernel DMK_01263(input: Tensor<f32>[4,64]) -> Tensor<f32>[4,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..4 tile 32 {
        vectorize 16
        output[i] = input[i] * 24.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01263.dmk"
