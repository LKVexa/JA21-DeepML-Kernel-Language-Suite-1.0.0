module corpus.deepml_kernel.example_01034
use DeepMLKernel
policy no_network

kernel DMK_01034(input: Tensor<f32>[66,48]) -> Tensor<f32>[66,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..66 tile 32 {
        vectorize 16
        output[i] = input[i] * 12.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01034.dmk"
