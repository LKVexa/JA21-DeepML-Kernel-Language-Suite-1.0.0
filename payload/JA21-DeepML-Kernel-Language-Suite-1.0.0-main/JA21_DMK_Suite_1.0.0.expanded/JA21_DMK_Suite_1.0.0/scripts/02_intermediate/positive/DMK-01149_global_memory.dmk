module corpus.deepml_kernel.example_01149
use DeepMLKernel
policy no_network

kernel DMK_01149(input: Tensor<f32>[84,32]) -> Tensor<f32>[84,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..84 tile 32 {
        vectorize 16
        output[i] = input[i] * 3.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01149.dmk"
