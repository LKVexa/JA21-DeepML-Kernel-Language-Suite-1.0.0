module corpus.deepml_kernel.example_01399
use DeepMLKernel
policy no_network

kernel DMK_01399(input: Tensor<f32>[43,64]) -> Tensor<f32>[43,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..43 tile 32 {
        vectorize 16
        output[i] = input[i] * 5.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01399.dmk"
