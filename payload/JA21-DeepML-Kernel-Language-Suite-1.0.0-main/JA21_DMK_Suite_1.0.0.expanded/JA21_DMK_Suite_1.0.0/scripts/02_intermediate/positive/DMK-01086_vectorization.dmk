module corpus.deepml_kernel.example_01086
use DeepMLKernel
policy no_network

kernel DMK_01086(input: Tensor<f32>[21,48]) -> Tensor<f32>[21,48]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..21 tile 32 {
        vectorize 16
        output[i] = input[i] * 2.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01086.dmk"
