module corpus.deepml_kernel.example_01058
use DeepMLKernel
policy no_network

kernel DMK_01058(input: Tensor<f32>[90,48]) -> Tensor<f32>[90,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..90 tile 32 {
        vectorize 16
        output[i] = input[i] * 5.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01058.dmk"
