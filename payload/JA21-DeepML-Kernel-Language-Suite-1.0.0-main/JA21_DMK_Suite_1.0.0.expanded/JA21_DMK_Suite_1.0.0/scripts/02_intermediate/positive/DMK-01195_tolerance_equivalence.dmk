module corpus.deepml_kernel.example_01195
use DeepMLKernel
policy no_network

kernel DMK_01195(input: Tensor<f32>[33,64]) -> Tensor<f32>[33,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..33 tile 32 {
        vectorize 16
        output[i] = input[i] * 18.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01195.dmk"
