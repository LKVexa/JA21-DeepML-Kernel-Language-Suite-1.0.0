module corpus.deepml_kernel.example_01217
use DeepMLKernel
policy no_network

kernel DMK_01217(input: Tensor<f32>[55,32]) -> Tensor<f32>[55,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..55 tile 32 {
        vectorize 16
        output[i] = input[i] * 9.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01217.dmk"
