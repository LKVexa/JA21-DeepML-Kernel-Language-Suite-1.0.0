module corpus.deepml_kernel.example_01035
use DeepMLKernel
policy no_network

kernel DMK_01035(input: Tensor<f32>[67,64]) -> Tensor<f32>[67,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..67 tile 32 {
        vectorize 16
        output[i] = input[i] * 13.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01035.dmk"
