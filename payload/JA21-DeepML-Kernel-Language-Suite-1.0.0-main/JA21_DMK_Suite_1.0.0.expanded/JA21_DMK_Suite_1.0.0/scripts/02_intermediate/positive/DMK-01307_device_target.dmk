module corpus.deepml_kernel.example_01307
use DeepMLKernel
policy no_network

kernel DMK_01307(input: Tensor<f32>[48,64]) -> Tensor<f32>[48,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..48 tile 32 {
        vectorize 16
        output[i] = input[i] * 6.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01307.dmk"
