module corpus.deepml_kernel.example_01226
use DeepMLKernel
policy no_network

kernel DMK_01226(input: Tensor<f32>[64,48]) -> Tensor<f32>[64,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..64 tile 32 {
        vectorize 16
        output[i] = input[i] * 18.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01226.dmk"
