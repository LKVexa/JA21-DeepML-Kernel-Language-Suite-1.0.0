module corpus.deepml_kernel.example_01164
use DeepMLKernel
policy no_network

kernel DMK_01164(input: Tensor<f32>[2,16]) -> Tensor<f32>[2,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..2 tile 16 {
        vectorize 16
        output[i] = input[i] * 18.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01164.dmk"
