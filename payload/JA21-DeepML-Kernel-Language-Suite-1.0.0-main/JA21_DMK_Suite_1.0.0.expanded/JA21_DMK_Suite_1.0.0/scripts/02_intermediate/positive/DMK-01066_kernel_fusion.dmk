module corpus.deepml_kernel.example_01066
use DeepMLKernel
policy no_network

kernel DMK_01066(input: Tensor<f32>[98,48]) -> Tensor<f32>[98,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..98 tile 32 {
        vectorize 16
        output[i] = input[i] * 13.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01066.dmk"
