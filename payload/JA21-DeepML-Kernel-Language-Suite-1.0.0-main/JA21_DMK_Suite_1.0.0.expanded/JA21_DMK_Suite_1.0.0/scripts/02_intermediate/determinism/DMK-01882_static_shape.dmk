module corpus.deepml_kernel.example_01882
use DeepMLKernel
policy no_network

kernel DMK_01882(input: Tensor<f32>[41,48]) -> Tensor<f32>[41,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..41 tile 32 {
        vectorize 16
        output[i] = input[i] * 23.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01882.dmk"
