module corpus.deepml_kernel.example_01540
use DeepMLKernel
policy no_network

kernel DMK_01540(input: Tensor<f32>[87,16]) -> Tensor<f32>[87,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..87 tile 16 {
        vectorize 16
        output[i] = input[i] * 22.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_01540.dmk"
