module corpus.deepml_kernel.example_01419
use DeepMLKernel
policy no_network

kernel DMK_01419(input: Tensor<f32>[63,64]) -> Tensor<f32>[63,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..63 tile 32 {
        vectorize 16
        output[i] = input[i] * 25.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_01419.dmk"
