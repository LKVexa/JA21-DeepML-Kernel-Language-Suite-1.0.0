module corpus.deepml_kernel.example_01536
use DeepMLKernel
policy no_network

kernel DMK_01536(input: Tensor<f32>[83,16]) -> Tensor<f32>[83,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..83 tile 16 {
        vectorize 16
        output[i] = input[i] * 18.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_01536.dmk"
