module corpus.deepml_kernel.example_01433
use DeepMLKernel
policy no_network

kernel DMK_01433(input: Tensor<f32>[77,32]) -> Tensor<f32>[77,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..77 tile 32 {
        vectorize 16
        output[i] = input[i] * 8.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_01433.dmk"
