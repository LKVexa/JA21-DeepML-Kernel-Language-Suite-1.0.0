module corpus.deepml_kernel.example_01486
use DeepMLKernel
policy no_network

kernel DMK_01486(input: Tensor<f32>[33,48]) -> Tensor<f32>[33,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..33 tile 32 {
        vectorize 16
        output[i] = input[i] * 30.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_01486.dmk"
