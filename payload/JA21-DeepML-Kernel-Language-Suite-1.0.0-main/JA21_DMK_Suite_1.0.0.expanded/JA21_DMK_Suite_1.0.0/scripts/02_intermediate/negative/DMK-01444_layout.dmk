module corpus.deepml_kernel.example_01444
use DeepMLKernel
policy no_network

kernel DMK_01444(input: Tensor<f32>[88,16]) -> Tensor<f32>[88,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..88 tile 16 {
        vectorize 16
        output[i] = input[i] * 19.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_01444.dmk"
