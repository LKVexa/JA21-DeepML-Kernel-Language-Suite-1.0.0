ja source 0.3
module corpus.deepml_kernel.example_01503
use DeepMLKernel
policy no_network

kernel DMK_01503(input: Tensor<f32>[50,64]) -> Tensor<f32>[50,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..50 tile 32 {
        vectorize 16
        output[i] = input[i] * 16.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_01503.dmk"
