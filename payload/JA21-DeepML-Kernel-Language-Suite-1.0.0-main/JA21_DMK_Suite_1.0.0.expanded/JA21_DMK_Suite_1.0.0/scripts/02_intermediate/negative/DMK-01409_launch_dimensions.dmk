module corpus.deepml_kernel.example_01409
use DeepMLKernel
policy no_network

kernel DMK_01409(input: Tensor<f32>[53,32]) -> Tensor<f32>[53,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..53 tile 32 {
        vectorize 16
        output[i] = input[i] * 15.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_01409.dmk"
