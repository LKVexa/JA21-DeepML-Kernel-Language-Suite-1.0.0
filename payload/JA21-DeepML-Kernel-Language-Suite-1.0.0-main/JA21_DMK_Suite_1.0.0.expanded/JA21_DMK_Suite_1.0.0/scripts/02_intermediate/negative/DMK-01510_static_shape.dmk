module corpus.deepml_kernel.example_01510
use DeepMLKernel
policy no_network

kernel DMK_01510(input: Tensor<f32>[57,48]) -> Tensor<f32>[57,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..57 tile 32 {
        vectorize 16
        output[i] = input[i] * 23.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_01510.dmk"
