module corpus.deepml_kernel.example_01539
use DeepMLKernel
policy no_network

kernel DMK_01539(input: Tensor<f32>[86,64]) -> Tensor<f32>[86,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..86 tile 32 {
        vectorize 16
        output[i] = input[i] * 21.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_01539.dmk"
