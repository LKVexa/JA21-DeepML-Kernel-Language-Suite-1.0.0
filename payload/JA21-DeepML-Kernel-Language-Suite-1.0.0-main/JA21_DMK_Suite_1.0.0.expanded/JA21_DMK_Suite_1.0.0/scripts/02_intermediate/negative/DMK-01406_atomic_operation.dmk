module corpus.deepml_kernel.example_01406
use DeepMLKernel
policy no_network

kernel DMK_01406(input: Tensor<f32>[50,48]) -> Tensor<f32>[50,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..50 tile 32 {
        vectorize 16
        output[i] = input[i] * 12.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_01406.dmk"
