module corpus.deepml_kernel.example_01483
use DeepMLKernel
policy no_network

kernel DMK_01483(input: Tensor<f32>[30,64]) -> Tensor<f32>[30,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..30 tile 32 {
        vectorize 16
        output[i] = input[i] * 27.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_01483.dmk"
