module corpus.deepml_kernel.example_01778
use DeepMLKernel
policy no_network

kernel DMK_01778(input: Tensor<f32>[34,48]) -> Tensor<f32>[34,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..34 tile 32 {
        vectorize 16
        output[i] = input[i] * 12.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_01778.dmk"
