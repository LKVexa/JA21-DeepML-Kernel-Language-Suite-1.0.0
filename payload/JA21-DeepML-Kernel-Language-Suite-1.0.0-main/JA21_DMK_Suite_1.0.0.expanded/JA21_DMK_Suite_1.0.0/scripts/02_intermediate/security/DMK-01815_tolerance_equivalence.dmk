module corpus.deepml_kernel.example_01815
use DeepMLKernel
policy no_network

kernel DMK_01815(input: Tensor<f32>[71,64]) -> Tensor<f32>[71,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..71 tile 32 {
        vectorize 16
        output[i] = input[i] * 18.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_01815.dmk"
