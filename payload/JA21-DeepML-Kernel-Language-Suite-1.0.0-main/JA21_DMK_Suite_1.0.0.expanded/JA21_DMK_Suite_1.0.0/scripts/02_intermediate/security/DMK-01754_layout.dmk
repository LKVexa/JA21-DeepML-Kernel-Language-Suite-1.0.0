module corpus.deepml_kernel.example_01754
use DeepMLKernel
policy no_network

kernel DMK_01754(input: Tensor<f32>[10,48]) -> Tensor<f32>[10,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..10 tile 32 {
        vectorize 16
        output[i] = input[i] * 19.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_01754.dmk"
