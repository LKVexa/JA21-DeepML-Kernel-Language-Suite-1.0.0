module corpus.deepml_kernel.example_01776
use DeepMLKernel
policy no_network

kernel DMK_01776(input: Tensor<f32>[32,16]) -> Tensor<f32>[32,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..32 tile 16 {
        vectorize 16
        output[i] = input[i] * 10.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_01776.dmk"
