module corpus.deepml_kernel.example_01824
use DeepMLKernel
policy no_network

kernel DMK_01824(input: Tensor<f32>[80,16]) -> Tensor<f32>[80,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..80 tile 16 {
        vectorize 16
        output[i] = input[i] * 27.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_01824.dmk"
