module corpus.deepml_kernel.example_01980
use DeepMLKernel
policy no_network

kernel DMK_01980(input: Tensor<f32>[42,16]) -> Tensor<f32>[42,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..42 tile 16 {
        vectorize 16
        output[i] = input[i] * 28.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01980.dmk"
