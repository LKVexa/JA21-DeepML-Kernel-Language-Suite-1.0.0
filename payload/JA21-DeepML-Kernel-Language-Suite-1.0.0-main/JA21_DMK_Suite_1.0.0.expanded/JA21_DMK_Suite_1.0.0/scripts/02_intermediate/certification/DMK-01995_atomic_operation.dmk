module corpus.deepml_kernel.example_01995
use DeepMLKernel
policy no_network

kernel DMK_01995(input: Tensor<f32>[57,64]) -> Tensor<f32>[57,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..57 tile 32 {
        vectorize 16
        output[i] = input[i] * 12.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01995.dmk"
