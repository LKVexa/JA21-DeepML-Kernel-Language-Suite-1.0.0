module corpus.deepml_kernel.example_01964
use DeepMLKernel
policy no_network

kernel DMK_01964(input: Tensor<f32>[26,16]) -> Tensor<f32>[26,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..26 tile 16 {
        vectorize 16
        output[i] = input[i] * 12.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_01964.dmk"
