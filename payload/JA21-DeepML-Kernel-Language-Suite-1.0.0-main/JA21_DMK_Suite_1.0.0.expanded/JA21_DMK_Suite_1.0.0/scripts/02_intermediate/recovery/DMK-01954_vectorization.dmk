module corpus.deepml_kernel.example_01954
use DeepMLKernel
policy no_network

kernel DMK_01954(input: Tensor<f32>[16,48]) -> Tensor<f32>[16,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..16 tile 32 {
        vectorize 16
        output[i] = input[i] * 2.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_01954.dmk"
