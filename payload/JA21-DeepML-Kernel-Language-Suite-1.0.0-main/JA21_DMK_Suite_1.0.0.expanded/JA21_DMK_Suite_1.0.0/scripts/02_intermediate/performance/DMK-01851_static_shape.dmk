module corpus.deepml_kernel.example_01851
use DeepMLKernel
policy no_network

kernel DMK_01851(input: Tensor<f32>[10,64]) -> Tensor<f32>[10,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..10 tile 32 {
        vectorize 16
        output[i] = input[i] * 23.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01851.dmk"
