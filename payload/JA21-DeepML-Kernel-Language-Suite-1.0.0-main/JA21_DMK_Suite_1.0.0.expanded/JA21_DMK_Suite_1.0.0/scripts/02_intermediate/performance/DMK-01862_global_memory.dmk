ja source 0.3
module corpus.deepml_kernel.example_01862
use DeepMLKernel
policy no_network

kernel DMK_01862(input: Tensor<f32>[21,48]) -> Tensor<f32>[21,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..21 tile 32 {
        vectorize 16
        output[i] = input[i] * 3.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01862.dmk"
