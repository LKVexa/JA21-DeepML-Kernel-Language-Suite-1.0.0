module corpus.deepml_kernel.example_01847
use DeepMLKernel
policy no_network

kernel DMK_01847(input: Tensor<f32>[6,64]) -> Tensor<f32>[6,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..6 tile 32 {
        vectorize 16
        output[i] = input[i] * 19.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01847.dmk"
