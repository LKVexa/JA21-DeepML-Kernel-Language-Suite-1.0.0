module corpus.deepml_kernel.example_01736
use DeepMLKernel
policy no_network

kernel DMK_01736(input: Tensor<f32>[89,16]) -> Tensor<f32>[89,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..89 tile 16 {
        vectorize 16
        output[i] = input[i] * 1.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01736.dmk"
