module corpus.deepml_kernel.example_01657
use DeepMLKernel
policy no_network

kernel DMK_01657(input: Tensor<f32>[10,32]) -> Tensor<f32>[10,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..10 tile 32 {
        vectorize 16
        output[i] = input[i] * 15.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01657.dmk"
