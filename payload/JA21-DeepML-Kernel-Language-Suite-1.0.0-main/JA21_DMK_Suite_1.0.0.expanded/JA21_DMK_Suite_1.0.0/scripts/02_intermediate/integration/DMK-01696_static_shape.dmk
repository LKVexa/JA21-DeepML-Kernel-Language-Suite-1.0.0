module corpus.deepml_kernel.example_01696
use DeepMLKernel
policy no_network

kernel DMK_01696(input: Tensor<f32>[49,16]) -> Tensor<f32>[49,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..49 tile 16 {
        vectorize 16
        output[i] = input[i] * 23.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01696.dmk"
