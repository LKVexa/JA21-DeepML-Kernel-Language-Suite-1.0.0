module corpus.deepml_kernel.example_01654
use DeepMLKernel
policy no_network

kernel DMK_01654(input: Tensor<f32>[7,48]) -> Tensor<f32>[7,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..7 tile 32 {
        vectorize 16
        output[i] = input[i] * 12.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01654.dmk"
