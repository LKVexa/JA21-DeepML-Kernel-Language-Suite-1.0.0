module corpus.deepml_kernel.example_01949
use DeepMLKernel
policy no_network

kernel DMK_01949(input: Tensor<f32>[11,32]) -> Tensor<f32>[11,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..11 tile 32 {
        vectorize 16
        output[i] = input[i] * 28.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_01949.dmk"
