module corpus.deepml_kernel.example_07847
use DeepMLKernel
policy no_network

kernel DMK_07847(input: Tensor<f32>[89,64]) -> Tensor<f32>[89,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..89 tile 32 {
        vectorize 16
        output[i] = input[i] * 5.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07847.dmk"
