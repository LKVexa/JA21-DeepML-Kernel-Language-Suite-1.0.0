module corpus.deepml_kernel.example_07915
use DeepMLKernel
policy no_network

kernel DMK_07915(input: Tensor<f32>[60,64]) -> Tensor<f32>[60,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..60 tile 32 {
        vectorize 16
        output[i] = input[i] * 11.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07915.dmk"
