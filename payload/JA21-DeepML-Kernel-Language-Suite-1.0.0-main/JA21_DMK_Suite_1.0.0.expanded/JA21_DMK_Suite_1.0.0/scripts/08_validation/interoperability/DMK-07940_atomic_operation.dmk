module corpus.deepml_kernel.example_07940
use DeepMLKernel
policy no_network

kernel DMK_07940(input: Tensor<f32>[85,16]) -> Tensor<f32>[85,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..85 tile 16 {
        vectorize 16
        output[i] = input[i] * 5.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07940.dmk"
