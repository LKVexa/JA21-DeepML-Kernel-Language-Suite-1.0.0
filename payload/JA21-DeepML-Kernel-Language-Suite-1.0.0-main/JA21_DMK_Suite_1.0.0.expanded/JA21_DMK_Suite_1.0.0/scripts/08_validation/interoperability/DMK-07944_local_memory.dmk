module corpus.deepml_kernel.example_07944
use DeepMLKernel
policy no_network

kernel DMK_07944(input: Tensor<f32>[89,16]) -> Tensor<f32>[89,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..89 tile 16 {
        vectorize 16
        output[i] = input[i] * 9.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07944.dmk"
