module corpus.deepml_kernel.example_07610
use DeepMLKernel
policy no_network

kernel DMK_07610(input: Tensor<f32>[46,1]) -> Tensor<f32>[46,1]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..46 tile 1 {
        vectorize 1
        output[i] = input[i] * 16.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07610.dmk"
