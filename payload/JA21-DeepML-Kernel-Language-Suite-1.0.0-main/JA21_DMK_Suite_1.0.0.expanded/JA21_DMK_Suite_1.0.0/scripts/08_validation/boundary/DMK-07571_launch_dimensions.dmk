module corpus.deepml_kernel.example_07571
use DeepMLKernel
policy no_network

kernel DMK_07571(input: Tensor<f32>[7,1]) -> Tensor<f32>[7,1]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..7 tile 1 {
        vectorize 1
        output[i] = input[i] * 8.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07571.dmk"
