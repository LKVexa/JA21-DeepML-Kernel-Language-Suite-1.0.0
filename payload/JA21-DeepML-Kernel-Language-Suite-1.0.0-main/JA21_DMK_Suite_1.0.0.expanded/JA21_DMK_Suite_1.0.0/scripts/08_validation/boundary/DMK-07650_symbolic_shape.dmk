module corpus.deepml_kernel.example_07650
use DeepMLKernel
policy no_network

kernel DMK_07650(input: Tensor<f32>[86,1]) -> Tensor<f32>[86,1]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..86 tile 1 {
        vectorize 1
        output[i] = input[i] * 25.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07650.dmk"
