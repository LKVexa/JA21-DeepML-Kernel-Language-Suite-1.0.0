module corpus.deepml_kernel.example_07567
use DeepMLKernel
policy no_network

kernel DMK_07567(input: Tensor<f32>[3,1]) -> Tensor<f32>[3,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..3 tile 1 {
        vectorize 1
        output[i] = input[i] * 4.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07567.dmk"
