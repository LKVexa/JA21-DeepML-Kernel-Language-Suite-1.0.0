module corpus.deepml_kernel.example_07568
use DeepMLKernel
policy no_network

kernel DMK_07568(input: Tensor<f32>[4,1]) -> Tensor<f32>[4,1]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..4 tile 1 {
        vectorize 1
        output[i] = input[i] * 5.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07568.dmk"
