module corpus.deepml_kernel.example_07638
use DeepMLKernel
policy no_network

kernel DMK_07638(input: Tensor<f32>[74,1]) -> Tensor<f32>[74,1]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..74 tile 1 {
        vectorize 1
        output[i] = input[i] * 13.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07638.dmk"
