module corpus.deepml_kernel.example_07743
use DeepMLKernel
policy no_network

kernel DMK_07743(input: Tensor<f32>[82,64]) -> Tensor<f32>[82,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..82 tile 32 {
        vectorize 16
        output[i] = input[i] * 25.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07743.dmk"
