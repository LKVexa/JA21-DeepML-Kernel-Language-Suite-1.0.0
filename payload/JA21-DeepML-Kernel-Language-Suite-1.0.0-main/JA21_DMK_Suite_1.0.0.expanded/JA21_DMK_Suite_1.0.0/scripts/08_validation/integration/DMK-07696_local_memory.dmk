module corpus.deepml_kernel.example_07696
use DeepMLKernel
policy no_network

kernel DMK_07696(input: Tensor<f32>[35,16]) -> Tensor<f32>[35,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..35 tile 16 {
        vectorize 16
        output[i] = input[i] * 9.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07696.dmk"
