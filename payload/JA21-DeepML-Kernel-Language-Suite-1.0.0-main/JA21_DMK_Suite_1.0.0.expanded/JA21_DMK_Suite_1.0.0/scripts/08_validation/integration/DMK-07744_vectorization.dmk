module corpus.deepml_kernel.example_07744
use DeepMLKernel
policy no_network

kernel DMK_07744(input: Tensor<f32>[83,16]) -> Tensor<f32>[83,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..83 tile 16 {
        vectorize 16
        output[i] = input[i] * 26.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07744.dmk"
