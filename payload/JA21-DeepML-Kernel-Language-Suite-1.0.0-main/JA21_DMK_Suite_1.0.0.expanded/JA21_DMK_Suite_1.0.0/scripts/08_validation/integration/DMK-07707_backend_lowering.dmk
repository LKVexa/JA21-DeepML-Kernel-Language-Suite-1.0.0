module corpus.deepml_kernel.example_07707
use DeepMLKernel
policy no_network

kernel DMK_07707(input: Tensor<f32>[46,64]) -> Tensor<f32>[46,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..46 tile 32 {
        vectorize 16
        output[i] = input[i] * 20.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07707.dmk"
