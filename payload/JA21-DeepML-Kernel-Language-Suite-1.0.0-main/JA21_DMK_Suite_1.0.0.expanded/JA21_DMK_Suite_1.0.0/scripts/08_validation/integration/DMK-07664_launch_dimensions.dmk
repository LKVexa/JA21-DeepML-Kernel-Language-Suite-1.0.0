module corpus.deepml_kernel.example_07664
use DeepMLKernel
policy no_network

kernel DMK_07664(input: Tensor<f32>[3,16]) -> Tensor<f32>[3,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..3 tile 16 {
        vectorize 16
        output[i] = input[i] * 8.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07664.dmk"
