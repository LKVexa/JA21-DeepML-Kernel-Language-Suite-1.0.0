module corpus.deepml_kernel.example_07731
use DeepMLKernel
policy no_network

kernel DMK_07731(input: Tensor<f32>[70,64]) -> Tensor<f32>[70,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..70 tile 32 {
        vectorize 16
        output[i] = input[i] * 13.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07731.dmk"
