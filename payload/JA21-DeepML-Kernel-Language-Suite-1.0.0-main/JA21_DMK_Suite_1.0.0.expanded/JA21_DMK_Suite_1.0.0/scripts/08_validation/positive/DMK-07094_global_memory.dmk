module corpus.deepml_kernel.example_07094
use DeepMLKernel
policy no_network

kernel DMK_07094(input: Tensor<f32>[15,48]) -> Tensor<f32>[15,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..15 tile 32 {
        vectorize 16
        output[i] = input[i] * 27.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07094.dmk"
