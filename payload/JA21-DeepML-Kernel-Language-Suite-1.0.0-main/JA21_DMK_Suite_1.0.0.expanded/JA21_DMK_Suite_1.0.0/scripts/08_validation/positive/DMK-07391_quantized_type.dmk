module corpus.deepml_kernel.example_07391
use DeepMLKernel
policy no_network

kernel DMK_07391(input: Tensor<f32>[21,64]) -> Tensor<f32>[21,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..21 tile 32 {
        vectorize 16
        output[i] = input[i] * 14.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07391.dmk"
