module corpus.deepml_kernel.example_07283
use DeepMLKernel
policy no_network

kernel DMK_07283(input: Tensor<f32>[10,64]) -> Tensor<f32>[10,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..10 tile 32 {
        vectorize 16
        output[i] = input[i] * 30.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07283.dmk"
