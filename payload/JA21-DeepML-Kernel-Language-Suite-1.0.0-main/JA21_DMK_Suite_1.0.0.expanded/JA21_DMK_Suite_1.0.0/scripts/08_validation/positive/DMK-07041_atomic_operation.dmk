module corpus.deepml_kernel.example_07041
use DeepMLKernel
policy no_network

kernel DMK_07041(input: Tensor<f32>[59,32]) -> Tensor<f32>[59,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..59 tile 32 {
        vectorize 16
        output[i] = input[i] * 5.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07041.dmk"
