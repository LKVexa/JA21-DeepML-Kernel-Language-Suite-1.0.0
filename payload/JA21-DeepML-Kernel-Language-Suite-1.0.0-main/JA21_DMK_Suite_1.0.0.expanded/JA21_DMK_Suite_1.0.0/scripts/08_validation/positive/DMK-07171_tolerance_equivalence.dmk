module corpus.deepml_kernel.example_07171
use DeepMLKernel
policy no_network

kernel DMK_07171(input: Tensor<f32>[92,64]) -> Tensor<f32>[92,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..92 tile 32 {
        vectorize 16
        output[i] = input[i] * 11.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07171.dmk"
