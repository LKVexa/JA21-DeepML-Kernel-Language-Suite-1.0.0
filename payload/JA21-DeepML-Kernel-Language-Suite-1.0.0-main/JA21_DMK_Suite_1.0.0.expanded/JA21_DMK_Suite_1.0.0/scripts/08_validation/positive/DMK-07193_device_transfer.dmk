module corpus.deepml_kernel.example_07193
use DeepMLKernel
policy no_network

kernel DMK_07193(input: Tensor<f32>[17,32]) -> Tensor<f32>[17,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..17 tile 32 {
        vectorize 16
        output[i] = input[i] * 2.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07193.dmk"
