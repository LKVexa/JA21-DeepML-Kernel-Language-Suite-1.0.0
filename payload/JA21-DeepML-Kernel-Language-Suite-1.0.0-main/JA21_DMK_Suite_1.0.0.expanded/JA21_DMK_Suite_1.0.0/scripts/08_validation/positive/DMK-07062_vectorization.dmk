module corpus.deepml_kernel.example_07062
use DeepMLKernel
policy no_network

kernel DMK_07062(input: Tensor<f32>[80,48]) -> Tensor<f32>[80,48]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..80 tile 32 {
        vectorize 16
        output[i] = input[i] * 26.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07062.dmk"
