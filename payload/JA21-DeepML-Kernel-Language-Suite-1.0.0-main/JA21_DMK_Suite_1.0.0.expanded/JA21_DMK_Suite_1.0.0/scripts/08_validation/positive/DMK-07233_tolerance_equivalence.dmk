module corpus.deepml_kernel.example_07233
use DeepMLKernel
policy no_network

kernel DMK_07233(input: Tensor<f32>[57,32]) -> Tensor<f32>[57,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..57 tile 32 {
        vectorize 16
        output[i] = input[i] * 11.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07233.dmk"
