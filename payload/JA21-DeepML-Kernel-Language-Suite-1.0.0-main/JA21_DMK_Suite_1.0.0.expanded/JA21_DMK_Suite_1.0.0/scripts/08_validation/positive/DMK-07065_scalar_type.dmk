module corpus.deepml_kernel.example_07065
use DeepMLKernel
policy no_network

kernel DMK_07065(input: Tensor<f32>[83,32]) -> Tensor<f32>[83,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..83 tile 32 {
        vectorize 16
        output[i] = input[i] * 29.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07065.dmk"
