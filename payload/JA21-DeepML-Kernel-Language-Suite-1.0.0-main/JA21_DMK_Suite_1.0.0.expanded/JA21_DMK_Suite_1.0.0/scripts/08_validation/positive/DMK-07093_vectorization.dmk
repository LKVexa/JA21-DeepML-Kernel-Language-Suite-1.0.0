module corpus.deepml_kernel.example_07093
use DeepMLKernel
policy no_network

kernel DMK_07093(input: Tensor<f32>[14,32]) -> Tensor<f32>[14,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..14 tile 32 {
        vectorize 16
        output[i] = input[i] * 26.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07093.dmk"
