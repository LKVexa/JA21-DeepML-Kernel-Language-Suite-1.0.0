module corpus.deepml_kernel.example_07182
use DeepMLKernel
policy no_network

kernel DMK_07182(input: Tensor<f32>[6,48]) -> Tensor<f32>[6,48]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..6 tile 32 {
        vectorize 16
        output[i] = input[i] * 22.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07182.dmk"
