module corpus.deepml_kernel.example_07140
use DeepMLKernel
policy no_network

kernel DMK_07140(input: Tensor<f32>[61,16]) -> Tensor<f32>[61,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..61 tile 16 {
        vectorize 16
        output[i] = input[i] * 11.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07140.dmk"
