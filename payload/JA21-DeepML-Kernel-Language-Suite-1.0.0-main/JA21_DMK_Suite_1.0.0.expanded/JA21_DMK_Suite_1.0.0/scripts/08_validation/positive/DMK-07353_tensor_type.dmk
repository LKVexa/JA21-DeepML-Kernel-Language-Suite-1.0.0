module corpus.deepml_kernel.example_07353
use DeepMLKernel
policy no_network

kernel DMK_07353(input: Tensor<f32>[80,32]) -> Tensor<f32>[80,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..80 tile 32 {
        vectorize 16
        output[i] = input[i] * 7.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07353.dmk"
