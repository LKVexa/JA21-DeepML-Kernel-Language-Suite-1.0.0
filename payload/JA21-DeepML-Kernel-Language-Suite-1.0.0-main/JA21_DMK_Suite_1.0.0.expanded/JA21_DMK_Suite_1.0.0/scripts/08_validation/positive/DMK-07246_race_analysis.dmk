module corpus.deepml_kernel.example_07246
use DeepMLKernel
policy no_network

kernel DMK_07246(input: Tensor<f32>[70,48]) -> Tensor<f32>[70,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..70 tile 32 {
        vectorize 16
        output[i] = input[i] * 24.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07246.dmk"
