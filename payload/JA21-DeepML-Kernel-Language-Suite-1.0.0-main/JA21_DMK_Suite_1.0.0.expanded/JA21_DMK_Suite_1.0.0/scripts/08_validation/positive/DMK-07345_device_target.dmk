module corpus.deepml_kernel.example_07345
use DeepMLKernel
policy no_network

kernel DMK_07345(input: Tensor<f32>[72,32]) -> Tensor<f32>[72,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..72 tile 32 {
        vectorize 16
        output[i] = input[i] * 30.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_07345.dmk"
