module corpus.deepml_kernel.example_07752
use DeepMLKernel
policy no_network

kernel DMK_07752(input: Tensor<f32>[91,16]) -> Tensor<f32>[91,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..91 tile 16 {
        vectorize 16
        output[i] = input[i] * 3.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_07752.dmk"
