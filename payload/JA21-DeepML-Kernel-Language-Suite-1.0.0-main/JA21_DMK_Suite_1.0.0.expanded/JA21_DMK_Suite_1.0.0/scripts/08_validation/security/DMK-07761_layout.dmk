module corpus.deepml_kernel.example_07761
use DeepMLKernel
policy no_network

kernel DMK_07761(input: Tensor<f32>[3,32]) -> Tensor<f32>[3,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..3 tile 32 {
        vectorize 16
        output[i] = input[i] * 12.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_07761.dmk"
