module corpus.deepml_kernel.example_07754
use DeepMLKernel
policy no_network

kernel DMK_07754(input: Tensor<f32>[93,48]) -> Tensor<f32>[93,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..93 tile 32 {
        vectorize 16
        output[i] = input[i] * 5.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_07754.dmk"
