module corpus.deepml_kernel.example_07822
use DeepMLKernel
policy no_network

kernel DMK_07822(input: Tensor<f32>[64,48]) -> Tensor<f32>[64,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..64 tile 32 {
        vectorize 16
        output[i] = input[i] * 11.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_07822.dmk"
