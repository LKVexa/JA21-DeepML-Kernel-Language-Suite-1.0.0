module corpus.deepml_kernel.example_07443
use DeepMLKernel
policy no_network

kernel DMK_07443(input: Tensor<f32>[73,64]) -> Tensor<f32>[73,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..73 tile 32 {
        vectorize 16
        output[i] = input[i] * 4.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_07443.dmk"
