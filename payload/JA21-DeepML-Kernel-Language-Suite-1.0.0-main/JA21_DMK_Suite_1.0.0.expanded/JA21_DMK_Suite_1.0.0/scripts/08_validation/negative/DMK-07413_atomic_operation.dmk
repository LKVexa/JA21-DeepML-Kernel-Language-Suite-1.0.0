module corpus.deepml_kernel.example_07413
use DeepMLKernel
policy no_network

kernel DMK_07413(input: Tensor<f32>[43,32]) -> Tensor<f32>[43,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..43 tile 32 {
        vectorize 16
        output[i] = input[i] * 5.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_07413.dmk"
