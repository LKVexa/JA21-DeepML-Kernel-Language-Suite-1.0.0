ja source 0.3
module corpus.deepml_kernel.example_07517
use DeepMLKernel
policy no_network

kernel DMK_07517(input: Tensor<f32>[50,32]) -> Tensor<f32>[50,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..50 tile 32 {
        vectorize 16
        output[i] = input[i] * 16.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_07517.dmk"
