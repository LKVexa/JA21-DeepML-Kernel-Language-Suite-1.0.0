module corpus.deepml_kernel.example_07527
use DeepMLKernel
policy no_network

kernel DMK_07527(input: Tensor<f32>[60,64]) -> Tensor<f32>[60,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..60 tile 32 {
        vectorize 16
        output[i] = input[i] * 26.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_07527.dmk"
