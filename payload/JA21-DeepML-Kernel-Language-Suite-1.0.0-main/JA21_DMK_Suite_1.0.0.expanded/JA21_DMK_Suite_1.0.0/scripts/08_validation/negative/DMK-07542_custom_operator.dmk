module corpus.deepml_kernel.example_07542
use DeepMLKernel
policy no_network

kernel DMK_07542(input: Tensor<f32>[75,48]) -> Tensor<f32>[75,48]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..75 tile 32 {
        vectorize 16
        output[i] = input[i] * 10.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_07542.dmk"
