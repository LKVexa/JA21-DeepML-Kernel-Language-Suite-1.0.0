module corpus.deepml_kernel.example_07501
use DeepMLKernel
policy no_network

kernel DMK_07501(input: Tensor<f32>[34,32]) -> Tensor<f32>[34,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..34 tile 32 {
        vectorize 16
        output[i] = input[i] * 31.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_07501.dmk"
