module corpus.deepml_kernel.example_07426
use DeepMLKernel
policy no_network

kernel DMK_07426(input: Tensor<f32>[56,48]) -> Tensor<f32>[56,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..56 tile 32 {
        vectorize 16
        output[i] = input[i] * 18.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_07426.dmk"
