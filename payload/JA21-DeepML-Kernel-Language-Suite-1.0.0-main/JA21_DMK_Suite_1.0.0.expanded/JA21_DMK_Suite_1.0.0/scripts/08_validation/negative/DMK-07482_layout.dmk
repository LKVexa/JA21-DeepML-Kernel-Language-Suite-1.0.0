module corpus.deepml_kernel.example_07482
use DeepMLKernel
policy no_network

kernel DMK_07482(input: Tensor<f32>[15,48]) -> Tensor<f32>[15,48]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..15 tile 32 {
        vectorize 16
        output[i] = input[i] * 12.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_07482.dmk"
