module corpus.deepml_kernel.example_07440
use DeepMLKernel
policy no_network

kernel DMK_07440(input: Tensor<f32>[70,16]) -> Tensor<f32>[70,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..70 tile 16 {
        vectorize 16
        output[i] = input[i] * 1.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_07440.dmk"
