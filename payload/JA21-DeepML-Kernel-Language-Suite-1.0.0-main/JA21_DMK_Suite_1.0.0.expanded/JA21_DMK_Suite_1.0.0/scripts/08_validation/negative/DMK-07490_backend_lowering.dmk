module corpus.deepml_kernel.example_07490
use DeepMLKernel
policy no_network

kernel DMK_07490(input: Tensor<f32>[23,48]) -> Tensor<f32>[23,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..23 tile 32 {
        vectorize 16
        output[i] = input[i] * 20.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_07490.dmk"
