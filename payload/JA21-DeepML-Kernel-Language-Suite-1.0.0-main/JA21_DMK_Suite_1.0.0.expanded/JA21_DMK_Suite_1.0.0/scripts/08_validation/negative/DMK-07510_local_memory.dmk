module corpus.deepml_kernel.example_07510
use DeepMLKernel
policy no_network

kernel DMK_07510(input: Tensor<f32>[43,48]) -> Tensor<f32>[43,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..43 tile 32 {
        vectorize 16
        output[i] = input[i] * 9.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_07510.dmk"
