module corpus.deepml_kernel.example_07961
use DeepMLKernel
policy no_network

kernel DMK_07961(input: Tensor<f32>[9,32]) -> Tensor<f32>[9,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..9 tile 32 {
        vectorize 16
        output[i] = input[i] * 26.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_07961.dmk"
