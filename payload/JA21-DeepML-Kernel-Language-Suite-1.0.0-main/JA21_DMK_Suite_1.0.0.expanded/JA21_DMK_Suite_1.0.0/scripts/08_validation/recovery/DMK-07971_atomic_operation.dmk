module corpus.deepml_kernel.example_07971
use DeepMLKernel
policy no_network

kernel DMK_07971(input: Tensor<f32>[19,64]) -> Tensor<f32>[19,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..19 tile 32 {
        vectorize 16
        output[i] = input[i] * 5.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_07971.dmk"
