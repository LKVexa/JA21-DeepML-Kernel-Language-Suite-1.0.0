ja source 0.3
module corpus.deepml_kernel.example_04205
use DeepMLKernel
policy no_network

kernel DMK_04205(input: Tensor<f32>[36,32]) -> Tensor<f32>[36,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..36 tile 32 {
        vectorize 16
        output[i] = input[i] * 21.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04205.dmk"
