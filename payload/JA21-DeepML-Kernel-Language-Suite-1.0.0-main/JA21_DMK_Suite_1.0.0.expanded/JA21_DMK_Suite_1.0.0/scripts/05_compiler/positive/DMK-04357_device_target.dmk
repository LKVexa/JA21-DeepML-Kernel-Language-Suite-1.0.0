module corpus.deepml_kernel.example_04357
use DeepMLKernel
policy no_network

kernel DMK_04357(input: Tensor<f32>[91,32]) -> Tensor<f32>[91,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..91 tile 32 {
        vectorize 16
        output[i] = input[i] * 18.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04357.dmk"
