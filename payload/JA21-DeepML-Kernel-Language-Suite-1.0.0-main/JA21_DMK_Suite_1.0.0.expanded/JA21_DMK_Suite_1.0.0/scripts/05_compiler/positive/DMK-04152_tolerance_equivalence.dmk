module corpus.deepml_kernel.example_04152
use DeepMLKernel
policy no_network

kernel DMK_04152(input: Tensor<f32>[80,16]) -> Tensor<f32>[80,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..80 tile 16 {
        vectorize 16
        output[i] = input[i] * 30.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04152.dmk"
