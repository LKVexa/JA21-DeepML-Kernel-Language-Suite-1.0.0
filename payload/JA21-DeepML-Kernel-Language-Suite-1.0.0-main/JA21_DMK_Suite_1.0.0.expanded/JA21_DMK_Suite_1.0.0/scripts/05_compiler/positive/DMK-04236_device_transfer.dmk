module corpus.deepml_kernel.example_04236
use DeepMLKernel
policy no_network

kernel DMK_04236(input: Tensor<f32>[67,16]) -> Tensor<f32>[67,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..67 tile 16 {
        vectorize 16
        output[i] = input[i] * 21.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04236.dmk"
