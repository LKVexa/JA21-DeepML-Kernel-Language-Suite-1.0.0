module corpus.deepml_kernel.example_04245
use DeepMLKernel
policy no_network

kernel DMK_04245(input: Tensor<f32>[76,32]) -> Tensor<f32>[76,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..76 tile 32 {
        vectorize 16
        output[i] = input[i] * 30.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04245.dmk"
