ja source 0.3
module corpus.deepml_kernel.example_04384
use DeepMLKernel
policy no_network

kernel DMK_04384(input: Tensor<f32>[21,16]) -> Tensor<f32>[21,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..21 tile 16 {
        vectorize 16
        output[i] = input[i] * 14.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04384.dmk"
