ja source 0.3
module corpus.deepml_kernel.example_04168
use DeepMLKernel
policy no_network

kernel DMK_04168(input: Tensor<f32>[96,16]) -> Tensor<f32>[96,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..96 tile 16 {
        vectorize 16
        output[i] = input[i] * 15.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04168.dmk"
