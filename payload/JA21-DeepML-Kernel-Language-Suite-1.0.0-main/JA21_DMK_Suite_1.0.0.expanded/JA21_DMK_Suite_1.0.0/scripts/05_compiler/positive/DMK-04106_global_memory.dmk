module corpus.deepml_kernel.example_04106
use DeepMLKernel
policy no_network

kernel DMK_04106(input: Tensor<f32>[34,48]) -> Tensor<f32>[34,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..34 tile 32 {
        vectorize 16
        output[i] = input[i] * 15.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04106.dmk"
