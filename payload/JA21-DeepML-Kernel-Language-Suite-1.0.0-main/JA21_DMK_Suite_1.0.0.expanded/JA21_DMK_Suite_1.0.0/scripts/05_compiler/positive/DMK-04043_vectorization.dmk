module corpus.deepml_kernel.example_04043
use DeepMLKernel
policy no_network

kernel DMK_04043(input: Tensor<f32>[68,64]) -> Tensor<f32>[68,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..68 tile 32 {
        vectorize 16
        output[i] = input[i] * 14.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04043.dmk"
