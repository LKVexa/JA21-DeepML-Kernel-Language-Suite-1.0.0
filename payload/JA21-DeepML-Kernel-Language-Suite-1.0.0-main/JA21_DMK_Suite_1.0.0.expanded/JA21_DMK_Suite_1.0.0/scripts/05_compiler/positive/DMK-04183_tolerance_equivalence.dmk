module corpus.deepml_kernel.example_04183
use DeepMLKernel
policy no_network

kernel DMK_04183(input: Tensor<f32>[14,64]) -> Tensor<f32>[14,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..14 tile 32 {
        vectorize 16
        output[i] = input[i] * 30.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04183.dmk"
