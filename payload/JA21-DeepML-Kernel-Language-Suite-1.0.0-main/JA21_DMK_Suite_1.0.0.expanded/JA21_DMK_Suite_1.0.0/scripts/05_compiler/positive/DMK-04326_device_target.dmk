module corpus.deepml_kernel.example_04326
use DeepMLKernel
policy no_network

kernel DMK_04326(input: Tensor<f32>[60,48]) -> Tensor<f32>[60,48]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..60 tile 32 {
        vectorize 16
        output[i] = input[i] * 18.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04326.dmk"
