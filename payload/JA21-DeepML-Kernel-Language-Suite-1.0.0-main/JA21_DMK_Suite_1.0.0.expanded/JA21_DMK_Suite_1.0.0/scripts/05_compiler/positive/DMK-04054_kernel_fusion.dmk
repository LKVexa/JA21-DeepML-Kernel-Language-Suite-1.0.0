module corpus.deepml_kernel.example_04054
use DeepMLKernel
policy no_network

kernel DMK_04054(input: Tensor<f32>[79,48]) -> Tensor<f32>[79,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..79 tile 32 {
        vectorize 16
        output[i] = input[i] * 25.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04054.dmk"
