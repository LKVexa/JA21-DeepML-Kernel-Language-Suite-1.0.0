module corpus.deepml_kernel.example_04085
use DeepMLKernel
policy no_network

kernel DMK_04085(input: Tensor<f32>[13,32]) -> Tensor<f32>[13,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..13 tile 32 {
        vectorize 16
        output[i] = input[i] * 25.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04085.dmk"
