module corpus.deepml_kernel.example_04267
use DeepMLKernel
policy no_network

kernel DMK_04267(input: Tensor<f32>[98,64]) -> Tensor<f32>[98,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..98 tile 32 {
        vectorize 16
        output[i] = input[i] * 21.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04267.dmk"
