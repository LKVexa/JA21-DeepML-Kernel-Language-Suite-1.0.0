module corpus.deepml_kernel.example_04388
use DeepMLKernel
policy no_network

kernel DMK_04388(input: Tensor<f32>[25,16]) -> Tensor<f32>[25,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..25 tile 16 {
        vectorize 16
        output[i] = input[i] * 18.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04388.dmk"
