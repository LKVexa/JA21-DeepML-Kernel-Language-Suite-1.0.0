ja source 0.3
module corpus.deepml_kernel.example_04341
use DeepMLKernel
policy no_network

kernel DMK_04341(input: Tensor<f32>[75,32]) -> Tensor<f32>[75,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..75 tile 32 {
        vectorize 16
        output[i] = input[i] * 2.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04341.dmk"
