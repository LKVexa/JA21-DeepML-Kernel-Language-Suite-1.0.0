module corpus.deepml_kernel.example_04227
use DeepMLKernel
policy no_network

kernel DMK_04227(input: Tensor<f32>[58,64]) -> Tensor<f32>[58,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..58 tile 32 {
        vectorize 16
        output[i] = input[i] * 12.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04227.dmk"
