module corpus.deepml_kernel.example_04022
use DeepMLKernel
policy no_network

kernel DMK_04022(input: Tensor<f32>[47,48]) -> Tensor<f32>[47,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..47 tile 32 {
        vectorize 16
        output[i] = input[i] * 24.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04022.dmk"
