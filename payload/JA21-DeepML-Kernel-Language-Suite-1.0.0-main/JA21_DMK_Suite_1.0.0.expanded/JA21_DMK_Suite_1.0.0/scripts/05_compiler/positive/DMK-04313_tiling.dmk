module corpus.deepml_kernel.example_04313
use DeepMLKernel
policy no_network

kernel DMK_04313(input: Tensor<f32>[47,32]) -> Tensor<f32>[47,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..47 tile 32 {
        vectorize 16
        output[i] = input[i] * 5.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04313.dmk"
