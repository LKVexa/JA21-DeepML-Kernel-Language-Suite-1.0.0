module corpus.deepml_kernel.example_04137
use DeepMLKernel
policy no_network

kernel DMK_04137(input: Tensor<f32>[65,32]) -> Tensor<f32>[65,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..65 tile 32 {
        vectorize 16
        output[i] = input[i] * 15.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04137.dmk"
