module corpus.deepml_kernel.example_04584
use DeepMLKernel
policy no_network

kernel DMK_04584(input: Tensor<f32>[27,1]) -> Tensor<f32>[27,1]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..27 tile 1 {
        vectorize 1
        output[i] = input[i] * 28.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04584.dmk"
