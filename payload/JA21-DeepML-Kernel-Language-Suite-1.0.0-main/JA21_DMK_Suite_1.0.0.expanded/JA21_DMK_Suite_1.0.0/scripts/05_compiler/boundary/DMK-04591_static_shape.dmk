module corpus.deepml_kernel.example_04591
use DeepMLKernel
policy no_network

kernel DMK_04591(input: Tensor<f32>[34,1]) -> Tensor<f32>[34,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..34 tile 1 {
        vectorize 1
        output[i] = input[i] * 4.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04591.dmk"
