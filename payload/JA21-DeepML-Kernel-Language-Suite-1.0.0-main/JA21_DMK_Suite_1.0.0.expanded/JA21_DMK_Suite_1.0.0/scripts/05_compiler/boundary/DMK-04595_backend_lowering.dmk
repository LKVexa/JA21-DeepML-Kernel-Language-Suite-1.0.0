module corpus.deepml_kernel.example_04595
use DeepMLKernel
policy no_network

kernel DMK_04595(input: Tensor<f32>[38,1]) -> Tensor<f32>[38,1]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..38 tile 1 {
        vectorize 1
        output[i] = input[i] * 8.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04595.dmk"
