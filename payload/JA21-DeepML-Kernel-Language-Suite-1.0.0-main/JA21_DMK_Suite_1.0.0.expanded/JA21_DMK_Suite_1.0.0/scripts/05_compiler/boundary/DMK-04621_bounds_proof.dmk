module corpus.deepml_kernel.example_04621
use DeepMLKernel
policy no_network

kernel DMK_04621(input: Tensor<f32>[64,1]) -> Tensor<f32>[64,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..64 tile 1 {
        vectorize 1
        output[i] = input[i] * 3.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04621.dmk"
