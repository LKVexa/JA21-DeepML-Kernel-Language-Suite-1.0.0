module corpus.deepml_kernel.example_04579
use DeepMLKernel
policy no_network

kernel DMK_04579(input: Tensor<f32>[22,1]) -> Tensor<f32>[22,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..22 tile 1 {
        vectorize 1
        output[i] = input[i] * 23.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04579.dmk"
