module corpus.deepml_kernel.example_04580
use DeepMLKernel
policy no_network

kernel DMK_04580(input: Tensor<f32>[23,1]) -> Tensor<f32>[23,1]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..23 tile 1 {
        vectorize 1
        output[i] = input[i] * 24.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04580.dmk"
