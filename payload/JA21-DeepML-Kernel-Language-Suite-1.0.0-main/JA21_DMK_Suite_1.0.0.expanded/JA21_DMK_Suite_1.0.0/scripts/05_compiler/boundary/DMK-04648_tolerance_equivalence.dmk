module corpus.deepml_kernel.example_04648
use DeepMLKernel
policy no_network

kernel DMK_04648(input: Tensor<f32>[91,1]) -> Tensor<f32>[91,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..91 tile 1 {
        vectorize 1
        output[i] = input[i] * 30.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04648.dmk"
