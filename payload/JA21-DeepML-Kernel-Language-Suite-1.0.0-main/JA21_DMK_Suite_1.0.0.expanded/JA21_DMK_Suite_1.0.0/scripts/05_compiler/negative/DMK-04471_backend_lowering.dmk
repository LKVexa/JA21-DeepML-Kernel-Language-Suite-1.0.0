module corpus.deepml_kernel.example_04471
use DeepMLKernel
policy no_network

kernel DMK_04471(input: Tensor<f32>[11,64]) -> Tensor<f32>[11,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..11 tile 32 {
        vectorize 16
        output[i] = input[i] * 8.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_04471.dmk"
