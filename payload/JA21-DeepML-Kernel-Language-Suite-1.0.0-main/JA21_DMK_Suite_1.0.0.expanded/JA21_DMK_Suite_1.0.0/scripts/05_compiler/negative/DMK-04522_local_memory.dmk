module corpus.deepml_kernel.example_04522
use DeepMLKernel
policy no_network

kernel DMK_04522(input: Tensor<f32>[62,48]) -> Tensor<f32>[62,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..62 tile 32 {
        vectorize 16
        output[i] = input[i] * 28.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_04522.dmk"
