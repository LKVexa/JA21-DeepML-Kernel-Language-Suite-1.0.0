module corpus.deepml_kernel.example_04452
use DeepMLKernel
policy no_network

kernel DMK_04452(input: Tensor<f32>[89,16]) -> Tensor<f32>[89,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..89 tile 16 {
        vectorize 16
        output[i] = input[i] * 20.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_04452.dmk"
