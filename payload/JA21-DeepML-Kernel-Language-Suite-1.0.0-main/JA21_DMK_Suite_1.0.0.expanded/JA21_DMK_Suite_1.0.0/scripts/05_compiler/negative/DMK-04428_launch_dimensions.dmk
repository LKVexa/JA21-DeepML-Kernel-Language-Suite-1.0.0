module corpus.deepml_kernel.example_04428
use DeepMLKernel
policy no_network

kernel DMK_04428(input: Tensor<f32>[65,16]) -> Tensor<f32>[65,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..65 tile 16 {
        vectorize 16
        output[i] = input[i] * 27.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_04428.dmk"
