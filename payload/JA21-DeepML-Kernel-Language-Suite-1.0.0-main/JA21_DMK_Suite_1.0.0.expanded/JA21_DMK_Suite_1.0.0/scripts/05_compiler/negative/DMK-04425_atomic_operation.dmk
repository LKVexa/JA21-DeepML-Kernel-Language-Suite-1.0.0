module corpus.deepml_kernel.example_04425
use DeepMLKernel
policy no_network

kernel DMK_04425(input: Tensor<f32>[62,32]) -> Tensor<f32>[62,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..62 tile 32 {
        vectorize 16
        output[i] = input[i] * 24.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_04425.dmk"
