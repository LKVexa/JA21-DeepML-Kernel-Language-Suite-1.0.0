module corpus.deepml_kernel.example_04513
use DeepMLKernel
policy no_network

kernel DMK_04513(input: Tensor<f32>[53,32]) -> Tensor<f32>[53,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..53 tile 32 {
        vectorize 16
        output[i] = input[i] * 19.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_04513.dmk"
