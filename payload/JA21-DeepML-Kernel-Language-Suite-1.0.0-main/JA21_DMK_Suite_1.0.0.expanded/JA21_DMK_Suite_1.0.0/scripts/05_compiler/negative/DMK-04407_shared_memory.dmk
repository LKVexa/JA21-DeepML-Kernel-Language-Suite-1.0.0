module corpus.deepml_kernel.example_04407
use DeepMLKernel
policy no_network

kernel DMK_04407(input: Tensor<f32>[44,64]) -> Tensor<f32>[44,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..44 tile 32 {
        vectorize 16
        output[i] = input[i] * 6.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_04407.dmk"
