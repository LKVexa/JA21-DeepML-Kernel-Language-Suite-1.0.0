module corpus.deepml_kernel.example_04474
use DeepMLKernel
policy no_network

kernel DMK_04474(input: Tensor<f32>[14,48]) -> Tensor<f32>[14,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..14 tile 32 {
        vectorize 16
        output[i] = input[i] * 11.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_04474.dmk"
