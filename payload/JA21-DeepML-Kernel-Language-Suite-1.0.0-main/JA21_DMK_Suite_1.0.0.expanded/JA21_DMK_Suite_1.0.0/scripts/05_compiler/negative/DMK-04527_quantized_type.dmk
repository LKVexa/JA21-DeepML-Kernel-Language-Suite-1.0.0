module corpus.deepml_kernel.example_04527
use DeepMLKernel
policy no_network

kernel DMK_04527(input: Tensor<f32>[67,64]) -> Tensor<f32>[67,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..67 tile 32 {
        vectorize 16
        output[i] = input[i] * 2.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_04527.dmk"
