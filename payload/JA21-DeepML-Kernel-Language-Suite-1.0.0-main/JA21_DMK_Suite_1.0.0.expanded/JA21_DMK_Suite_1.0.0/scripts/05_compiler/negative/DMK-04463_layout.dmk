module corpus.deepml_kernel.example_04463
use DeepMLKernel
policy no_network

kernel DMK_04463(input: Tensor<f32>[3,64]) -> Tensor<f32>[3,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..3 tile 32 {
        vectorize 16
        output[i] = input[i] * 31.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_04463.dmk"
