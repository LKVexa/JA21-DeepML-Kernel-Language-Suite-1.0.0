module corpus.deepml_kernel.example_04455
use DeepMLKernel
policy no_network

kernel DMK_04455(input: Tensor<f32>[92,64]) -> Tensor<f32>[92,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..92 tile 32 {
        vectorize 16
        output[i] = input[i] * 23.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_04455.dmk"
