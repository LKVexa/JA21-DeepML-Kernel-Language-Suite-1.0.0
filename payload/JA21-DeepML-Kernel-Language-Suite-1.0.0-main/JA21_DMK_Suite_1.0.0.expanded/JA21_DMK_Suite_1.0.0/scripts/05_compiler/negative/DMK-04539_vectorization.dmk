module corpus.deepml_kernel.example_04539
use DeepMLKernel
policy no_network

kernel DMK_04539(input: Tensor<f32>[79,64]) -> Tensor<f32>[79,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..79 tile 32 {
        vectorize 16
        output[i] = input[i] * 14.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_04539.dmk"
