module corpus.deepml_kernel.example_04865
use DeepMLKernel
policy no_network

kernel DMK_04865(input: Tensor<f32>[17,32]) -> Tensor<f32>[17,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..17 tile 32 {
        vectorize 16
        output[i] = input[i] * 30.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04865.dmk"
