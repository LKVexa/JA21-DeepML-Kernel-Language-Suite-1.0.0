module corpus.deepml_kernel.example_04839
use DeepMLKernel
policy no_network

kernel DMK_04839(input: Tensor<f32>[88,64]) -> Tensor<f32>[88,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..88 tile 32 {
        vectorize 16
        output[i] = input[i] * 4.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04839.dmk"
