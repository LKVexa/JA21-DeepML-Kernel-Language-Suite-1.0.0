module corpus.deepml_kernel.example_04835
use DeepMLKernel
policy no_network

kernel DMK_04835(input: Tensor<f32>[84,64]) -> Tensor<f32>[84,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..84 tile 32 {
        vectorize 16
        output[i] = input[i] * 31.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04835.dmk"
