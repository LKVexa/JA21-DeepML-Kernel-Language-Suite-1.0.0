module corpus.deepml_kernel.example_04942
use DeepMLKernel
policy no_network

kernel DMK_04942(input: Tensor<f32>[94,48]) -> Tensor<f32>[94,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..94 tile 32 {
        vectorize 16
        output[i] = input[i] * 14.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04942.dmk"
