module corpus.deepml_kernel.example_04948
use DeepMLKernel
policy no_network

kernel DMK_04948(input: Tensor<f32>[3,16]) -> Tensor<f32>[3,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..3 tile 16 {
        vectorize 16
        output[i] = input[i] * 20.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04948.dmk"
