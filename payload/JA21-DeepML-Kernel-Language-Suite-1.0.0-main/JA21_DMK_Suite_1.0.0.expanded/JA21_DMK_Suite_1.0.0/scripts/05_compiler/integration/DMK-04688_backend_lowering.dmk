module corpus.deepml_kernel.example_04688
use DeepMLKernel
policy no_network

kernel DMK_04688(input: Tensor<f32>[34,16]) -> Tensor<f32>[34,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..34 tile 16 {
        vectorize 16
        output[i] = input[i] * 8.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04688.dmk"
