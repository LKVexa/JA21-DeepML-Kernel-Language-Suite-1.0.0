module corpus.deepml_kernel.example_04747
use DeepMLKernel
policy no_network

kernel DMK_04747(input: Tensor<f32>[93,64]) -> Tensor<f32>[93,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..93 tile 32 {
        vectorize 16
        output[i] = input[i] * 5.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04747.dmk"
