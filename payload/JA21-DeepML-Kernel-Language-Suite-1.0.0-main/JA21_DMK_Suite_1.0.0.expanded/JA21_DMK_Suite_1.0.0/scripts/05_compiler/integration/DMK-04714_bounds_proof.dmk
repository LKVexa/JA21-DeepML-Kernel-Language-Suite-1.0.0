module corpus.deepml_kernel.example_04714
use DeepMLKernel
policy no_network

kernel DMK_04714(input: Tensor<f32>[60,48]) -> Tensor<f32>[60,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..60 tile 32 {
        vectorize 16
        output[i] = input[i] * 3.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04714.dmk"
