module corpus.deepml_kernel.example_04708
use DeepMLKernel
policy no_network

kernel DMK_04708(input: Tensor<f32>[54,16]) -> Tensor<f32>[54,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..54 tile 16 {
        vectorize 16
        output[i] = input[i] * 28.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04708.dmk"
