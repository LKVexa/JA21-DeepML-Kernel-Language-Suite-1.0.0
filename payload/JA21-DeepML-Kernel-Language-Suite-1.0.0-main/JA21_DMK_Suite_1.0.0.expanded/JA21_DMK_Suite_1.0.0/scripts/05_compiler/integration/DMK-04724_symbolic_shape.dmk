module corpus.deepml_kernel.example_04724
use DeepMLKernel
policy no_network

kernel DMK_04724(input: Tensor<f32>[70,16]) -> Tensor<f32>[70,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..70 tile 16 {
        vectorize 16
        output[i] = input[i] * 13.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04724.dmk"
