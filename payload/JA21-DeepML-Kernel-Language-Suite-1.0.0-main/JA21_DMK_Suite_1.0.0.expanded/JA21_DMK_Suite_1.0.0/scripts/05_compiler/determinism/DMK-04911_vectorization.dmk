module corpus.deepml_kernel.example_04911
use DeepMLKernel
policy no_network

kernel DMK_04911(input: Tensor<f32>[63,64]) -> Tensor<f32>[63,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..63 tile 32 {
        vectorize 16
        output[i] = input[i] * 14.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04911.dmk"
