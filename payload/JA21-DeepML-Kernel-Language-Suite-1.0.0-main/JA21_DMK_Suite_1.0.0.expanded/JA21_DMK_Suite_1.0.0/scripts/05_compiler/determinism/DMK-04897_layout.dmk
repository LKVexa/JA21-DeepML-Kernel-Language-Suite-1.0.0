module corpus.deepml_kernel.example_04897
use DeepMLKernel
policy no_network

kernel DMK_04897(input: Tensor<f32>[49,32]) -> Tensor<f32>[49,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..49 tile 32 {
        vectorize 16
        output[i] = input[i] * 31.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04897.dmk"
