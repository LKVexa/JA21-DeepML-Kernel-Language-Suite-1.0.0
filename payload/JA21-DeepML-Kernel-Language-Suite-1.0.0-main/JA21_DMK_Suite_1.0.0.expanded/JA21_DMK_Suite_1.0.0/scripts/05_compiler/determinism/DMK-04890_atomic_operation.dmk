module corpus.deepml_kernel.example_04890
use DeepMLKernel
policy no_network

kernel DMK_04890(input: Tensor<f32>[42,48]) -> Tensor<f32>[42,48]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..42 tile 32 {
        vectorize 16
        output[i] = input[i] * 24.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_04890.dmk"
