module corpus.deepml_kernel.example_04973
use DeepMLKernel
policy no_network

kernel DMK_04973(input: Tensor<f32>[28,32]) -> Tensor<f32>[28,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..28 tile 32 {
        vectorize 16
        output[i] = input[i] * 14.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_04973.dmk"
