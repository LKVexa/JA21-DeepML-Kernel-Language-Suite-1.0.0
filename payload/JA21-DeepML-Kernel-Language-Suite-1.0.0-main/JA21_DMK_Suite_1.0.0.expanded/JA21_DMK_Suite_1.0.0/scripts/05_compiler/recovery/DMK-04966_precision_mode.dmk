module corpus.deepml_kernel.example_04966
use DeepMLKernel
policy no_network

kernel DMK_04966(input: Tensor<f32>[21,48]) -> Tensor<f32>[21,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..21 tile 32 {
        vectorize 16
        output[i] = input[i] * 7.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_04966.dmk"
