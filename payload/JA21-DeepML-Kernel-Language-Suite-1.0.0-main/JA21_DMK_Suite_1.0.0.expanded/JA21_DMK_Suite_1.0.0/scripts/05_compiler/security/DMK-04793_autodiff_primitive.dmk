module corpus.deepml_kernel.example_04793
use DeepMLKernel
policy no_network

kernel DMK_04793(input: Tensor<f32>[42,32]) -> Tensor<f32>[42,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..42 tile 32 {
        vectorize 16
        output[i] = input[i] * 20.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_04793.dmk"
