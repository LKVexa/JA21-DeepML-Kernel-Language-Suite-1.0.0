module corpus.deepml_kernel.example_04769
use DeepMLKernel
policy no_network

kernel DMK_04769(input: Tensor<f32>[18,32]) -> Tensor<f32>[18,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..18 tile 32 {
        vectorize 16
        output[i] = input[i] * 27.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_04769.dmk"
