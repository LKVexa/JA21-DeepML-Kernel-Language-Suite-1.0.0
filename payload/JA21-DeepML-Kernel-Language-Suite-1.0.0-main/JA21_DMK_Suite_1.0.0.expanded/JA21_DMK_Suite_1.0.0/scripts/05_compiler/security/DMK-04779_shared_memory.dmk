module corpus.deepml_kernel.example_04779
use DeepMLKernel
policy no_network

kernel DMK_04779(input: Tensor<f32>[28,64]) -> Tensor<f32>[28,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..28 tile 32 {
        vectorize 16
        output[i] = input[i] * 6.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_04779.dmk"
