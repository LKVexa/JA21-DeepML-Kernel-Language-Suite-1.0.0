module corpus.deepml_kernel.example_04796
use DeepMLKernel
policy no_network

kernel DMK_04796(input: Tensor<f32>[45,16]) -> Tensor<f32>[45,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..45 tile 16 {
        vectorize 16
        output[i] = input[i] * 23.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_04796.dmk"
