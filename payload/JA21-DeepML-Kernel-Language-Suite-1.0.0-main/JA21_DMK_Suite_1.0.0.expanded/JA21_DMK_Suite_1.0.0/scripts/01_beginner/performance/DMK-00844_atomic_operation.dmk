module corpus.deepml_kernel.example_00844
use DeepMLKernel
policy no_network

kernel DMK_00844(input: Tensor<f32>[70,16]) -> Tensor<f32>[70,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..70 tile 16 {
        vectorize 16
        output[i] = input[i] * 8.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00844.dmk"
