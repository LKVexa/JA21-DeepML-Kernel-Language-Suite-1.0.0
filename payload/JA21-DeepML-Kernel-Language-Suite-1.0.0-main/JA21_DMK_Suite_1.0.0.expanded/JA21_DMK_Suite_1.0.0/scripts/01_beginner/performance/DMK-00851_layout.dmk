module corpus.deepml_kernel.example_00851
use DeepMLKernel
policy no_network

kernel DMK_00851(input: Tensor<f32>[77,64]) -> Tensor<f32>[77,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..77 tile 32 {
        vectorize 16
        output[i] = input[i] * 15.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00851.dmk"
