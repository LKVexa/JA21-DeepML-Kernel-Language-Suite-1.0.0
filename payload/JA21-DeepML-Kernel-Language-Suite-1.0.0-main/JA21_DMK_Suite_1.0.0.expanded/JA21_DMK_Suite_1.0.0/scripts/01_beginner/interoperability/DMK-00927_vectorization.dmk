module corpus.deepml_kernel.example_00927
use DeepMLKernel
policy no_network

kernel DMK_00927(input: Tensor<f32>[56,64]) -> Tensor<f32>[56,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..56 tile 32 {
        vectorize 16
        output[i] = input[i] * 29.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00927.dmk"
