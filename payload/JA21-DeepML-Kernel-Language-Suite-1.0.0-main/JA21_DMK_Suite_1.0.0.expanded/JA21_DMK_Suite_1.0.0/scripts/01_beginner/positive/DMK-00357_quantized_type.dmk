module corpus.deepml_kernel.example_00357
use DeepMLKernel
policy no_network

kernel DMK_00357(input: Tensor<f32>[68,32]) -> Tensor<f32>[68,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..68 tile 32 {
        vectorize 16
        output[i] = input[i] * 17.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00357.dmk"
