module corpus.deepml_kernel.example_00305
use DeepMLKernel
policy no_network

kernel DMK_00305(input: Tensor<f32>[16,32]) -> Tensor<f32>[16,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..16 tile 32 {
        vectorize 16
        output[i] = input[i] * 27.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00305.dmk"
