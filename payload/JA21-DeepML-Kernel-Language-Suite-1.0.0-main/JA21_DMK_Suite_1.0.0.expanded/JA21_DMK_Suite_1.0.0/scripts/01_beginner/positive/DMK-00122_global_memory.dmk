module corpus.deepml_kernel.example_00122
use DeepMLKernel
policy no_network

kernel DMK_00122(input: Tensor<f32>[27,48]) -> Tensor<f32>[27,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..27 tile 32 {
        vectorize 16
        output[i] = input[i] * 30.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00122.dmk"
