module corpus.deepml_kernel.example_00184
use DeepMLKernel
policy no_network

kernel DMK_00184(input: Tensor<f32>[89,16]) -> Tensor<f32>[89,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..89 tile 16 {
        vectorize 16
        output[i] = input[i] * 30.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00184.dmk"
