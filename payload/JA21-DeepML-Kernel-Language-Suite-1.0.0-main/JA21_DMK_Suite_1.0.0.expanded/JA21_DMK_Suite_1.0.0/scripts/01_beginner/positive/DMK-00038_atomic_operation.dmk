module corpus.deepml_kernel.example_00038
use DeepMLKernel
policy no_network

kernel DMK_00038(input: Tensor<f32>[40,48]) -> Tensor<f32>[40,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..40 tile 32 {
        vectorize 16
        output[i] = input[i] * 8.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00038.dmk"
