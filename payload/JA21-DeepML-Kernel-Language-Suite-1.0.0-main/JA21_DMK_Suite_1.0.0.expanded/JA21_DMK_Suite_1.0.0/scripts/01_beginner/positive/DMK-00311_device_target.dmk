module corpus.deepml_kernel.example_00311
use DeepMLKernel
policy no_network

kernel DMK_00311(input: Tensor<f32>[22,64]) -> Tensor<f32>[22,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..22 tile 32 {
        vectorize 16
        output[i] = input[i] * 2.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00311.dmk"
