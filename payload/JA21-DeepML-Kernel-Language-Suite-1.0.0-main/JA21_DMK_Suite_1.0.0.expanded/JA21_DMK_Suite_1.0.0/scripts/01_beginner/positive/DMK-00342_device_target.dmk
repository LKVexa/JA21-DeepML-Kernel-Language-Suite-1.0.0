module corpus.deepml_kernel.example_00342
use DeepMLKernel
policy no_network

kernel DMK_00342(input: Tensor<f32>[53,48]) -> Tensor<f32>[53,48]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..53 tile 32 {
        vectorize 16
        output[i] = input[i] * 2.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00342.dmk"
