module corpus.deepml_kernel.example_00396
use DeepMLKernel
policy no_network

kernel DMK_00396(input: Tensor<f32>[10,16]) -> Tensor<f32>[10,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..10 tile 16 {
        vectorize 16
        output[i] = input[i] * 25.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00396.dmk"
