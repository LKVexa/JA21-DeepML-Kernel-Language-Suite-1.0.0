module corpus.deepml_kernel.example_00274
use DeepMLKernel
policy no_network

kernel DMK_00274(input: Tensor<f32>[82,48]) -> Tensor<f32>[82,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..82 tile 32 {
        vectorize 16
        output[i] = input[i] * 27.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00274.dmk"
