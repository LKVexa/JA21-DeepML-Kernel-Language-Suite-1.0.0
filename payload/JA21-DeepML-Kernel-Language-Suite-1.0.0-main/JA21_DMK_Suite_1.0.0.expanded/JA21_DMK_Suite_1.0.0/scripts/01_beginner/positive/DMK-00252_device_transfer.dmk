module corpus.deepml_kernel.example_00252
use DeepMLKernel
policy no_network

kernel DMK_00252(input: Tensor<f32>[60,16]) -> Tensor<f32>[60,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..60 tile 16 {
        vectorize 16
        output[i] = input[i] * 5.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00252.dmk"
