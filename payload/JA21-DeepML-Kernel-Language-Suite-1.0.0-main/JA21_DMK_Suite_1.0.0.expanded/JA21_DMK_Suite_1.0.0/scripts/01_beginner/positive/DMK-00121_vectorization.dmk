module corpus.deepml_kernel.example_00121
use DeepMLKernel
policy no_network

kernel DMK_00121(input: Tensor<f32>[26,32]) -> Tensor<f32>[26,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..26 tile 32 {
        vectorize 16
        output[i] = input[i] * 29.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00121.dmk"
