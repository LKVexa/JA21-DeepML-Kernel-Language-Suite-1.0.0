module corpus.deepml_kernel.example_00400
use DeepMLKernel
policy no_network

kernel DMK_00400(input: Tensor<f32>[14,16]) -> Tensor<f32>[14,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..14 tile 16 {
        vectorize 16
        output[i] = input[i] * 29.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00400.dmk"
