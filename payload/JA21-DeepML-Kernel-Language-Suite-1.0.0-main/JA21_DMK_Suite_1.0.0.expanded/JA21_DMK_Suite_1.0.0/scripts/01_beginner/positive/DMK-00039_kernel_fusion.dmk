module corpus.deepml_kernel.example_00039
use DeepMLKernel
policy no_network

kernel DMK_00039(input: Tensor<f32>[41,64]) -> Tensor<f32>[41,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..41 tile 32 {
        vectorize 16
        output[i] = input[i] * 9.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00039.dmk"
