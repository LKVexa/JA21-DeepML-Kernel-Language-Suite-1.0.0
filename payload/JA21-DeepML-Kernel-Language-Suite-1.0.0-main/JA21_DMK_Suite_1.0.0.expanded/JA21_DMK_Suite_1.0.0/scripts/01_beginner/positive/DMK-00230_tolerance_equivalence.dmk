module corpus.deepml_kernel.example_00230
use DeepMLKernel
policy no_network

kernel DMK_00230(input: Tensor<f32>[38,48]) -> Tensor<f32>[38,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..38 tile 32 {
        vectorize 16
        output[i] = input[i] * 14.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00230.dmk"
