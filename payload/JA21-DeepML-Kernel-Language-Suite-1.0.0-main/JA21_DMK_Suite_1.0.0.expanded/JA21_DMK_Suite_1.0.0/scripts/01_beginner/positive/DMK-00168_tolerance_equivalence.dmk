module corpus.deepml_kernel.example_00168
use DeepMLKernel
policy no_network

kernel DMK_00168(input: Tensor<f32>[73,16]) -> Tensor<f32>[73,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..73 tile 16 {
        vectorize 16
        output[i] = input[i] * 14.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00168.dmk"
