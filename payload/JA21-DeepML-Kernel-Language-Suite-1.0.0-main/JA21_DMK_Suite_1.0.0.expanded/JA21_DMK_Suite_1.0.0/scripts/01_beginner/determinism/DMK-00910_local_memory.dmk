module corpus.deepml_kernel.example_00910
use DeepMLKernel
policy no_network

kernel DMK_00910(input: Tensor<f32>[39,48]) -> Tensor<f32>[39,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..39 tile 32 {
        vectorize 16
        output[i] = input[i] * 12.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00910.dmk"
