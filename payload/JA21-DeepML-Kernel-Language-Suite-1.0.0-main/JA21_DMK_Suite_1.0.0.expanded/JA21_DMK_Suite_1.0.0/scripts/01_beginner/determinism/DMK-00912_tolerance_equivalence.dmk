module corpus.deepml_kernel.example_00912
use DeepMLKernel
policy no_network

kernel DMK_00912(input: Tensor<f32>[41,16]) -> Tensor<f32>[41,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..41 tile 16 {
        vectorize 16
        output[i] = input[i] * 14.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00912.dmk"
