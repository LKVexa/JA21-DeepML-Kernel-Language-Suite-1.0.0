module corpus.deepml_kernel.example_00882
use DeepMLKernel
policy no_network

kernel DMK_00882(input: Tensor<f32>[11,48]) -> Tensor<f32>[11,48]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..11 tile 32 {
        vectorize 16
        output[i] = input[i] * 15.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00882.dmk"
