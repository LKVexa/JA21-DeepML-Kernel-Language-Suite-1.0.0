module corpus.deepml_kernel.example_00440
use DeepMLKernel
policy no_network

kernel DMK_00440(input: Tensor<f32>[54,16]) -> Tensor<f32>[54,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..54 tile 16 {
        vectorize 16
        output[i] = input[i] * 7.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_00440.dmk"
