module corpus.deepml_kernel.example_00550
use DeepMLKernel
policy no_network

kernel DMK_00550(input: Tensor<f32>[67,48]) -> Tensor<f32>[67,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..67 tile 32 {
        vectorize 16
        output[i] = input[i] * 24.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_00550.dmk"
