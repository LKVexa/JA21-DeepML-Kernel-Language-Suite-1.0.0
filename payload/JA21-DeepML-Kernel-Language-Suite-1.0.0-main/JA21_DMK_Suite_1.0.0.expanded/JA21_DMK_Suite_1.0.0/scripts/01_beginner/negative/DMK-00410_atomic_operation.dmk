module corpus.deepml_kernel.example_00410
use DeepMLKernel
policy no_network

kernel DMK_00410(input: Tensor<f32>[24,48]) -> Tensor<f32>[24,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..24 tile 32 {
        vectorize 16
        output[i] = input[i] * 8.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_00410.dmk"
