module corpus.deepml_kernel.example_00490
use DeepMLKernel
policy no_network

kernel DMK_00490(input: Tensor<f32>[7,48]) -> Tensor<f32>[7,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..7 tile 32 {
        vectorize 16
        output[i] = input[i] * 26.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_00490.dmk"
