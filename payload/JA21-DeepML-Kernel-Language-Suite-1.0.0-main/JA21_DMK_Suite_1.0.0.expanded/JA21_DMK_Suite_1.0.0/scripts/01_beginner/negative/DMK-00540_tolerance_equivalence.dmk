module corpus.deepml_kernel.example_00540
use DeepMLKernel
policy no_network

kernel DMK_00540(input: Tensor<f32>[57,16]) -> Tensor<f32>[57,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..57 tile 16 {
        vectorize 16
        output[i] = input[i] * 14.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_00540.dmk"
