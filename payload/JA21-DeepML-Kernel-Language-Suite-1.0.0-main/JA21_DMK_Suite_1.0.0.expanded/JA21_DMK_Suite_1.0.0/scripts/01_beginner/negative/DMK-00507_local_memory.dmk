module corpus.deepml_kernel.example_00507
use DeepMLKernel
policy no_network

kernel DMK_00507(input: Tensor<f32>[24,64]) -> Tensor<f32>[24,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..24 tile 32 {
        vectorize 16
        output[i] = input[i] * 12.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_00507.dmk"
