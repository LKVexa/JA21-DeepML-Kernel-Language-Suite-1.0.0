module corpus.deepml_kernel.example_00498
use DeepMLKernel
policy no_network

kernel DMK_00498(input: Tensor<f32>[15,48]) -> Tensor<f32>[15,48]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..15 tile 32 {
        vectorize 16
        output[i] = input[i] * 3.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_00498.dmk"
