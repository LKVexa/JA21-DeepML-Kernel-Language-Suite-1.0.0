module corpus.deepml_kernel.example_00479
use DeepMLKernel
policy no_network

kernel DMK_00479(input: Tensor<f32>[93,64]) -> Tensor<f32>[93,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..93 tile 32 {
        vectorize 16
        output[i] = input[i] * 15.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_00479.dmk"
