module corpus.deepml_kernel.example_00754
use DeepMLKernel
policy no_network

kernel DMK_00754(input: Tensor<f32>[77,48]) -> Tensor<f32>[77,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..77 tile 32 {
        vectorize 16
        output[i] = input[i] * 11.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_00754.dmk"
