module corpus.deepml_kernel.example_00812
use DeepMLKernel
policy no_network

kernel DMK_00812(input: Tensor<f32>[38,16]) -> Tensor<f32>[38,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..38 tile 16 {
        vectorize 16
        output[i] = input[i] * 7.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_00812.dmk"
