module corpus.deepml_kernel.example_00785
use DeepMLKernel
policy no_network

kernel DMK_00785(input: Tensor<f32>[11,32]) -> Tensor<f32>[11,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..11 tile 32 {
        vectorize 16
        output[i] = input[i] * 11.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_00785.dmk"
