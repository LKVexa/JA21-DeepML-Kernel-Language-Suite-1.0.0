ja source 0.3
module corpus.deepml_kernel.example_00809
use DeepMLKernel
policy no_network

kernel DMK_00809(input: Tensor<f32>[35,32]) -> Tensor<f32>[35,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..35 tile 32 {
        vectorize 16
        output[i] = input[i] * 4.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_00809.dmk"
