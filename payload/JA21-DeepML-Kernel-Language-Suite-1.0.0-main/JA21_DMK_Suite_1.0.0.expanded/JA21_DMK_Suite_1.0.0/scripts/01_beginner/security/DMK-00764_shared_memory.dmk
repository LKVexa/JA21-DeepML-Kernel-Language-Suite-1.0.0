module corpus.deepml_kernel.example_00764
use DeepMLKernel
policy no_network

kernel DMK_00764(input: Tensor<f32>[87,16]) -> Tensor<f32>[87,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..87 tile 16 {
        vectorize 16
        output[i] = input[i] * 21.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_00764.dmk"
