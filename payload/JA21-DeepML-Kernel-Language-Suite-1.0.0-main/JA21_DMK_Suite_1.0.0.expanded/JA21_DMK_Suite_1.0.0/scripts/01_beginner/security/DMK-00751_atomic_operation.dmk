module corpus.deepml_kernel.example_00751
use DeepMLKernel
policy no_network

kernel DMK_00751(input: Tensor<f32>[74,64]) -> Tensor<f32>[74,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..74 tile 32 {
        vectorize 16
        output[i] = input[i] * 8.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_00751.dmk"
