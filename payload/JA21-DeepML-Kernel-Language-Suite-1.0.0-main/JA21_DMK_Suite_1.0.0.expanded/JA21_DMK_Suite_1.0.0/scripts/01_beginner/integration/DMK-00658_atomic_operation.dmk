module corpus.deepml_kernel.example_00658
use DeepMLKernel
policy no_network

kernel DMK_00658(input: Tensor<f32>[78,48]) -> Tensor<f32>[78,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..78 tile 32 {
        vectorize 16
        output[i] = input[i] * 8.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00658.dmk"
