module corpus.deepml_kernel.example_00661
use DeepMLKernel
policy no_network

kernel DMK_00661(input: Tensor<f32>[81,32]) -> Tensor<f32>[81,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..81 tile 32 {
        vectorize 16
        output[i] = input[i] * 11.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00661.dmk"
