module corpus.deepml_kernel.example_00972
use DeepMLKernel
policy no_network

kernel DMK_00972(input: Tensor<f32>[4,16]) -> Tensor<f32>[4,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..4 tile 16 {
        vectorize 16
        output[i] = input[i] * 12.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_00972.dmk"
