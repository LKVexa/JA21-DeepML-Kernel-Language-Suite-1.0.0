module corpus.deepml_kernel.example_00958
use DeepMLKernel
policy no_network

kernel DMK_00958(input: Tensor<f32>[87,48]) -> Tensor<f32>[87,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..87 tile 32 {
        vectorize 16
        output[i] = input[i] * 29.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_00958.dmk"
