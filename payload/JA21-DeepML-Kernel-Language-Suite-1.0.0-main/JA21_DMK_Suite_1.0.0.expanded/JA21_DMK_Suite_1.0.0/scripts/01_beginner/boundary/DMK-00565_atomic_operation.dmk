module corpus.deepml_kernel.example_00565
use DeepMLKernel
policy no_network

kernel DMK_00565(input: Tensor<f32>[82,1]) -> Tensor<f32>[82,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..82 tile 1 {
        vectorize 1
        output[i] = input[i] * 8.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00565.dmk"
