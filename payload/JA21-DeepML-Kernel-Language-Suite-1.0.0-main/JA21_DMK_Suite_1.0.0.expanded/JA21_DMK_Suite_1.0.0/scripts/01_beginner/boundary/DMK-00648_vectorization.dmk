module corpus.deepml_kernel.example_00648
use DeepMLKernel
policy no_network

kernel DMK_00648(input: Tensor<f32>[68,1]) -> Tensor<f32>[68,1]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..68 tile 1 {
        vectorize 1
        output[i] = input[i] * 29.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00648.dmk"
