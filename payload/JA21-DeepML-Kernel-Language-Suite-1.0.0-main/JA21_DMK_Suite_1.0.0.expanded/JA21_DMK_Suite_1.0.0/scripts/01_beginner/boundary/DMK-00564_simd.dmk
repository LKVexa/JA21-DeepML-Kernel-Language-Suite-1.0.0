module corpus.deepml_kernel.example_00564
use DeepMLKernel
policy no_network

kernel DMK_00564(input: Tensor<f32>[81,1]) -> Tensor<f32>[81,1]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..81 tile 1 {
        vectorize 1
        output[i] = input[i] * 7.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00564.dmk"
