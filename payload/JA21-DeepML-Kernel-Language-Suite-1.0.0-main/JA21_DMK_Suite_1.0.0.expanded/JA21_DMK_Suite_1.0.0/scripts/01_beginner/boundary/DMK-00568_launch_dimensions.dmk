module corpus.deepml_kernel.example_00568
use DeepMLKernel
policy no_network

kernel DMK_00568(input: Tensor<f32>[85,1]) -> Tensor<f32>[85,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..85 tile 1 {
        vectorize 1
        output[i] = input[i] * 11.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00568.dmk"
