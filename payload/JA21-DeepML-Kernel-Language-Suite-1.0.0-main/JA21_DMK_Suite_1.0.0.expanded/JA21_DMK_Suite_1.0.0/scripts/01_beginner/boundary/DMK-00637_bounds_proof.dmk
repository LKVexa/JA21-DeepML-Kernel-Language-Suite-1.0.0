module corpus.deepml_kernel.example_00637
use DeepMLKernel
policy no_network

kernel DMK_00637(input: Tensor<f32>[57,1]) -> Tensor<f32>[57,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..57 tile 1 {
        vectorize 1
        output[i] = input[i] * 18.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00637.dmk"
