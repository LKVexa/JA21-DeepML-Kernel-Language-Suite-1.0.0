module corpus.deepml_kernel.example_00607
use DeepMLKernel
policy no_network

kernel DMK_00607(input: Tensor<f32>[27,1]) -> Tensor<f32>[27,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..27 tile 1 {
        vectorize 1
        output[i] = input[i] * 19.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_00607.dmk"
