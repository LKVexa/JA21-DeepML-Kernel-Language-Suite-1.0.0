module corpus.deepml_kernel.example_08699
use DeepMLKernel
policy no_network

kernel DMK_08699(input: Tensor<f32>[68,64]) -> Tensor<f32>[68,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..68 tile 32 {
        vectorize 16
        output[i] = input[i] * 20.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08699.dmk"
