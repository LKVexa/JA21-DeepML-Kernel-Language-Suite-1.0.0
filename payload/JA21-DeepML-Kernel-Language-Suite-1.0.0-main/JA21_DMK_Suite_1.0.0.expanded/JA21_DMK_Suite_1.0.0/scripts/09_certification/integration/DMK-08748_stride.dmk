module corpus.deepml_kernel.example_08748
use DeepMLKernel
policy no_network

kernel DMK_08748(input: Tensor<f32>[20,16]) -> Tensor<f32>[20,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..20 tile 16 {
        vectorize 16
        output[i] = input[i] * 7.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08748.dmk"
