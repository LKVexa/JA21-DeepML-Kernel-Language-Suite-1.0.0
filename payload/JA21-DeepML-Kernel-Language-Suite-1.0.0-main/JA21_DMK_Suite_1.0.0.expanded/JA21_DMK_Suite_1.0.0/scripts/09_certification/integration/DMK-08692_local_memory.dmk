module corpus.deepml_kernel.example_08692
use DeepMLKernel
policy no_network

kernel DMK_08692(input: Tensor<f32>[61,16]) -> Tensor<f32>[61,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..61 tile 16 {
        vectorize 16
        output[i] = input[i] * 13.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08692.dmk"
