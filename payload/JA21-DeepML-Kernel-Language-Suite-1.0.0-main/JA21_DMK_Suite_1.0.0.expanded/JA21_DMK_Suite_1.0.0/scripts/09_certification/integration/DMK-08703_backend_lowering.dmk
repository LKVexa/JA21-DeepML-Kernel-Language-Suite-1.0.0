module corpus.deepml_kernel.example_08703
use DeepMLKernel
policy no_network

kernel DMK_08703(input: Tensor<f32>[72,64]) -> Tensor<f32>[72,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..72 tile 32 {
        vectorize 16
        output[i] = input[i] * 24.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08703.dmk"
