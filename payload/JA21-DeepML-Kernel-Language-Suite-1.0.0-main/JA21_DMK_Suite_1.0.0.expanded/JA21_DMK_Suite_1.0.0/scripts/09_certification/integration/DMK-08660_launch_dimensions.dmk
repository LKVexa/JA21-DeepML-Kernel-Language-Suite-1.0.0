module corpus.deepml_kernel.example_08660
use DeepMLKernel
policy no_network

kernel DMK_08660(input: Tensor<f32>[29,16]) -> Tensor<f32>[29,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..29 tile 16 {
        vectorize 16
        output[i] = input[i] * 12.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08660.dmk"
