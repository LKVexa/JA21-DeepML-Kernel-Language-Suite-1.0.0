module corpus.deepml_kernel.example_08727
use DeepMLKernel
policy no_network

kernel DMK_08727(input: Tensor<f32>[96,64]) -> Tensor<f32>[96,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..96 tile 32 {
        vectorize 16
        output[i] = input[i] * 17.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08727.dmk"
