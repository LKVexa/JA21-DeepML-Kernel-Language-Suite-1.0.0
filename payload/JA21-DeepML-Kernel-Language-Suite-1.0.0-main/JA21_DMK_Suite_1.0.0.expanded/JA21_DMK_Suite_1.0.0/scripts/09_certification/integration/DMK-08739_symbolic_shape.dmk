module corpus.deepml_kernel.example_08739
use DeepMLKernel
policy no_network

kernel DMK_08739(input: Tensor<f32>[11,64]) -> Tensor<f32>[11,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..11 tile 32 {
        vectorize 16
        output[i] = input[i] * 29.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08739.dmk"
