module corpus.deepml_kernel.example_08610
use DeepMLKernel
policy no_network

kernel DMK_08610(input: Tensor<f32>[76,1]) -> Tensor<f32>[76,1]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..76 tile 1 {
        vectorize 1
        output[i] = input[i] * 24.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08610.dmk"
