ja source 0.3
module corpus.deepml_kernel.example_08606
use DeepMLKernel
policy no_network

kernel DMK_08606(input: Tensor<f32>[72,1]) -> Tensor<f32>[72,1]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..72 tile 1 {
        vectorize 1
        output[i] = input[i] * 20.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08606.dmk"
