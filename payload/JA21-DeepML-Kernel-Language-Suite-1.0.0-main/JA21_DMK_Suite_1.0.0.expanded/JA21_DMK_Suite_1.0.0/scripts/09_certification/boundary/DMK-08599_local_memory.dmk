module corpus.deepml_kernel.example_08599
use DeepMLKernel
policy no_network

kernel DMK_08599(input: Tensor<f32>[65,1]) -> Tensor<f32>[65,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..65 tile 1 {
        vectorize 1
        output[i] = input[i] * 13.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08599.dmk"
