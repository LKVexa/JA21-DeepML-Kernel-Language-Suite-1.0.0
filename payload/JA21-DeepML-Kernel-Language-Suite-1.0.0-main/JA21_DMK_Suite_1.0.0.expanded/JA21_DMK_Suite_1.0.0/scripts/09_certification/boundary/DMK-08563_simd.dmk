module corpus.deepml_kernel.example_08563
use DeepMLKernel
policy no_network

kernel DMK_08563(input: Tensor<f32>[29,1]) -> Tensor<f32>[29,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..29 tile 1 {
        vectorize 1
        output[i] = input[i] * 8.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08563.dmk"
