module corpus.deepml_kernel.example_08567
use DeepMLKernel
policy no_network

kernel DMK_08567(input: Tensor<f32>[33,1]) -> Tensor<f32>[33,1]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..33 tile 1 {
        vectorize 1
        output[i] = input[i] * 12.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08567.dmk"
