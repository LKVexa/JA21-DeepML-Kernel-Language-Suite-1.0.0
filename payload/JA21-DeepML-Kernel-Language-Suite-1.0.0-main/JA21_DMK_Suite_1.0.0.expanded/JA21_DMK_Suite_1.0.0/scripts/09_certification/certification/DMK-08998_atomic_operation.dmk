module corpus.deepml_kernel.example_08998
use DeepMLKernel
policy no_network

kernel DMK_08998(input: Tensor<f32>[76,48]) -> Tensor<f32>[76,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..76 tile 32 {
        vectorize 16
        output[i] = input[i] * 9.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08998.dmk"
