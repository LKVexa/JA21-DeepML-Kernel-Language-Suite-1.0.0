module corpus.deepml_kernel.example_08843
use DeepMLKernel
policy no_network

kernel DMK_08843(input: Tensor<f32>[18,64]) -> Tensor<f32>[18,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..18 tile 32 {
        vectorize 16
        output[i] = input[i] * 9.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08843.dmk"
