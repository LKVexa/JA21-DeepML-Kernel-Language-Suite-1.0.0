module corpus.deepml_kernel.example_08325
use DeepMLKernel
policy no_network

kernel DMK_08325(input: Tensor<f32>[82,32]) -> Tensor<f32>[82,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..82 tile 32 {
        vectorize 16
        output[i] = input[i] * 18.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08325.dmk"
