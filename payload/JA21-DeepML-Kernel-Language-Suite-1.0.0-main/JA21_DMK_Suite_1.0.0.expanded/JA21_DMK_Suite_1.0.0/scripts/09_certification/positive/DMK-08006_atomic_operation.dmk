module corpus.deepml_kernel.example_08006
use DeepMLKernel
policy no_network

kernel DMK_08006(input: Tensor<f32>[54,48]) -> Tensor<f32>[54,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..54 tile 32 {
        vectorize 16
        output[i] = input[i] * 9.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08006.dmk"
