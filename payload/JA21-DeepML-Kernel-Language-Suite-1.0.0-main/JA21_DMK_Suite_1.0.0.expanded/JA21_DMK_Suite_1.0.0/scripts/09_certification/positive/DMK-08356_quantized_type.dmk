module corpus.deepml_kernel.example_08356
use DeepMLKernel
policy no_network

kernel DMK_08356(input: Tensor<f32>[16,16]) -> Tensor<f32>[16,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..16 tile 16 {
        vectorize 16
        output[i] = input[i] * 18.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08356.dmk"
