module corpus.deepml_kernel.example_08242
use DeepMLKernel
policy no_network

kernel DMK_08242(input: Tensor<f32>[96,48]) -> Tensor<f32>[96,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..96 tile 32 {
        vectorize 16
        output[i] = input[i] * 28.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08242.dmk"
