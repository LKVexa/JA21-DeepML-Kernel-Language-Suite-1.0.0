module corpus.deepml_kernel.example_08273
use DeepMLKernel
policy no_network

kernel DMK_08273(input: Tensor<f32>[30,32]) -> Tensor<f32>[30,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..30 tile 32 {
        vectorize 16
        output[i] = input[i] * 28.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08273.dmk"
