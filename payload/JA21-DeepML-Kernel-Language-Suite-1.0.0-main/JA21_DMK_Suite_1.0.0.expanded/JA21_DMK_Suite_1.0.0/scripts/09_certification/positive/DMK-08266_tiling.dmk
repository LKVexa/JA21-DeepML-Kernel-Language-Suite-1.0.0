module corpus.deepml_kernel.example_08266
use DeepMLKernel
policy no_network

kernel DMK_08266(input: Tensor<f32>[23,48]) -> Tensor<f32>[23,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..23 tile 32 {
        vectorize 16
        output[i] = input[i] * 21.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08266.dmk"
