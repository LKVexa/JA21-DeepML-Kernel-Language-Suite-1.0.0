module corpus.deepml_kernel.example_08400
use DeepMLKernel
policy no_network

kernel DMK_08400(input: Tensor<f32>[60,16]) -> Tensor<f32>[60,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..60 tile 16 {
        vectorize 16
        output[i] = input[i] * 31.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08400.dmk"
