module corpus.deepml_kernel.example_08037
use DeepMLKernel
policy no_network

kernel DMK_08037(input: Tensor<f32>[85,32]) -> Tensor<f32>[85,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..85 tile 32 {
        vectorize 16
        output[i] = input[i] * 9.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08037.dmk"
