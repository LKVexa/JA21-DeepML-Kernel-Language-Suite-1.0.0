module corpus.deepml_kernel.example_08058
use DeepMLKernel
policy no_network

kernel DMK_08058(input: Tensor<f32>[9,48]) -> Tensor<f32>[9,48]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..9 tile 32 {
        vectorize 16
        output[i] = input[i] * 30.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08058.dmk"
