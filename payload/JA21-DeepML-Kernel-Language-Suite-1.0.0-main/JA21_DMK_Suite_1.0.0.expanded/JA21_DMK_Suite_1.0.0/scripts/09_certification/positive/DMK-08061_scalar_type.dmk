ja source 0.3
module corpus.deepml_kernel.example_08061
use DeepMLKernel
policy no_network

kernel DMK_08061(input: Tensor<f32>[12,32]) -> Tensor<f32>[12,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..12 tile 32 {
        vectorize 16
        output[i] = input[i] * 2.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08061.dmk"
