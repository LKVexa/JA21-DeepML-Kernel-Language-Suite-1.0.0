module corpus.deepml_kernel.example_08198
use DeepMLKernel
policy no_network

kernel DMK_08198(input: Tensor<f32>[52,48]) -> Tensor<f32>[52,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..52 tile 32 {
        vectorize 16
        output[i] = input[i] * 15.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08198.dmk"
