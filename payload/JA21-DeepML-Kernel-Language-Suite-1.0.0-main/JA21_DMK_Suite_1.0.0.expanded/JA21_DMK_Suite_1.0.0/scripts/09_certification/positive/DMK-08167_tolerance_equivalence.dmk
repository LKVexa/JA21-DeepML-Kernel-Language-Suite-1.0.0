module corpus.deepml_kernel.example_08167
use DeepMLKernel
policy no_network

kernel DMK_08167(input: Tensor<f32>[21,64]) -> Tensor<f32>[21,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..21 tile 32 {
        vectorize 16
        output[i] = input[i] * 15.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08167.dmk"
