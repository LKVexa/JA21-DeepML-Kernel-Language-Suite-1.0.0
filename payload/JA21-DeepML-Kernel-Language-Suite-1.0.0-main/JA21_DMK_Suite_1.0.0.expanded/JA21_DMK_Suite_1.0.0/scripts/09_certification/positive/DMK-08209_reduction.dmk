module corpus.deepml_kernel.example_08209
use DeepMLKernel
policy no_network

kernel DMK_08209(input: Tensor<f32>[63,32]) -> Tensor<f32>[63,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..63 tile 32 {
        vectorize 16
        output[i] = input[i] * 26.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08209.dmk"
