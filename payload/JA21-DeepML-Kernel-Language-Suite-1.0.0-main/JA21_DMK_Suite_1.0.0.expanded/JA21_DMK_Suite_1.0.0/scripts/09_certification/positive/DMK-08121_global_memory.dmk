module corpus.deepml_kernel.example_08121
use DeepMLKernel
policy no_network

kernel DMK_08121(input: Tensor<f32>[72,32]) -> Tensor<f32>[72,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..72 tile 32 {
        vectorize 16
        output[i] = input[i] * 31.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08121.dmk"
