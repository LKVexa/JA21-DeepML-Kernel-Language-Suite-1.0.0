module corpus.deepml_kernel.example_08399
use DeepMLKernel
policy no_network

kernel DMK_08399(input: Tensor<f32>[59,64]) -> Tensor<f32>[59,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..59 tile 32 {
        vectorize 16
        output[i] = input[i] * 30.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08399.dmk"
