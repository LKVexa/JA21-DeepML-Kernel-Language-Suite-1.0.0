module corpus.deepml_kernel.example_08178
use DeepMLKernel
policy no_network

kernel DMK_08178(input: Tensor<f32>[32,48]) -> Tensor<f32>[32,48]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..32 tile 32 {
        vectorize 16
        output[i] = input[i] * 26.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08178.dmk"
