module corpus.deepml_kernel.example_08092
use DeepMLKernel
policy no_network

kernel DMK_08092(input: Tensor<f32>[43,16]) -> Tensor<f32>[43,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..43 tile 16 {
        vectorize 16
        output[i] = input[i] * 2.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08092.dmk"
