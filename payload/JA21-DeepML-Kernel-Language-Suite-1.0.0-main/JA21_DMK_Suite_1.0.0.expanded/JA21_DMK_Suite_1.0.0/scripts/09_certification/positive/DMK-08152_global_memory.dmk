module corpus.deepml_kernel.example_08152
use DeepMLKernel
policy no_network

kernel DMK_08152(input: Tensor<f32>[6,16]) -> Tensor<f32>[6,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..6 tile 16 {
        vectorize 16
        output[i] = input[i] * 31.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08152.dmk"
