module corpus.deepml_kernel.example_08183
use DeepMLKernel
policy no_network

kernel DMK_08183(input: Tensor<f32>[37,64]) -> Tensor<f32>[37,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..37 tile 32 {
        vectorize 16
        output[i] = input[i] * 31.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08183.dmk"
