module corpus.deepml_kernel.example_08220
use DeepMLKernel
policy no_network

kernel DMK_08220(input: Tensor<f32>[74,16]) -> Tensor<f32>[74,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..74 tile 16 {
        vectorize 16
        output[i] = input[i] * 6.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08220.dmk"
