module corpus.deepml_kernel.example_08395
use DeepMLKernel
policy no_network

kernel DMK_08395(input: Tensor<f32>[55,64]) -> Tensor<f32>[55,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..55 tile 32 {
        vectorize 16
        output[i] = input[i] * 26.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08395.dmk"
