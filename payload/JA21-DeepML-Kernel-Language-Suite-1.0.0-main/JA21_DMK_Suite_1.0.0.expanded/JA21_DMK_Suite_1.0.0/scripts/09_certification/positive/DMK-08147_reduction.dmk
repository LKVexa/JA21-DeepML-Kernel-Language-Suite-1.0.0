module corpus.deepml_kernel.example_08147
use DeepMLKernel
policy no_network

kernel DMK_08147(input: Tensor<f32>[98,64]) -> Tensor<f32>[98,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..98 tile 32 {
        vectorize 16
        output[i] = input[i] * 26.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08147.dmk"
