module corpus.deepml_kernel.example_08136
use DeepMLKernel
policy no_network

kernel DMK_08136(input: Tensor<f32>[87,16]) -> Tensor<f32>[87,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..87 tile 16 {
        vectorize 16
        output[i] = input[i] * 15.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08136.dmk"
