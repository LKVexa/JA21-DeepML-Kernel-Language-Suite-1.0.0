module corpus.deepml_kernel.example_08189
use DeepMLKernel
policy no_network

kernel DMK_08189(input: Tensor<f32>[43,32]) -> Tensor<f32>[43,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..43 tile 32 {
        vectorize 16
        output[i] = input[i] * 6.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08189.dmk"
