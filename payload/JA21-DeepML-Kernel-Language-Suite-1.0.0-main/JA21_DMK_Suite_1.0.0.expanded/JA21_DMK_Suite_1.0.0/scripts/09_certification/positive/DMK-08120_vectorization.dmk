module corpus.deepml_kernel.example_08120
use DeepMLKernel
policy no_network

kernel DMK_08120(input: Tensor<f32>[71,16]) -> Tensor<f32>[71,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..71 tile 16 {
        vectorize 16
        output[i] = input[i] * 30.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08120.dmk"
