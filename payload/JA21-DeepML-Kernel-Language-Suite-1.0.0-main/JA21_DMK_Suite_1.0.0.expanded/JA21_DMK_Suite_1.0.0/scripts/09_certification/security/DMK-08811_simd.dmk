module corpus.deepml_kernel.example_08811
use DeepMLKernel
policy no_network

kernel DMK_08811(input: Tensor<f32>[83,64]) -> Tensor<f32>[83,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..83 tile 32 {
        vectorize 16
        output[i] = input[i] * 8.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_08811.dmk"
