ja source 0.3
module corpus.deepml_kernel.example_08808
use DeepMLKernel
policy no_network

kernel DMK_08808(input: Tensor<f32>[80,16]) -> Tensor<f32>[80,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..80 tile 16 {
        vectorize 16
        output[i] = input[i] * 5.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_08808.dmk"
