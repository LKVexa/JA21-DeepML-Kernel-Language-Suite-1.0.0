module corpus.deepml_kernel.example_08817
use DeepMLKernel
policy no_network

kernel DMK_08817(input: Tensor<f32>[89,32]) -> Tensor<f32>[89,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..89 tile 32 {
        vectorize 16
        output[i] = input[i] * 14.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_08817.dmk"
