module corpus.deepml_kernel.example_08763
use DeepMLKernel
policy no_network

kernel DMK_08763(input: Tensor<f32>[35,64]) -> Tensor<f32>[35,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..35 tile 32 {
        vectorize 16
        output[i] = input[i] * 22.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_08763.dmk"
