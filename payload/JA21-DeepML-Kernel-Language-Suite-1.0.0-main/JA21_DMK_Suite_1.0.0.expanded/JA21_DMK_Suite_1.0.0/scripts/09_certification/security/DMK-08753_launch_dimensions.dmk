module corpus.deepml_kernel.example_08753
use DeepMLKernel
policy no_network

kernel DMK_08753(input: Tensor<f32>[25,32]) -> Tensor<f32>[25,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..25 tile 32 {
        vectorize 16
        output[i] = input[i] * 12.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_08753.dmk"
