module corpus.deepml_kernel.example_08926
use DeepMLKernel
policy no_network

kernel DMK_08926(input: Tensor<f32>[4,48]) -> Tensor<f32>[4,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..4 tile 32 {
        vectorize 16
        output[i] = input[i] * 30.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08926.dmk"
