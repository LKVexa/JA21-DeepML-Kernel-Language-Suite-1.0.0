module corpus.deepml_kernel.example_08936
use DeepMLKernel
policy no_network

kernel DMK_08936(input: Tensor<f32>[14,16]) -> Tensor<f32>[14,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..14 tile 16 {
        vectorize 16
        output[i] = input[i] * 9.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08936.dmk"
