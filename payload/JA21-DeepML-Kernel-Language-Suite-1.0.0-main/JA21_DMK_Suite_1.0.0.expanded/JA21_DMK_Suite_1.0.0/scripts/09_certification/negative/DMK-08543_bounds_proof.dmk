module corpus.deepml_kernel.example_08543
use DeepMLKernel
policy no_network

kernel DMK_08543(input: Tensor<f32>[9,64]) -> Tensor<f32>[9,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..9 tile 32 {
        vectorize 16
        output[i] = input[i] * 19.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_08543.dmk"
