module corpus.deepml_kernel.example_08489
use DeepMLKernel
policy no_network

kernel DMK_08489(input: Tensor<f32>[52,32]) -> Tensor<f32>[52,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..52 tile 32 {
        vectorize 16
        output[i] = input[i] * 27.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_08489.dmk"
