module corpus.deepml_kernel.example_08412
use DeepMLKernel
policy no_network

kernel DMK_08412(input: Tensor<f32>[72,16]) -> Tensor<f32>[72,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..72 tile 16 {
        vectorize 16
        output[i] = input[i] * 12.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_08412.dmk"
