module corpus.deepml_kernel.example_08436
use DeepMLKernel
policy no_network

kernel DMK_08436(input: Tensor<f32>[96,16]) -> Tensor<f32>[96,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..96 tile 16 {
        vectorize 16
        output[i] = input[i] * 5.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_08436.dmk"
