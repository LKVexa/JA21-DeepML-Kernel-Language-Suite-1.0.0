module corpus.deepml_kernel.example_08409
use DeepMLKernel
policy no_network

kernel DMK_08409(input: Tensor<f32>[69,32]) -> Tensor<f32>[69,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..69 tile 32 {
        vectorize 16
        output[i] = input[i] * 9.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_08409.dmk"
