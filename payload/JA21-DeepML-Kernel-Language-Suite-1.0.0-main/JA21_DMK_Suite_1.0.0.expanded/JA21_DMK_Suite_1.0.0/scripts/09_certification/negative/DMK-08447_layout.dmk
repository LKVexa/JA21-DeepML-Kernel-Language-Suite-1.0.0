module corpus.deepml_kernel.example_08447
use DeepMLKernel
policy no_network

kernel DMK_08447(input: Tensor<f32>[10,64]) -> Tensor<f32>[10,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..10 tile 32 {
        vectorize 16
        output[i] = input[i] * 16.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_08447.dmk"
