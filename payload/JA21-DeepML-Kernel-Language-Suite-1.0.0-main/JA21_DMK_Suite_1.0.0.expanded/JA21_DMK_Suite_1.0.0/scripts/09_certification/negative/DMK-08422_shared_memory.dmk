module corpus.deepml_kernel.example_08422
use DeepMLKernel
policy no_network

kernel DMK_08422(input: Tensor<f32>[82,48]) -> Tensor<f32>[82,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..82 tile 32 {
        vectorize 16
        output[i] = input[i] * 22.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_08422.dmk"
