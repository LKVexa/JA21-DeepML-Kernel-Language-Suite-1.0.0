module corpus.deepml_kernel.example_08439
use DeepMLKernel
policy no_network

kernel DMK_08439(input: Tensor<f32>[2,64]) -> Tensor<f32>[2,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..2 tile 32 {
        vectorize 16
        output[i] = input[i] * 8.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_08439.dmk"
