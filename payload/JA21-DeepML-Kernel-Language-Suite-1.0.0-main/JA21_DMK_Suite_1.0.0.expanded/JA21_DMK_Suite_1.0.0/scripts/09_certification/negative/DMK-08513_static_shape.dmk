module corpus.deepml_kernel.example_08513
use DeepMLKernel
policy no_network

kernel DMK_08513(input: Tensor<f32>[76,32]) -> Tensor<f32>[76,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..76 tile 32 {
        vectorize 16
        output[i] = input[i] * 20.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_08513.dmk"
