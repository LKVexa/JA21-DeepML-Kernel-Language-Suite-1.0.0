module corpus.deepml_kernel.example_08506
use DeepMLKernel
policy no_network

kernel DMK_08506(input: Tensor<f32>[69,48]) -> Tensor<f32>[69,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..69 tile 32 {
        vectorize 16
        output[i] = input[i] * 13.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_08506.dmk"
