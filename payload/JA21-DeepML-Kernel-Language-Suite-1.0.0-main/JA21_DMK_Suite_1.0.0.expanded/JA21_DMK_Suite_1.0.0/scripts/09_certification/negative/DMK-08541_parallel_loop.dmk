module corpus.deepml_kernel.example_08541
use DeepMLKernel
policy no_network

kernel DMK_08541(input: Tensor<f32>[7,32]) -> Tensor<f32>[7,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..7 tile 32 {
        vectorize 16
        output[i] = input[i] * 17.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_08541.dmk"
