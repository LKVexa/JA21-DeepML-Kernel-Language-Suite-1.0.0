module corpus.deepml_kernel.example_08921
use DeepMLKernel
policy no_network

kernel DMK_08921(input: Tensor<f32>[96,32]) -> Tensor<f32>[96,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..96 tile 32 {
        vectorize 16
        output[i] = input[i] * 25.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08921.dmk"
