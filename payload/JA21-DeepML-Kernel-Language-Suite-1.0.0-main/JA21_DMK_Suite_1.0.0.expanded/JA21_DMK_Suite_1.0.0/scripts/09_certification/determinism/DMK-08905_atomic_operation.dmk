module corpus.deepml_kernel.example_08905
use DeepMLKernel
policy no_network

kernel DMK_08905(input: Tensor<f32>[80,32]) -> Tensor<f32>[80,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..80 tile 32 {
        vectorize 16
        output[i] = input[i] * 9.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08905.dmk"
