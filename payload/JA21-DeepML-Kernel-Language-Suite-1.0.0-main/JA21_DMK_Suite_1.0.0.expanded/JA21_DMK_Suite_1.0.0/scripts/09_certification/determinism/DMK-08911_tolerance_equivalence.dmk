module corpus.deepml_kernel.example_08911
use DeepMLKernel
policy no_network

kernel DMK_08911(input: Tensor<f32>[86,64]) -> Tensor<f32>[86,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..86 tile 32 {
        vectorize 16
        output[i] = input[i] * 15.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08911.dmk"
