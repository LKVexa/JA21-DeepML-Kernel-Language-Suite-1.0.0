module corpus.deepml_kernel.example_08885
use DeepMLKernel
policy no_network

kernel DMK_08885(input: Tensor<f32>[60,32]) -> Tensor<f32>[60,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..60 tile 32 {
        vectorize 16
        output[i] = input[i] * 20.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08885.dmk"
