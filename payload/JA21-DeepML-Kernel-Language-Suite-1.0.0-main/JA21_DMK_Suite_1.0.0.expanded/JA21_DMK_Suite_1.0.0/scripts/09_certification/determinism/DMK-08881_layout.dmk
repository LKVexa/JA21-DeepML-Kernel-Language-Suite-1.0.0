module corpus.deepml_kernel.example_08881
use DeepMLKernel
policy no_network

kernel DMK_08881(input: Tensor<f32>[56,32]) -> Tensor<f32>[56,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..56 tile 32 {
        vectorize 16
        output[i] = input[i] * 16.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_08881.dmk"
