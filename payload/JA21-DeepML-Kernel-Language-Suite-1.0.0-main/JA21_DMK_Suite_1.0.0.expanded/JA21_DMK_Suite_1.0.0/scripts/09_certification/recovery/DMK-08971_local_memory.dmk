module corpus.deepml_kernel.example_08971
use DeepMLKernel
policy no_network

kernel DMK_08971(input: Tensor<f32>[49,64]) -> Tensor<f32>[49,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..49 tile 32 {
        vectorize 16
        output[i] = input[i] * 13.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_08971.dmk"
