module corpus.deepml_kernel.example_08967
use DeepMLKernel
policy no_network

kernel DMK_08967(input: Tensor<f32>[45,64]) -> Tensor<f32>[45,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..45 tile 32 {
        vectorize 16
        output[i] = input[i] * 9.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_08967.dmk"
