module corpus.deepml_kernel.example_09595
use DeepMLKernel
policy no_network

kernel DMK_09595(input: Tensor<f32>[91,1]) -> Tensor<f32>[91,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..91 tile 1 {
        vectorize 1
        output[i] = input[i] * 17.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09595.dmk"
