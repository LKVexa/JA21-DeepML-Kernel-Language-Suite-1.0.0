module corpus.deepml_kernel.example_09602
use DeepMLKernel
policy no_network

kernel DMK_09602(input: Tensor<f32>[98,1]) -> Tensor<f32>[98,1]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..98 tile 1 {
        vectorize 1
        output[i] = input[i] * 24.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09602.dmk"
