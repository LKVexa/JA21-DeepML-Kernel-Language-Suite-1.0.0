module corpus.deepml_kernel.example_09606
use DeepMLKernel
policy no_network

kernel DMK_09606(input: Tensor<f32>[5,1]) -> Tensor<f32>[5,1]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..5 tile 1 {
        vectorize 1
        output[i] = input[i] * 28.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09606.dmk"
