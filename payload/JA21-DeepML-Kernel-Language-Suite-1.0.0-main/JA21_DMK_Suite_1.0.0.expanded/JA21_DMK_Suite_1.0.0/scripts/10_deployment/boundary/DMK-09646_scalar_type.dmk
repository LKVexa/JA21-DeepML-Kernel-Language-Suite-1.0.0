module corpus.deepml_kernel.example_09646
use DeepMLKernel
policy no_network

kernel DMK_09646(input: Tensor<f32>[45,1]) -> Tensor<f32>[45,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..45 tile 1 {
        vectorize 1
        output[i] = input[i] * 6.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09646.dmk"
