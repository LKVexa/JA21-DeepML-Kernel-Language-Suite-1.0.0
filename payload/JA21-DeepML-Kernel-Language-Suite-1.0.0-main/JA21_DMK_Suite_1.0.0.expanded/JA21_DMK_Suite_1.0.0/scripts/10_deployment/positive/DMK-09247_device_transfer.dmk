module corpus.deepml_kernel.example_09247
use DeepMLKernel
policy no_network

kernel DMK_09247(input: Tensor<f32>[34,64]) -> Tensor<f32>[34,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..34 tile 32 {
        vectorize 16
        output[i] = input[i] * 10.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09247.dmk"
