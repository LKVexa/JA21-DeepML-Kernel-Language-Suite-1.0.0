module corpus.deepml_kernel.example_09033
use DeepMLKernel
policy no_network

kernel DMK_09033(input: Tensor<f32>[14,32]) -> Tensor<f32>[14,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..14 tile 32 {
        vectorize 16
        output[i] = input[i] * 13.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09033.dmk"
