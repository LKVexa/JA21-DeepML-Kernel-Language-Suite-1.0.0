module corpus.deepml_kernel.example_09395
use DeepMLKernel
policy no_network

kernel DMK_09395(input: Tensor<f32>[85,64]) -> Tensor<f32>[85,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..85 tile 32 {
        vectorize 16
        output[i] = input[i] * 3.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09395.dmk"
