module corpus.deepml_kernel.example_09148
use DeepMLKernel
policy no_network

kernel DMK_09148(input: Tensor<f32>[32,16]) -> Tensor<f32>[32,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..32 tile 16 {
        vectorize 16
        output[i] = input[i] * 4.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09148.dmk"
