module corpus.deepml_kernel.example_09352
use DeepMLKernel
policy no_network

kernel DMK_09352(input: Tensor<f32>[42,16]) -> Tensor<f32>[42,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..42 tile 16 {
        vectorize 16
        output[i] = input[i] * 22.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09352.dmk"
