module corpus.deepml_kernel.example_09026
use DeepMLKernel
policy no_network

kernel DMK_09026(input: Tensor<f32>[7,48]) -> Tensor<f32>[7,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..7 tile 32 {
        vectorize 16
        output[i] = input[i] * 6.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09026.dmk"
