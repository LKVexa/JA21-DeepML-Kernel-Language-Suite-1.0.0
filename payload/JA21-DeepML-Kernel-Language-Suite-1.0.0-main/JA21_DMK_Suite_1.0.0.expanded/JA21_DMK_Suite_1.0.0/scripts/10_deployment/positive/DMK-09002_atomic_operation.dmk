module corpus.deepml_kernel.example_09002
use DeepMLKernel
policy no_network

kernel DMK_09002(input: Tensor<f32>[80,48]) -> Tensor<f32>[80,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..80 tile 32 {
        vectorize 16
        output[i] = input[i] * 13.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09002.dmk"
