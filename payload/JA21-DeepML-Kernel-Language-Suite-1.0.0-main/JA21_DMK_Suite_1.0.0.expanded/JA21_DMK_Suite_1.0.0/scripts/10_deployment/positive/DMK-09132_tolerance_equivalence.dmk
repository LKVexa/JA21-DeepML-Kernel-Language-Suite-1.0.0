module corpus.deepml_kernel.example_09132
use DeepMLKernel
policy no_network

kernel DMK_09132(input: Tensor<f32>[16,16]) -> Tensor<f32>[16,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..16 tile 16 {
        vectorize 16
        output[i] = input[i] * 19.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09132.dmk"
