module corpus.deepml_kernel.example_09116
use DeepMLKernel
policy no_network

kernel DMK_09116(input: Tensor<f32>[97,16]) -> Tensor<f32>[97,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..97 tile 16 {
        vectorize 16
        output[i] = input[i] * 3.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09116.dmk"
