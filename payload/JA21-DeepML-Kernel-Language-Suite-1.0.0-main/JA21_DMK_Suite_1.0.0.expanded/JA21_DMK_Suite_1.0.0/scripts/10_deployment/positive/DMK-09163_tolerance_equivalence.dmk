module corpus.deepml_kernel.example_09163
use DeepMLKernel
policy no_network

kernel DMK_09163(input: Tensor<f32>[47,64]) -> Tensor<f32>[47,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..47 tile 32 {
        vectorize 16
        output[i] = input[i] * 19.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09163.dmk"
