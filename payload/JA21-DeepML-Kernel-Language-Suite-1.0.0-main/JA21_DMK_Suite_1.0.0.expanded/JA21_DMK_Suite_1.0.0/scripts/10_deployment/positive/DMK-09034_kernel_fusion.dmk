module corpus.deepml_kernel.example_09034
use DeepMLKernel
policy no_network

kernel DMK_09034(input: Tensor<f32>[15,48]) -> Tensor<f32>[15,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..15 tile 32 {
        vectorize 16
        output[i] = input[i] * 14.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09034.dmk"
