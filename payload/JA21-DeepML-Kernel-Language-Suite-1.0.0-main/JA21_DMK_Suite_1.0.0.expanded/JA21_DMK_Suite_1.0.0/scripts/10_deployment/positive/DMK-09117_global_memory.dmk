module corpus.deepml_kernel.example_09117
use DeepMLKernel
policy no_network

kernel DMK_09117(input: Tensor<f32>[98,32]) -> Tensor<f32>[98,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..98 tile 32 {
        vectorize 16
        output[i] = input[i] * 4.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09117.dmk"
