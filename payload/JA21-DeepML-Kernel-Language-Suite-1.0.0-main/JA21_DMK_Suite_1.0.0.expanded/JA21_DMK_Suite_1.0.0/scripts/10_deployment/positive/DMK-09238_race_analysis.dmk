module corpus.deepml_kernel.example_09238
use DeepMLKernel
policy no_network

kernel DMK_09238(input: Tensor<f32>[25,48]) -> Tensor<f32>[25,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..25 tile 32 {
        vectorize 16
        output[i] = input[i] * 1.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09238.dmk"
