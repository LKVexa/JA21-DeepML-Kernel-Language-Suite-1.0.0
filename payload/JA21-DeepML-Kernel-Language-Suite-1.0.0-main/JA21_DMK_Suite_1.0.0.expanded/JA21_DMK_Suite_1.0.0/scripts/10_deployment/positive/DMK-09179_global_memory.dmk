module corpus.deepml_kernel.example_09179
use DeepMLKernel
policy no_network

kernel DMK_09179(input: Tensor<f32>[63,64]) -> Tensor<f32>[63,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..63 tile 32 {
        vectorize 16
        output[i] = input[i] * 4.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09179.dmk"
