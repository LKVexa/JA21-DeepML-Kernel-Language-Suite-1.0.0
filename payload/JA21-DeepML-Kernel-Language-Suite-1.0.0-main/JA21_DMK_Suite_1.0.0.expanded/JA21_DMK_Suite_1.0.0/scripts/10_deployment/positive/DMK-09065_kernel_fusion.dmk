module corpus.deepml_kernel.example_09065
use DeepMLKernel
policy no_network

kernel DMK_09065(input: Tensor<f32>[46,32]) -> Tensor<f32>[46,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..46 tile 32 {
        vectorize 16
        output[i] = input[i] * 14.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09065.dmk"
