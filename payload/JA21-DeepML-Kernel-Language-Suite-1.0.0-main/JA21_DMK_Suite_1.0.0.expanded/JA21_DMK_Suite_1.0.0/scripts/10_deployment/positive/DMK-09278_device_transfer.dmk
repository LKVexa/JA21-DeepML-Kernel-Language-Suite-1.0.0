module corpus.deepml_kernel.example_09278
use DeepMLKernel
policy no_network

kernel DMK_09278(input: Tensor<f32>[65,48]) -> Tensor<f32>[65,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..65 tile 32 {
        vectorize 16
        output[i] = input[i] * 10.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09278.dmk"
