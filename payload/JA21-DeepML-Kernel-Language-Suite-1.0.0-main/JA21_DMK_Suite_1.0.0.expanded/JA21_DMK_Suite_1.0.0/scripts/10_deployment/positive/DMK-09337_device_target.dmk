module corpus.deepml_kernel.example_09337
use DeepMLKernel
policy no_network

kernel DMK_09337(input: Tensor<f32>[27,32]) -> Tensor<f32>[27,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..27 tile 32 {
        vectorize 16
        output[i] = input[i] * 7.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09337.dmk"
