module corpus.deepml_kernel.example_09205
use DeepMLKernel
policy no_network

kernel DMK_09205(input: Tensor<f32>[89,32]) -> Tensor<f32>[89,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..89 tile 32 {
        vectorize 16
        output[i] = input[i] * 30.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09205.dmk"
