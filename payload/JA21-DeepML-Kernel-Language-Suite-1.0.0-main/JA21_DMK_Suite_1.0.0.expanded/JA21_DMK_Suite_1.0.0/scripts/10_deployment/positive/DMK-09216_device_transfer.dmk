module corpus.deepml_kernel.example_09216
use DeepMLKernel
policy no_network

kernel DMK_09216(input: Tensor<f32>[3,16]) -> Tensor<f32>[3,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..3 tile 16 {
        vectorize 16
        output[i] = input[i] * 10.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09216.dmk"
