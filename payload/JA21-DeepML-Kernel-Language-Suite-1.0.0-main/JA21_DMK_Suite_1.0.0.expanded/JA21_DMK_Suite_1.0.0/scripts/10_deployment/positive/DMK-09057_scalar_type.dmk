module corpus.deepml_kernel.example_09057
use DeepMLKernel
policy no_network

kernel DMK_09057(input: Tensor<f32>[38,32]) -> Tensor<f32>[38,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..38 tile 32 {
        vectorize 16
        output[i] = input[i] * 6.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09057.dmk"
