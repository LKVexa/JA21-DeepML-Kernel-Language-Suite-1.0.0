module corpus.deepml_kernel.example_09293
use DeepMLKernel
policy no_network

kernel DMK_09293(input: Tensor<f32>[80,32]) -> Tensor<f32>[80,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..80 tile 32 {
        vectorize 16
        output[i] = input[i] * 25.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09293.dmk"
