module corpus.deepml_kernel.example_09877
use DeepMLKernel
policy no_network

kernel DMK_09877(input: Tensor<f32>[82,32]) -> Tensor<f32>[82,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..82 tile 32 {
        vectorize 16
        output[i] = input[i] * 20.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09877.dmk"
