module corpus.deepml_kernel.example_09881
use DeepMLKernel
policy no_network

kernel DMK_09881(input: Tensor<f32>[86,32]) -> Tensor<f32>[86,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..86 tile 32 {
        vectorize 16
        output[i] = input[i] * 24.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09881.dmk"
