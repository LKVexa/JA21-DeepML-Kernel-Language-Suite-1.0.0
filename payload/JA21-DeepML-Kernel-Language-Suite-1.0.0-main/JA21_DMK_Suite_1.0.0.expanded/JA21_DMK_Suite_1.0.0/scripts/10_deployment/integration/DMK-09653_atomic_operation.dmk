module corpus.deepml_kernel.example_09653
use DeepMLKernel
policy no_network

kernel DMK_09653(input: Tensor<f32>[52,32]) -> Tensor<f32>[52,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..52 tile 32 {
        vectorize 16
        output[i] = input[i] * 13.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09653.dmk"
