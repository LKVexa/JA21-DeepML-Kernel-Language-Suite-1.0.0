module corpus.deepml_kernel.example_09656
use DeepMLKernel
policy no_network

kernel DMK_09656(input: Tensor<f32>[55,16]) -> Tensor<f32>[55,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..55 tile 16 {
        vectorize 16
        output[i] = input[i] * 16.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09656.dmk"
