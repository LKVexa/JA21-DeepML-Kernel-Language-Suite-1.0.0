module corpus.deepml_kernel.example_09695
use DeepMLKernel
policy no_network

kernel DMK_09695(input: Tensor<f32>[94,64]) -> Tensor<f32>[94,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..94 tile 32 {
        vectorize 16
        output[i] = input[i] * 24.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09695.dmk"
