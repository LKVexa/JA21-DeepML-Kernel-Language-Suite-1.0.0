module corpus.deepml_kernel.example_09932
use DeepMLKernel
policy no_network

kernel DMK_09932(input: Tensor<f32>[40,16]) -> Tensor<f32>[40,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..40 tile 16 {
        vectorize 16
        output[i] = input[i] * 13.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09932.dmk"
