module corpus.deepml_kernel.example_09938
use DeepMLKernel
policy no_network

kernel DMK_09938(input: Tensor<f32>[46,48]) -> Tensor<f32>[46,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..46 tile 32 {
        vectorize 16
        output[i] = input[i] * 19.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09938.dmk"
