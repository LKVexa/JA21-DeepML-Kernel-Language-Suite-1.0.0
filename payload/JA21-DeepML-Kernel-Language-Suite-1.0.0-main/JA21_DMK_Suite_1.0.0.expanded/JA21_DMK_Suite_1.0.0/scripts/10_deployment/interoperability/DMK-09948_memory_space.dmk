module corpus.deepml_kernel.example_09948
use DeepMLKernel
policy no_network

kernel DMK_09948(input: Tensor<f32>[56,16]) -> Tensor<f32>[56,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..56 tile 16 {
        vectorize 16
        output[i] = input[i] * 29.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09948.dmk"
