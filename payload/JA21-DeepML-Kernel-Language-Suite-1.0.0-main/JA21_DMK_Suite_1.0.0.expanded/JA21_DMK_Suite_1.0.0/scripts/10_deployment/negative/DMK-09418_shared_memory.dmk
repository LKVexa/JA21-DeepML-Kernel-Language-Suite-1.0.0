module corpus.deepml_kernel.example_09418
use DeepMLKernel
policy no_network

kernel DMK_09418(input: Tensor<f32>[11,48]) -> Tensor<f32>[11,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..11 tile 32 {
        vectorize 16
        output[i] = input[i] * 26.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_09418.dmk"
