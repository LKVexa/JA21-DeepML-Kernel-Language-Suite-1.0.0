module corpus.deepml_kernel.example_09432
use DeepMLKernel
policy no_network

kernel DMK_09432(input: Tensor<f32>[25,16]) -> Tensor<f32>[25,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..25 tile 16 {
        vectorize 16
        output[i] = input[i] * 9.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_09432.dmk"
