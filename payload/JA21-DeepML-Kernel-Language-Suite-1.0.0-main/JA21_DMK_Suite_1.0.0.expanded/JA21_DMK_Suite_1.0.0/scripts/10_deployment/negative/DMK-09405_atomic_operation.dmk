module corpus.deepml_kernel.example_09405
use DeepMLKernel
policy no_network

kernel DMK_09405(input: Tensor<f32>[95,32]) -> Tensor<f32>[95,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..95 tile 32 {
        vectorize 16
        output[i] = input[i] * 13.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_09405.dmk"
