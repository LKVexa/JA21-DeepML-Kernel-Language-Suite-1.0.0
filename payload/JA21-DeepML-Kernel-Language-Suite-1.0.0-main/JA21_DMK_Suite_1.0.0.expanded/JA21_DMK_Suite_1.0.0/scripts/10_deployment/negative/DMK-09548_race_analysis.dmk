module corpus.deepml_kernel.example_09548
use DeepMLKernel
policy no_network

kernel DMK_09548(input: Tensor<f32>[44,16]) -> Tensor<f32>[44,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..44 tile 16 {
        vectorize 16
        output[i] = input[i] * 1.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_09548.dmk"
