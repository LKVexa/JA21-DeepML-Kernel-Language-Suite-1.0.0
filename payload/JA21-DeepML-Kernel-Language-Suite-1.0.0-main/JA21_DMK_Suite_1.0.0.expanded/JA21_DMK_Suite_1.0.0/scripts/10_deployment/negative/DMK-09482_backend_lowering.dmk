module corpus.deepml_kernel.example_09482
use DeepMLKernel
policy no_network

kernel DMK_09482(input: Tensor<f32>[75,48]) -> Tensor<f32>[75,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..75 tile 32 {
        vectorize 16
        output[i] = input[i] * 28.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_09482.dmk"
