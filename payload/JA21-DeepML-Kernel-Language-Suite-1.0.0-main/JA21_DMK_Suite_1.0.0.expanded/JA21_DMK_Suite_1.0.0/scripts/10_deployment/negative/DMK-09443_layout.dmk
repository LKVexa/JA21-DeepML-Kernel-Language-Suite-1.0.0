module corpus.deepml_kernel.example_09443
use DeepMLKernel
policy no_network

kernel DMK_09443(input: Tensor<f32>[36,64]) -> Tensor<f32>[36,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..36 tile 32 {
        vectorize 16
        output[i] = input[i] * 20.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_09443.dmk"
