module corpus.deepml_kernel.example_09502
use DeepMLKernel
policy no_network

kernel DMK_09502(input: Tensor<f32>[95,48]) -> Tensor<f32>[95,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..95 tile 32 {
        vectorize 16
        output[i] = input[i] * 17.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_09502.dmk"
