module corpus.deepml_kernel.example_09485
use DeepMLKernel
policy no_network

kernel DMK_09485(input: Tensor<f32>[78,32]) -> Tensor<f32>[78,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..78 tile 32 {
        vectorize 16
        output[i] = input[i] * 31.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_09485.dmk"
