module corpus.deepml_kernel.example_09534
use DeepMLKernel
policy no_network

kernel DMK_09534(input: Tensor<f32>[30,48]) -> Tensor<f32>[30,48]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..30 tile 32 {
        vectorize 16
        output[i] = input[i] * 18.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_09534.dmk"
