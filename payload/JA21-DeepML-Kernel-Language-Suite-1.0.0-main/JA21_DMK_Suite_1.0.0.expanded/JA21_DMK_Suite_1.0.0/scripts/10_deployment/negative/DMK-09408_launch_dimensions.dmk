module corpus.deepml_kernel.example_09408
use DeepMLKernel
policy no_network

kernel DMK_09408(input: Tensor<f32>[98,16]) -> Tensor<f32>[98,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..98 tile 16 {
        vectorize 16
        output[i] = input[i] * 16.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_09408.dmk"
