module corpus.deepml_kernel.example_09509
use DeepMLKernel
policy no_network

kernel DMK_09509(input: Tensor<f32>[5,32]) -> Tensor<f32>[5,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..5 tile 32 {
        vectorize 16
        output[i] = input[i] * 24.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_09509.dmk"
