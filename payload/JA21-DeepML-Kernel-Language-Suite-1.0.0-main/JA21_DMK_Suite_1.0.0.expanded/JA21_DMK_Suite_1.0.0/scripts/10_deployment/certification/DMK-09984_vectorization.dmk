module corpus.deepml_kernel.example_09984
use DeepMLKernel
policy no_network

kernel DMK_09984(input: Tensor<f32>[92,16]) -> Tensor<f32>[92,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..92 tile 16 {
        vectorize 16
        output[i] = input[i] * 3.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09984.dmk"
