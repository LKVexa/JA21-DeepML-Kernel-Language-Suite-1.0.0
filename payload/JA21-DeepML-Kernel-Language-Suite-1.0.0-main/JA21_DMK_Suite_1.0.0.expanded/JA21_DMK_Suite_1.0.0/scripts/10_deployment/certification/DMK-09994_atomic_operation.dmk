module corpus.deepml_kernel.example_09994
use DeepMLKernel
policy no_network

kernel DMK_09994(input: Tensor<f32>[5,48]) -> Tensor<f32>[5,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..5 tile 32 {
        vectorize 16
        output[i] = input[i] * 13.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_09994.dmk"
