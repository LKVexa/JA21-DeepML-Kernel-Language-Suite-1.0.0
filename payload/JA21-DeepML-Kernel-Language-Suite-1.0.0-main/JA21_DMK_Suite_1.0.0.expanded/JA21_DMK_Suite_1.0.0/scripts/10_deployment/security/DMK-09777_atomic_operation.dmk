module corpus.deepml_kernel.example_09777
use DeepMLKernel
policy no_network

kernel DMK_09777(input: Tensor<f32>[79,32]) -> Tensor<f32>[79,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..79 tile 32 {
        vectorize 16
        output[i] = input[i] * 13.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_09777.dmk"
