module corpus.deepml_kernel.example_09814
use DeepMLKernel
policy no_network

kernel DMK_09814(input: Tensor<f32>[19,48]) -> Tensor<f32>[19,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..19 tile 32 {
        vectorize 16
        output[i] = input[i] * 19.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_09814.dmk"
