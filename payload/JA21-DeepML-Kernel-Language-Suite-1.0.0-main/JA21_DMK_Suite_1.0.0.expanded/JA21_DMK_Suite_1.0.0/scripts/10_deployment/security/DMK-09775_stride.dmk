module corpus.deepml_kernel.example_09775
use DeepMLKernel
policy no_network

kernel DMK_09775(input: Tensor<f32>[77,64]) -> Tensor<f32>[77,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..77 tile 32 {
        vectorize 16
        output[i] = input[i] * 11.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_09775.dmk"
