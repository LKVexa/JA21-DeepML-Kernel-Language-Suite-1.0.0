module corpus.deepml_kernel.example_09796
use DeepMLKernel
policy no_network

kernel DMK_09796(input: Tensor<f32>[98,16]) -> Tensor<f32>[98,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..98 tile 16 {
        vectorize 16
        output[i] = input[i] * 1.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_09796.dmk"
