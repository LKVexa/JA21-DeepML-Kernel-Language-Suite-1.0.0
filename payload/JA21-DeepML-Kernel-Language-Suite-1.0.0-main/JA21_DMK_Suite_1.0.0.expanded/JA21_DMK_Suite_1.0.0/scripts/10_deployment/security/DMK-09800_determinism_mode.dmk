module corpus.deepml_kernel.example_09800
use DeepMLKernel
policy no_network

kernel DMK_09800(input: Tensor<f32>[5,16]) -> Tensor<f32>[5,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..5 tile 16 {
        vectorize 16
        output[i] = input[i] * 5.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_09800.dmk"
