module corpus.deepml_kernel.example_02560
use DeepMLKernel
policy no_network

kernel DMK_02560(input: Tensor<f32>[40,1]) -> Tensor<f32>[40,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..40 tile 1 {
        vectorize 1
        output[i] = input[i] * 19.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02560.dmk"
