module corpus.deepml_kernel.example_02629
use DeepMLKernel
policy no_network

kernel DMK_02629(input: Tensor<f32>[12,1]) -> Tensor<f32>[12,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..12 tile 1 {
        vectorize 1
        output[i] = input[i] * 26.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02629.dmk"
