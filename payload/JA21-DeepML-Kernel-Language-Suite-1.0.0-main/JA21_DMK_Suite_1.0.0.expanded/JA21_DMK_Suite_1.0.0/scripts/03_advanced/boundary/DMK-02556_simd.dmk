module corpus.deepml_kernel.example_02556
use DeepMLKernel
policy no_network

kernel DMK_02556(input: Tensor<f32>[36,1]) -> Tensor<f32>[36,1]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..36 tile 1 {
        vectorize 1
        output[i] = input[i] * 15.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02556.dmk"
