module corpus.deepml_kernel.example_02266
use DeepMLKernel
policy no_network

kernel DMK_02266(input: Tensor<f32>[37,48]) -> Tensor<f32>[37,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..37 tile 32 {
        vectorize 16
        output[i] = input[i] * 4.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02266.dmk"
