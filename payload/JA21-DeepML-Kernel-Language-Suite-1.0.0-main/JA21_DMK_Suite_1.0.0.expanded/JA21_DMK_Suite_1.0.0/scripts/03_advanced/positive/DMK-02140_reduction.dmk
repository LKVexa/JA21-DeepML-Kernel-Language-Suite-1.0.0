ja source 0.3
module corpus.deepml_kernel.example_02140
use DeepMLKernel
policy no_network

kernel DMK_02140(input: Tensor<f32>[8,16]) -> Tensor<f32>[8,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..8 tile 16 {
        vectorize 16
        output[i] = input[i] * 2.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02140.dmk"
