module corpus.deepml_kernel.example_02244
use DeepMLKernel
policy no_network

kernel DMK_02244(input: Tensor<f32>[15,16]) -> Tensor<f32>[15,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..15 tile 16 {
        vectorize 16
        output[i] = input[i] * 13.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02244.dmk"
