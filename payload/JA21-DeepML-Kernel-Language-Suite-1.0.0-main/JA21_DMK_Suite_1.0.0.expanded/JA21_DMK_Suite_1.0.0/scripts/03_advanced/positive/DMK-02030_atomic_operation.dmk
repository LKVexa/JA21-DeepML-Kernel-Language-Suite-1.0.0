ja source 0.3
module corpus.deepml_kernel.example_02030
use DeepMLKernel
policy no_network

kernel DMK_02030(input: Tensor<f32>[92,48]) -> Tensor<f32>[92,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..92 tile 32 {
        vectorize 16
        output[i] = input[i] * 16.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02030.dmk"
