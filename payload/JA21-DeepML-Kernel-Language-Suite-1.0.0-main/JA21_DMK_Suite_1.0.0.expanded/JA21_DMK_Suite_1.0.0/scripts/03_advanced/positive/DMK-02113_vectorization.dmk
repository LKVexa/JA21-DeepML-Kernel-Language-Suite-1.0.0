module corpus.deepml_kernel.example_02113
use DeepMLKernel
policy no_network

kernel DMK_02113(input: Tensor<f32>[78,32]) -> Tensor<f32>[78,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..78 tile 32 {
        vectorize 16
        output[i] = input[i] * 6.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02113.dmk"
