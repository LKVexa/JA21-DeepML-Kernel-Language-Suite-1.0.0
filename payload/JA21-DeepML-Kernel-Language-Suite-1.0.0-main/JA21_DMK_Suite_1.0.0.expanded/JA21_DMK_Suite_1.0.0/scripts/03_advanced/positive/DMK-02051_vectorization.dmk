ja source 0.3
module corpus.deepml_kernel.example_02051
use DeepMLKernel
policy no_network

kernel DMK_02051(input: Tensor<f32>[16,64]) -> Tensor<f32>[16,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..16 tile 32 {
        vectorize 16
        output[i] = input[i] * 6.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02051.dmk"
