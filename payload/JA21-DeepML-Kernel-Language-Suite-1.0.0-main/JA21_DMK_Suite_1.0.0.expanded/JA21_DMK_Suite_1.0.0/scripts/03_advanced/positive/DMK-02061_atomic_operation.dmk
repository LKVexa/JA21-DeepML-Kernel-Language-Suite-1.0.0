module corpus.deepml_kernel.example_02061
use DeepMLKernel
policy no_network

kernel DMK_02061(input: Tensor<f32>[26,32]) -> Tensor<f32>[26,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..26 tile 32 {
        vectorize 16
        output[i] = input[i] * 16.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02061.dmk"
