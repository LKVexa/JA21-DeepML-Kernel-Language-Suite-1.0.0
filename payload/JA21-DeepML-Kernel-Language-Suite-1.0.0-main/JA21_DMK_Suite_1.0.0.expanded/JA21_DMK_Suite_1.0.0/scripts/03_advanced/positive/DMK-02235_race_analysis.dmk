module corpus.deepml_kernel.example_02235
use DeepMLKernel
policy no_network

kernel DMK_02235(input: Tensor<f32>[6,64]) -> Tensor<f32>[6,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..6 tile 32 {
        vectorize 16
        output[i] = input[i] * 4.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02235.dmk"
