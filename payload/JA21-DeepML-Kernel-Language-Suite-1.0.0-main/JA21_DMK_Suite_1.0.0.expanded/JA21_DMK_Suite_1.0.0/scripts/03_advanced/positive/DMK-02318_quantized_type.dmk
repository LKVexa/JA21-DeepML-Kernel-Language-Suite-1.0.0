module corpus.deepml_kernel.example_02318
use DeepMLKernel
policy no_network

kernel DMK_02318(input: Tensor<f32>[89,48]) -> Tensor<f32>[89,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..89 tile 32 {
        vectorize 16
        output[i] = input[i] * 25.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02318.dmk"
