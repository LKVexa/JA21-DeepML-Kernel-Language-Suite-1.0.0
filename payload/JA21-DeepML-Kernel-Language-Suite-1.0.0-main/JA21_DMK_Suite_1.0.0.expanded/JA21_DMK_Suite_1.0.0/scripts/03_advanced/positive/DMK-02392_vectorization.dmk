module corpus.deepml_kernel.example_02392
use DeepMLKernel
policy no_network

kernel DMK_02392(input: Tensor<f32>[66,16]) -> Tensor<f32>[66,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..66 tile 16 {
        vectorize 16
        output[i] = input[i] * 6.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02392.dmk"
