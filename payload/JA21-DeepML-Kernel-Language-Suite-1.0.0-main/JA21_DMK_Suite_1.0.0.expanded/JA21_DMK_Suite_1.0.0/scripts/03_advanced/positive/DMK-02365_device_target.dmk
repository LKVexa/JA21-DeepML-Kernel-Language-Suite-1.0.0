module corpus.deepml_kernel.example_02365
use DeepMLKernel
policy no_network

kernel DMK_02365(input: Tensor<f32>[39,32]) -> Tensor<f32>[39,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..39 tile 32 {
        vectorize 16
        output[i] = input[i] * 10.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02365.dmk"
