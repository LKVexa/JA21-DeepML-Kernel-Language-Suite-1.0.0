module corpus.deepml_kernel.example_02399
use DeepMLKernel
policy no_network

kernel DMK_02399(input: Tensor<f32>[73,64]) -> Tensor<f32>[73,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..73 tile 32 {
        vectorize 16
        output[i] = input[i] * 13.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02399.dmk"
