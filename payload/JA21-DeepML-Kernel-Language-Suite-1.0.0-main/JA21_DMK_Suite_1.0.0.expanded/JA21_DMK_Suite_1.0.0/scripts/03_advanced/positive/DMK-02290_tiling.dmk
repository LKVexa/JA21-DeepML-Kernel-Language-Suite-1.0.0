module corpus.deepml_kernel.example_02290
use DeepMLKernel
policy no_network

kernel DMK_02290(input: Tensor<f32>[61,48]) -> Tensor<f32>[61,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..61 tile 32 {
        vectorize 16
        output[i] = input[i] * 28.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02290.dmk"
