module corpus.deepml_kernel.example_02054
use DeepMLKernel
policy no_network

kernel DMK_02054(input: Tensor<f32>[19,48]) -> Tensor<f32>[19,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..19 tile 32 {
        vectorize 16
        output[i] = input[i] * 9.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02054.dmk"
