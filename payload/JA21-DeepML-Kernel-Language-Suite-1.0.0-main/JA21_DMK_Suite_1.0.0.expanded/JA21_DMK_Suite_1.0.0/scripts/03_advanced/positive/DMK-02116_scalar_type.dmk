module corpus.deepml_kernel.example_02116
use DeepMLKernel
policy no_network

kernel DMK_02116(input: Tensor<f32>[81,16]) -> Tensor<f32>[81,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..81 tile 16 {
        vectorize 16
        output[i] = input[i] * 9.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02116.dmk"
