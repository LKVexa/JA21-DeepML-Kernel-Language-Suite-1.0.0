module corpus.deepml_kernel.example_02388
use DeepMLKernel
policy no_network

kernel DMK_02388(input: Tensor<f32>[62,16]) -> Tensor<f32>[62,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..62 tile 16 {
        vectorize 16
        output[i] = input[i] * 2.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02388.dmk"
