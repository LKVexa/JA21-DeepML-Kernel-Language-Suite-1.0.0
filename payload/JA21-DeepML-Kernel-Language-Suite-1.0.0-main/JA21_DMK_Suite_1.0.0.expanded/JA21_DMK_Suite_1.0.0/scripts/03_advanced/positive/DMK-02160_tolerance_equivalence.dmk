module corpus.deepml_kernel.example_02160
use DeepMLKernel
policy no_network

kernel DMK_02160(input: Tensor<f32>[28,16]) -> Tensor<f32>[28,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..28 tile 16 {
        vectorize 16
        output[i] = input[i] * 22.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02160.dmk"
