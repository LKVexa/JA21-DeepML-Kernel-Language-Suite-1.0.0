module corpus.deepml_kernel.example_02129
use DeepMLKernel
policy no_network

kernel DMK_02129(input: Tensor<f32>[94,32]) -> Tensor<f32>[94,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..94 tile 32 {
        vectorize 16
        output[i] = input[i] * 22.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02129.dmk"
