module corpus.deepml_kernel.example_02342
use DeepMLKernel
policy no_network

kernel DMK_02342(input: Tensor<f32>[16,48]) -> Tensor<f32>[16,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..16 tile 32 {
        vectorize 16
        output[i] = input[i] * 18.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02342.dmk"
