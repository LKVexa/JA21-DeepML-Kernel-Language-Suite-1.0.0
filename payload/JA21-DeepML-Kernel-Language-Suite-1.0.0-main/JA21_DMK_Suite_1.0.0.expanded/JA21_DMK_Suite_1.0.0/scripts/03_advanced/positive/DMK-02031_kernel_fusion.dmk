module corpus.deepml_kernel.example_02031
use DeepMLKernel
policy no_network

kernel DMK_02031(input: Tensor<f32>[93,64]) -> Tensor<f32>[93,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..93 tile 32 {
        vectorize 16
        output[i] = input[i] * 17.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02031.dmk"
