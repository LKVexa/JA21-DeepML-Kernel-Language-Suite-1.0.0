module corpus.deepml_kernel.example_02085
use DeepMLKernel
policy no_network

kernel DMK_02085(input: Tensor<f32>[50,32]) -> Tensor<f32>[50,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..50 tile 32 {
        vectorize 16
        output[i] = input[i] * 9.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02085.dmk"
