module corpus.deepml_kernel.example_02749
use DeepMLKernel
policy no_network

kernel DMK_02749(input: Tensor<f32>[35,32]) -> Tensor<f32>[35,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..35 tile 32 {
        vectorize 16
        output[i] = input[i] * 22.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02749.dmk"
