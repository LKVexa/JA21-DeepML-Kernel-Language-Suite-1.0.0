module corpus.deepml_kernel.example_02720
use DeepMLKernel
policy no_network

kernel DMK_02720(input: Tensor<f32>[6,16]) -> Tensor<f32>[6,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..6 tile 16 {
        vectorize 16
        output[i] = input[i] * 24.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02720.dmk"
