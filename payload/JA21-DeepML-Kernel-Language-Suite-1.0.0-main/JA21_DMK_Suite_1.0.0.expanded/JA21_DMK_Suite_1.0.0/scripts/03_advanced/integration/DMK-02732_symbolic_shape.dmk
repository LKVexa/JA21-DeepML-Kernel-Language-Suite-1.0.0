module corpus.deepml_kernel.example_02732
use DeepMLKernel
policy no_network

kernel DMK_02732(input: Tensor<f32>[18,16]) -> Tensor<f32>[18,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..18 tile 16 {
        vectorize 16
        output[i] = input[i] * 5.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02732.dmk"
