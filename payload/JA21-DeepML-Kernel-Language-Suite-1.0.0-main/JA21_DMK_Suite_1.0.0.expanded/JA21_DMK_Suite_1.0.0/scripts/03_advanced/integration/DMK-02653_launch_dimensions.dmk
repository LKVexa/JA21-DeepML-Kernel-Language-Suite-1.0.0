module corpus.deepml_kernel.example_02653
use DeepMLKernel
policy no_network

kernel DMK_02653(input: Tensor<f32>[36,32]) -> Tensor<f32>[36,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..36 tile 32 {
        vectorize 16
        output[i] = input[i] * 19.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02653.dmk"
