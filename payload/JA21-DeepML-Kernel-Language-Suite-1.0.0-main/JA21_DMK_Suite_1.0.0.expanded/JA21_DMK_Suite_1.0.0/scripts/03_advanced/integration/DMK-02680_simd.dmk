module corpus.deepml_kernel.example_02680
use DeepMLKernel
policy no_network

kernel DMK_02680(input: Tensor<f32>[63,16]) -> Tensor<f32>[63,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..63 tile 16 {
        vectorize 16
        output[i] = input[i] * 15.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02680.dmk"
