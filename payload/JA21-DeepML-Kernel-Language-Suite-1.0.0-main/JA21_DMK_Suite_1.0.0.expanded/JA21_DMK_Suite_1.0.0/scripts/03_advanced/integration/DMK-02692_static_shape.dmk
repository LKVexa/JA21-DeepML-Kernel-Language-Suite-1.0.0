module corpus.deepml_kernel.example_02692
use DeepMLKernel
policy no_network

kernel DMK_02692(input: Tensor<f32>[75,16]) -> Tensor<f32>[75,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..75 tile 16 {
        vectorize 16
        output[i] = input[i] * 27.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02692.dmk"
