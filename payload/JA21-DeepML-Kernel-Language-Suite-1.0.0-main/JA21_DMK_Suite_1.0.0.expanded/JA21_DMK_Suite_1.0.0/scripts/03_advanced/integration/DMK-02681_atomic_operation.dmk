module corpus.deepml_kernel.example_02681
use DeepMLKernel
policy no_network

kernel DMK_02681(input: Tensor<f32>[64,32]) -> Tensor<f32>[64,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..64 tile 32 {
        vectorize 16
        output[i] = input[i] * 16.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02681.dmk"
