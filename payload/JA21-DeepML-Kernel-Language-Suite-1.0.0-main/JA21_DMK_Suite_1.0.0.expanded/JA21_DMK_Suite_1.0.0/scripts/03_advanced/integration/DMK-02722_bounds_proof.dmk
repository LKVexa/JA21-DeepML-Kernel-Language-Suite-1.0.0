module corpus.deepml_kernel.example_02722
use DeepMLKernel
policy no_network

kernel DMK_02722(input: Tensor<f32>[8,48]) -> Tensor<f32>[8,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..8 tile 32 {
        vectorize 16
        output[i] = input[i] * 26.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02722.dmk"
