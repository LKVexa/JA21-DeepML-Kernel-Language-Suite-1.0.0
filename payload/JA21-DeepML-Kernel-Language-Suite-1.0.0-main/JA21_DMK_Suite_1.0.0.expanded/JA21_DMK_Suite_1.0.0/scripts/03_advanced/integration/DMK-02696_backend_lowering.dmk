module corpus.deepml_kernel.example_02696
use DeepMLKernel
policy no_network

kernel DMK_02696(input: Tensor<f32>[79,16]) -> Tensor<f32>[79,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..79 tile 16 {
        vectorize 16
        output[i] = input[i] * 31.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02696.dmk"
