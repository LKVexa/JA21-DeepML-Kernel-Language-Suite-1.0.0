ja source 0.3
module corpus.deepml_kernel.example_02801
use DeepMLKernel
policy no_network

kernel DMK_02801(input: Tensor<f32>[87,32]) -> Tensor<f32>[87,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..87 tile 32 {
        vectorize 16
        output[i] = input[i] * 12.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_02801.dmk"
