module corpus.deepml_kernel.example_02815
use DeepMLKernel
policy no_network

kernel DMK_02815(input: Tensor<f32>[4,64]) -> Tensor<f32>[4,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..4 tile 32 {
        vectorize 16
        output[i] = input[i] * 26.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_02815.dmk"
