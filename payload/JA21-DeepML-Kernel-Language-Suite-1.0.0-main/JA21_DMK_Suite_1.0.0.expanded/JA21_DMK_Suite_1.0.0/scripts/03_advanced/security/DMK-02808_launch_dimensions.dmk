module corpus.deepml_kernel.example_02808
use DeepMLKernel
policy no_network

kernel DMK_02808(input: Tensor<f32>[94,16]) -> Tensor<f32>[94,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..94 tile 16 {
        vectorize 16
        output[i] = input[i] * 19.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_02808.dmk"
