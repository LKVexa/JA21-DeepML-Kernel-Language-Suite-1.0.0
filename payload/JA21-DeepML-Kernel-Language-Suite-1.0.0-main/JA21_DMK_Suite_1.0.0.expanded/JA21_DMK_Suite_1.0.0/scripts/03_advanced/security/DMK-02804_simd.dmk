module corpus.deepml_kernel.example_02804
use DeepMLKernel
policy no_network

kernel DMK_02804(input: Tensor<f32>[90,16]) -> Tensor<f32>[90,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..90 tile 16 {
        vectorize 16
        output[i] = input[i] * 15.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_02804.dmk"
