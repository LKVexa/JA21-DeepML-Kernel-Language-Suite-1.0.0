module corpus.deepml_kernel.example_02777
use DeepMLKernel
policy no_network

kernel DMK_02777(input: Tensor<f32>[63,32]) -> Tensor<f32>[63,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..63 tile 32 {
        vectorize 16
        output[i] = input[i] * 19.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_02777.dmk"
