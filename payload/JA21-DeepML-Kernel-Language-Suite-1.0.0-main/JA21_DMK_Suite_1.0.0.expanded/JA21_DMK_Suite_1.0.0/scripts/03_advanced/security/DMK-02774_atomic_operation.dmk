module corpus.deepml_kernel.example_02774
use DeepMLKernel
policy no_network

kernel DMK_02774(input: Tensor<f32>[60,48]) -> Tensor<f32>[60,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..60 tile 32 {
        vectorize 16
        output[i] = input[i] * 16.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_02774.dmk"
