module corpus.deepml_kernel.example_02919
use DeepMLKernel
policy no_network

kernel DMK_02919(input: Tensor<f32>[11,64]) -> Tensor<f32>[11,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..11 tile 32 {
        vectorize 16
        output[i] = input[i] * 6.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02919.dmk"
