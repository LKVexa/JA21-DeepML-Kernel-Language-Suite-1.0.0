module corpus.deepml_kernel.example_02920
use DeepMLKernel
policy no_network

kernel DMK_02920(input: Tensor<f32>[12,16]) -> Tensor<f32>[12,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..12 tile 16 {
        vectorize 16
        output[i] = input[i] * 7.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02920.dmk"
