module corpus.deepml_kernel.example_02878
use DeepMLKernel
policy no_network

kernel DMK_02878(input: Tensor<f32>[67,48]) -> Tensor<f32>[67,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..67 tile 32 {
        vectorize 16
        output[i] = input[i] * 27.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02878.dmk"
