module corpus.deepml_kernel.example_02905
use DeepMLKernel
policy no_network

kernel DMK_02905(input: Tensor<f32>[94,32]) -> Tensor<f32>[94,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..94 tile 32 {
        vectorize 16
        output[i] = input[i] * 23.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02905.dmk"
