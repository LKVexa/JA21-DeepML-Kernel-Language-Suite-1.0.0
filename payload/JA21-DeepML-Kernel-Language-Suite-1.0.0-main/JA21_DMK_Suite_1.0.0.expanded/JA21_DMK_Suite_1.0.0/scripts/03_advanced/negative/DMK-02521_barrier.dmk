module corpus.deepml_kernel.example_02521
use DeepMLKernel
policy no_network

kernel DMK_02521(input: Tensor<f32>[98,32]) -> Tensor<f32>[98,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..98 tile 32 {
        vectorize 16
        output[i] = input[i] * 11.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_02521.dmk"
