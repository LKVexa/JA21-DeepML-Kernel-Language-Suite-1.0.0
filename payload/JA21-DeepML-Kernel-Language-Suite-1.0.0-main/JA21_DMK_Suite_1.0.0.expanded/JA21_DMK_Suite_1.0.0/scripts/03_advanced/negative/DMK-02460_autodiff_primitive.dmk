module corpus.deepml_kernel.example_02460
use DeepMLKernel
policy no_network

kernel DMK_02460(input: Tensor<f32>[37,16]) -> Tensor<f32>[37,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..37 tile 16 {
        vectorize 16
        output[i] = input[i] * 12.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_02460.dmk"
