module corpus.deepml_kernel.example_02440
use DeepMLKernel
policy no_network

kernel DMK_02440(input: Tensor<f32>[17,16]) -> Tensor<f32>[17,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..17 tile 16 {
        vectorize 16
        output[i] = input[i] * 23.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_02440.dmk"
