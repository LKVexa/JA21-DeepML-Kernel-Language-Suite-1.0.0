module corpus.deepml_kernel.example_02547
use DeepMLKernel
policy no_network

kernel DMK_02547(input: Tensor<f32>[27,64]) -> Tensor<f32>[27,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..27 tile 32 {
        vectorize 16
        output[i] = input[i] * 6.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_02547.dmk"
