module corpus.deepml_kernel.example_02482
use DeepMLKernel
policy no_network

kernel DMK_02482(input: Tensor<f32>[59,48]) -> Tensor<f32>[59,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..59 tile 32 {
        vectorize 16
        output[i] = input[i] * 3.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_02482.dmk"
