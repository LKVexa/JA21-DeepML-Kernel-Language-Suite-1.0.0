module corpus.deepml_kernel.example_02506
use DeepMLKernel
policy no_network

kernel DMK_02506(input: Tensor<f32>[83,48]) -> Tensor<f32>[83,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..83 tile 32 {
        vectorize 16
        output[i] = input[i] * 27.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_02506.dmk"
