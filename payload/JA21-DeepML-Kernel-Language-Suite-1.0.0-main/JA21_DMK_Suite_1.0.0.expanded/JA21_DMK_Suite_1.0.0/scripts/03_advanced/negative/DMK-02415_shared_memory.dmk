module corpus.deepml_kernel.example_02415
use DeepMLKernel
policy no_network

kernel DMK_02415(input: Tensor<f32>[89,64]) -> Tensor<f32>[89,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..89 tile 32 {
        vectorize 16
        output[i] = input[i] * 29.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_02415.dmk"
