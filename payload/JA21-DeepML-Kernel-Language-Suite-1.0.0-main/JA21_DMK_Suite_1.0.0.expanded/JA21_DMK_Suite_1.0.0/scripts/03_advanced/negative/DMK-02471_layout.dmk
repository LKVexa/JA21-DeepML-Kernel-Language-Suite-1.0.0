module corpus.deepml_kernel.example_02471
use DeepMLKernel
policy no_network

kernel DMK_02471(input: Tensor<f32>[48,64]) -> Tensor<f32>[48,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..48 tile 32 {
        vectorize 16
        output[i] = input[i] * 23.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_02471.dmk"
