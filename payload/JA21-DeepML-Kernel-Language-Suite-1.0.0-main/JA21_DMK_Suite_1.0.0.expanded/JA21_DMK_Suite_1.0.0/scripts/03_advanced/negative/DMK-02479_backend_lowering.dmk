module corpus.deepml_kernel.example_02479
use DeepMLKernel
policy no_network

kernel DMK_02479(input: Tensor<f32>[56,64]) -> Tensor<f32>[56,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..56 tile 32 {
        vectorize 16
        output[i] = input[i] * 31.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_02479.dmk"
