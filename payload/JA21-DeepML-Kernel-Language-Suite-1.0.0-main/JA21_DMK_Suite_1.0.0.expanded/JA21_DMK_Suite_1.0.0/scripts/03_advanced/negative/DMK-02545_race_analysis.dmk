ja source 0.3
module corpus.deepml_kernel.example_02545
use DeepMLKernel
policy no_network

kernel DMK_02545(input: Tensor<f32>[25,32]) -> Tensor<f32>[25,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..25 tile 32 {
        vectorize 16
        output[i] = input[i] * 4.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_02545.dmk"
