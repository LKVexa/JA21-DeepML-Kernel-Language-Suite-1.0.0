module corpus.deepml_kernel.example_02405
use DeepMLKernel
policy no_network

kernel DMK_02405(input: Tensor<f32>[79,32]) -> Tensor<f32>[79,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..79 tile 32 {
        vectorize 16
        output[i] = input[i] * 19.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_02405.dmk"
