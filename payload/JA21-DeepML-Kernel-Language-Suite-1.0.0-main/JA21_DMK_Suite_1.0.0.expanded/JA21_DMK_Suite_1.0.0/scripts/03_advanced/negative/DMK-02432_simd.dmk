ja source 0.3
module corpus.deepml_kernel.example_02432
use DeepMLKernel
policy no_network

kernel DMK_02432(input: Tensor<f32>[9,16]) -> Tensor<f32>[9,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..9 tile 16 {
        vectorize 16
        output[i] = input[i] * 15.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_02432.dmk"
