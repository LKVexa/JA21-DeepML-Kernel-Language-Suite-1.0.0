ja source 0.3
module corpus.deepml_kernel.example_02929
use DeepMLKernel
policy no_network

kernel DMK_02929(input: Tensor<f32>[21,32]) -> Tensor<f32>[21,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..21 tile 32 {
        vectorize 16
        output[i] = input[i] * 16.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02929.dmk"
