module corpus.deepml_kernel.example_02864
use DeepMLKernel
policy no_network

kernel DMK_02864(input: Tensor<f32>[53,16]) -> Tensor<f32>[53,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..53 tile 16 {
        vectorize 16
        output[i] = input[i] * 13.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_02864.dmk"
