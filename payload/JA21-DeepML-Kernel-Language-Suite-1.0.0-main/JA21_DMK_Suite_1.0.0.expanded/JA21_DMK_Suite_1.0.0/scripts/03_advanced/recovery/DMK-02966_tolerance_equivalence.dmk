module corpus.deepml_kernel.example_02966
use DeepMLKernel
policy no_network

kernel DMK_02966(input: Tensor<f32>[58,48]) -> Tensor<f32>[58,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..58 tile 32 {
        vectorize 16
        output[i] = input[i] * 22.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_02966.dmk"
