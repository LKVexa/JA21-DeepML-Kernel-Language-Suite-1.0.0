module corpus.deepml_kernel.example_02967
use DeepMLKernel
policy no_network

kernel DMK_02967(input: Tensor<f32>[59,64]) -> Tensor<f32>[59,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..59 tile 32 {
        vectorize 16
        output[i] = input[i] * 23.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_02967.dmk"
