module corpus.deepml_kernel.example_02960
use DeepMLKernel
policy no_network

kernel DMK_02960(input: Tensor<f32>[52,16]) -> Tensor<f32>[52,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..52 tile 16 {
        vectorize 16
        output[i] = input[i] * 16.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_02960.dmk"
