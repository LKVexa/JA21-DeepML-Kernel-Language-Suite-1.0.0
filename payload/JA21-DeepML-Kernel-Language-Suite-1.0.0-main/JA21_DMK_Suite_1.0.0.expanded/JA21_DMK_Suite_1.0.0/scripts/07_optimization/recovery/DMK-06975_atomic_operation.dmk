module corpus.deepml_kernel.example_06975
use DeepMLKernel
policy no_network

kernel DMK_06975(input: Tensor<f32>[90,64]) -> Tensor<f32>[90,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..90 tile 32 {
        vectorize 16
        output[i] = input[i] * 1.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_06975.dmk"
