module corpus.deepml_kernel.example_06965
use DeepMLKernel
policy no_network

kernel DMK_06965(input: Tensor<f32>[80,32]) -> Tensor<f32>[80,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..80 tile 32 {
        vectorize 16
        output[i] = input[i] * 22.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_06965.dmk"
