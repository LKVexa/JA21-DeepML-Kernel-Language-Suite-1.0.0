module corpus.deepml_kernel.example_06958
use DeepMLKernel
policy no_network

kernel DMK_06958(input: Tensor<f32>[73,48]) -> Tensor<f32>[73,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..73 tile 32 {
        vectorize 16
        output[i] = input[i] * 15.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_06958.dmk"
