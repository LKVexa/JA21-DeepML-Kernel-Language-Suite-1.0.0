module corpus.deepml_kernel.example_06642
use DeepMLKernel
policy no_network

kernel DMK_06642(input: Tensor<f32>[48,1]) -> Tensor<f32>[48,1]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..48 tile 1 {
        vectorize 1
        output[i] = input[i] * 9.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06642.dmk"
