module corpus.deepml_kernel.example_06575
use DeepMLKernel
policy no_network

kernel DMK_06575(input: Tensor<f32>[78,1]) -> Tensor<f32>[78,1]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..78 tile 1 {
        vectorize 1
        output[i] = input[i] * 4.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06575.dmk"
