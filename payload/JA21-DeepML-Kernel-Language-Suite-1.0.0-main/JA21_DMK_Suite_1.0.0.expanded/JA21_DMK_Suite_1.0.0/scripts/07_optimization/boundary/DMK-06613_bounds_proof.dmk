module corpus.deepml_kernel.example_06613
use DeepMLKernel
policy no_network

kernel DMK_06613(input: Tensor<f32>[19,1]) -> Tensor<f32>[19,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..19 tile 1 {
        vectorize 1
        output[i] = input[i] * 11.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06613.dmk"
