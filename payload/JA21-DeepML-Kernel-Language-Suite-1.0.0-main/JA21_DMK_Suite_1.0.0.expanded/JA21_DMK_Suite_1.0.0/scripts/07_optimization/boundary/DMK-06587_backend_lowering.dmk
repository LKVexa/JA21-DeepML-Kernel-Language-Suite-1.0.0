module corpus.deepml_kernel.example_06587
use DeepMLKernel
policy no_network

kernel DMK_06587(input: Tensor<f32>[90,1]) -> Tensor<f32>[90,1]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..90 tile 1 {
        vectorize 1
        output[i] = input[i] * 16.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06587.dmk"
