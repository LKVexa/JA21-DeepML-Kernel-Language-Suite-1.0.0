module corpus.deepml_kernel.example_06816
use DeepMLKernel
policy no_network

kernel DMK_06816(input: Tensor<f32>[28,16]) -> Tensor<f32>[28,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..28 tile 16 {
        vectorize 16
        output[i] = input[i] * 28.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_06816.dmk"
