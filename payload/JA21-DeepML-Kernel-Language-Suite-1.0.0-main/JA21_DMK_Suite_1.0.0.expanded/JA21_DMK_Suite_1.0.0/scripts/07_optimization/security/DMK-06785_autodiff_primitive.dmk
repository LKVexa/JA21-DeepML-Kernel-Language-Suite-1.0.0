module corpus.deepml_kernel.example_06785
use DeepMLKernel
policy no_network

kernel DMK_06785(input: Tensor<f32>[94,32]) -> Tensor<f32>[94,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..94 tile 32 {
        vectorize 16
        output[i] = input[i] * 28.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_06785.dmk"
