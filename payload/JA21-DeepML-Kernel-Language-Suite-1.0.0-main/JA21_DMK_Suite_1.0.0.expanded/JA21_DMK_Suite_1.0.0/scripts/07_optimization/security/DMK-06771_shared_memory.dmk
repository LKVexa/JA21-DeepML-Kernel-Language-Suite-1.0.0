module corpus.deepml_kernel.example_06771
use DeepMLKernel
policy no_network

kernel DMK_06771(input: Tensor<f32>[80,64]) -> Tensor<f32>[80,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..80 tile 32 {
        vectorize 16
        output[i] = input[i] * 14.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_06771.dmk"
