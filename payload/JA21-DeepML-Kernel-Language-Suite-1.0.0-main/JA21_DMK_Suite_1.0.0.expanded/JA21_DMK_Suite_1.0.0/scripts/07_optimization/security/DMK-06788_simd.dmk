module corpus.deepml_kernel.example_06788
use DeepMLKernel
policy no_network

kernel DMK_06788(input: Tensor<f32>[97,16]) -> Tensor<f32>[97,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..97 tile 16 {
        vectorize 16
        output[i] = input[i] * 31.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_06788.dmk"
