module corpus.deepml_kernel.example_06758
use DeepMLKernel
policy no_network

kernel DMK_06758(input: Tensor<f32>[67,48]) -> Tensor<f32>[67,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..67 tile 32 {
        vectorize 16
        output[i] = input[i] * 1.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_06758.dmk"
