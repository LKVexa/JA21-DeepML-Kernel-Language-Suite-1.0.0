module corpus.deepml_kernel.example_06761
use DeepMLKernel
policy no_network

kernel DMK_06761(input: Tensor<f32>[70,32]) -> Tensor<f32>[70,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..70 tile 32 {
        vectorize 16
        output[i] = input[i] * 4.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_06761.dmk"
