module corpus.deepml_kernel.example_06792
use DeepMLKernel
policy no_network

kernel DMK_06792(input: Tensor<f32>[4,16]) -> Tensor<f32>[4,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..4 tile 16 {
        vectorize 16
        output[i] = input[i] * 4.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_06792.dmk"
