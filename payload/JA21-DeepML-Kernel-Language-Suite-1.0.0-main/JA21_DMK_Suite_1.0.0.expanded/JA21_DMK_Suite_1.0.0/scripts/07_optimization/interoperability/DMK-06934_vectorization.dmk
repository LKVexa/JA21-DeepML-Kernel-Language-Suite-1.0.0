module corpus.deepml_kernel.example_06934
use DeepMLKernel
policy no_network

kernel DMK_06934(input: Tensor<f32>[49,48]) -> Tensor<f32>[49,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..49 tile 32 {
        vectorize 16
        output[i] = input[i] * 22.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06934.dmk"
