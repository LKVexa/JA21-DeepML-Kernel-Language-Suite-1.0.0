module corpus.deepml_kernel.example_06735
use DeepMLKernel
policy no_network

kernel DMK_06735(input: Tensor<f32>[44,64]) -> Tensor<f32>[44,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..44 tile 32 {
        vectorize 16
        output[i] = input[i] * 9.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06735.dmk"
