module corpus.deepml_kernel.example_06748
use DeepMLKernel
policy no_network

kernel DMK_06748(input: Tensor<f32>[57,16]) -> Tensor<f32>[57,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..57 tile 16 {
        vectorize 16
        output[i] = input[i] * 22.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06748.dmk"
