module corpus.deepml_kernel.example_06668
use DeepMLKernel
policy no_network

kernel DMK_06668(input: Tensor<f32>[74,16]) -> Tensor<f32>[74,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..74 tile 16 {
        vectorize 16
        output[i] = input[i] * 4.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06668.dmk"
