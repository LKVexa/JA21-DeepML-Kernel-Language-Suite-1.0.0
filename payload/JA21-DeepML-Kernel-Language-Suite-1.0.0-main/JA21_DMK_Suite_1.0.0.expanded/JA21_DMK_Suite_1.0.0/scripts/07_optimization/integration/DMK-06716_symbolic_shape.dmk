module corpus.deepml_kernel.example_06716
use DeepMLKernel
policy no_network

kernel DMK_06716(input: Tensor<f32>[25,16]) -> Tensor<f32>[25,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..25 tile 16 {
        vectorize 16
        output[i] = input[i] * 21.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06716.dmk"
