module corpus.deepml_kernel.example_06665
use DeepMLKernel
policy no_network

kernel DMK_06665(input: Tensor<f32>[71,32]) -> Tensor<f32>[71,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..71 tile 32 {
        vectorize 16
        output[i] = input[i] * 1.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06665.dmk"
