module corpus.deepml_kernel.example_06737
use DeepMLKernel
policy no_network

kernel DMK_06737(input: Tensor<f32>[46,32]) -> Tensor<f32>[46,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..46 tile 32 {
        vectorize 16
        output[i] = input[i] * 11.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06737.dmk"
