module corpus.deepml_kernel.example_06711
use DeepMLKernel
policy no_network

kernel DMK_06711(input: Tensor<f32>[20,64]) -> Tensor<f32>[20,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..20 tile 32 {
        vectorize 16
        output[i] = input[i] * 16.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06711.dmk"
