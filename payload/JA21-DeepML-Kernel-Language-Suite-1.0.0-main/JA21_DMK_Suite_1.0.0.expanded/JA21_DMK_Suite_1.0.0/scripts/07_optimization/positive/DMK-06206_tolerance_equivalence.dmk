module corpus.deepml_kernel.example_06206
use DeepMLKernel
policy no_network

kernel DMK_06206(input: Tensor<f32>[97,48]) -> Tensor<f32>[97,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..97 tile 32 {
        vectorize 16
        output[i] = input[i] * 7.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06206.dmk"
