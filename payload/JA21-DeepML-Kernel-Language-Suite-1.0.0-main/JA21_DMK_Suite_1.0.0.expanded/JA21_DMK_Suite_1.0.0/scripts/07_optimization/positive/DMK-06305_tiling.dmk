module corpus.deepml_kernel.example_06305
use DeepMLKernel
policy no_network

kernel DMK_06305(input: Tensor<f32>[2,32]) -> Tensor<f32>[2,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..2 tile 32 {
        vectorize 16
        output[i] = input[i] * 13.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06305.dmk"
