module corpus.deepml_kernel.example_06336
use DeepMLKernel
policy no_network

kernel DMK_06336(input: Tensor<f32>[33,16]) -> Tensor<f32>[33,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..33 tile 16 {
        vectorize 16
        output[i] = input[i] * 13.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06336.dmk"
