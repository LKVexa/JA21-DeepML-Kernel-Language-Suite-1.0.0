module corpus.deepml_kernel.example_06333
use DeepMLKernel
policy no_network

kernel DMK_06333(input: Tensor<f32>[30,32]) -> Tensor<f32>[30,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..30 tile 32 {
        vectorize 16
        output[i] = input[i] * 10.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06333.dmk"
