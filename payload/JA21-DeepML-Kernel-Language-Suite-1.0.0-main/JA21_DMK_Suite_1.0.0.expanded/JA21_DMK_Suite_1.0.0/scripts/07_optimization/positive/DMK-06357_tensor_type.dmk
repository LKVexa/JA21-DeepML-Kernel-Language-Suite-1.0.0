module corpus.deepml_kernel.example_06357
use DeepMLKernel
policy no_network

kernel DMK_06357(input: Tensor<f32>[54,32]) -> Tensor<f32>[54,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..54 tile 32 {
        vectorize 16
        output[i] = input[i] * 3.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06357.dmk"
