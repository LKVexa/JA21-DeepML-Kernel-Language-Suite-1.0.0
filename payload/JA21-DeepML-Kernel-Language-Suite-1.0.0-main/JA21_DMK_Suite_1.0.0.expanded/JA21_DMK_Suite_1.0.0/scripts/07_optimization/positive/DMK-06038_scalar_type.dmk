module corpus.deepml_kernel.example_06038
use DeepMLKernel
policy no_network

kernel DMK_06038(input: Tensor<f32>[26,48]) -> Tensor<f32>[26,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..26 tile 32 {
        vectorize 16
        output[i] = input[i] * 25.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06038.dmk"
