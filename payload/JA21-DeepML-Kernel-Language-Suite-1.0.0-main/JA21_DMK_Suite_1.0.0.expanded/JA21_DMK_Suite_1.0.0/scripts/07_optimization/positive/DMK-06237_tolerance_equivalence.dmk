module corpus.deepml_kernel.example_06237
use DeepMLKernel
policy no_network

kernel DMK_06237(input: Tensor<f32>[31,32]) -> Tensor<f32>[31,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..31 tile 32 {
        vectorize 16
        output[i] = input[i] * 7.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06237.dmk"
