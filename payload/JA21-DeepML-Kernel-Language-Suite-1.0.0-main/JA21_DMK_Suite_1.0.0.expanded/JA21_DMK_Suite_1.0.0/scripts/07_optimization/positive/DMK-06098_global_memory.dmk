module corpus.deepml_kernel.example_06098
use DeepMLKernel
policy no_network

kernel DMK_06098(input: Tensor<f32>[86,48]) -> Tensor<f32>[86,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..86 tile 32 {
        vectorize 16
        output[i] = input[i] * 23.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06098.dmk"
