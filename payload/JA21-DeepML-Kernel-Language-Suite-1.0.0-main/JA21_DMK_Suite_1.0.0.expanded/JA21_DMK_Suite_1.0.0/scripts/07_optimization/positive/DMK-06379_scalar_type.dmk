module corpus.deepml_kernel.example_06379
use DeepMLKernel
policy no_network

kernel DMK_06379(input: Tensor<f32>[76,64]) -> Tensor<f32>[76,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..76 tile 32 {
        vectorize 16
        output[i] = input[i] * 25.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06379.dmk"
