module corpus.deepml_kernel.example_06015
use DeepMLKernel
policy no_network

kernel DMK_06015(input: Tensor<f32>[3,64]) -> Tensor<f32>[3,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..3 tile 32 {
        vectorize 16
        output[i] = input[i] * 2.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06015.dmk"
