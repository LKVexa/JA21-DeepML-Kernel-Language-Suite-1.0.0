module corpus.deepml_kernel.example_06097
use DeepMLKernel
policy no_network

kernel DMK_06097(input: Tensor<f32>[85,32]) -> Tensor<f32>[85,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..85 tile 32 {
        vectorize 16
        output[i] = input[i] * 22.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06097.dmk"
