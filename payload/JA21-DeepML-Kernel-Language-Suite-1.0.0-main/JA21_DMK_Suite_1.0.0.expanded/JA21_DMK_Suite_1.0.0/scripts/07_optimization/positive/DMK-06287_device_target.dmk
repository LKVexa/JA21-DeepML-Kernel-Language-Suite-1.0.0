module corpus.deepml_kernel.example_06287
use DeepMLKernel
policy no_network

kernel DMK_06287(input: Tensor<f32>[81,64]) -> Tensor<f32>[81,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..81 tile 32 {
        vectorize 16
        output[i] = input[i] * 26.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06287.dmk"
