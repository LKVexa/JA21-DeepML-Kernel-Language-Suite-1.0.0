module corpus.deepml_kernel.example_06045
use DeepMLKernel
policy no_network

kernel DMK_06045(input: Tensor<f32>[33,32]) -> Tensor<f32>[33,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..33 tile 32 {
        vectorize 16
        output[i] = input[i] * 1.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06045.dmk"
