module corpus.deepml_kernel.example_06197
use DeepMLKernel
policy no_network

kernel DMK_06197(input: Tensor<f32>[88,32]) -> Tensor<f32>[88,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..88 tile 32 {
        vectorize 16
        output[i] = input[i] * 29.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06197.dmk"
