module corpus.deepml_kernel.example_06281
use DeepMLKernel
policy no_network

kernel DMK_06281(input: Tensor<f32>[75,32]) -> Tensor<f32>[75,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..75 tile 32 {
        vectorize 16
        output[i] = input[i] * 20.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06281.dmk"
