module corpus.deepml_kernel.example_06014
use DeepMLKernel
policy no_network

kernel DMK_06014(input: Tensor<f32>[2,48]) -> Tensor<f32>[2,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..2 tile 32 {
        vectorize 16
        output[i] = input[i] * 1.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06014.dmk"
