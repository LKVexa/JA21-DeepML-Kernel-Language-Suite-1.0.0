module corpus.deepml_kernel.example_06228
use DeepMLKernel
policy no_network

kernel DMK_06228(input: Tensor<f32>[22,16]) -> Tensor<f32>[22,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..22 tile 16 {
        vectorize 16
        output[i] = input[i] * 29.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06228.dmk"
