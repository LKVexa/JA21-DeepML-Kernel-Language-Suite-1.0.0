module corpus.deepml_kernel.example_06376
use DeepMLKernel
policy no_network

kernel DMK_06376(input: Tensor<f32>[73,16]) -> Tensor<f32>[73,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..73 tile 16 {
        vectorize 16
        output[i] = input[i] * 22.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06376.dmk"
