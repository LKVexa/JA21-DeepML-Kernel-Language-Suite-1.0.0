module corpus.deepml_kernel.example_06259
use DeepMLKernel
policy no_network

kernel DMK_06259(input: Tensor<f32>[53,64]) -> Tensor<f32>[53,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..53 tile 32 {
        vectorize 16
        output[i] = input[i] * 29.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06259.dmk"
