module corpus.deepml_kernel.example_06100
use DeepMLKernel
policy no_network

kernel DMK_06100(input: Tensor<f32>[88,16]) -> Tensor<f32>[88,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..88 tile 16 {
        vectorize 16
        output[i] = input[i] * 25.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06100.dmk"
