module corpus.deepml_kernel.example_06546
use DeepMLKernel
policy no_network

kernel DMK_06546(input: Tensor<f32>[49,48]) -> Tensor<f32>[49,48]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..49 tile 32 {
        vectorize 16
        output[i] = input[i] * 6.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_06546.dmk"
