module corpus.deepml_kernel.example_06447
use DeepMLKernel
policy no_network

kernel DMK_06447(input: Tensor<f32>[47,64]) -> Tensor<f32>[47,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..47 tile 32 {
        vectorize 16
        output[i] = input[i] * 31.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_06447.dmk"
