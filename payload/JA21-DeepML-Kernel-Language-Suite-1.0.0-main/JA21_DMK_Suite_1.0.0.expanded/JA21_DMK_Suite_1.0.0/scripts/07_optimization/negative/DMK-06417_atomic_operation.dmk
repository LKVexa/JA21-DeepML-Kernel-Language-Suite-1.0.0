ja source 0.3
module corpus.deepml_kernel.example_06417
use DeepMLKernel
policy no_network

kernel DMK_06417(input: Tensor<f32>[17,32]) -> Tensor<f32>[17,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..17 tile 32 {
        vectorize 16
        output[i] = input[i] * 1.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_06417.dmk"
