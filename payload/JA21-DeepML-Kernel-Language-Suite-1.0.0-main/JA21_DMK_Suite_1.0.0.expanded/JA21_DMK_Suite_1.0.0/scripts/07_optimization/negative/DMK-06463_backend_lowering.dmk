module corpus.deepml_kernel.example_06463
use DeepMLKernel
policy no_network

kernel DMK_06463(input: Tensor<f32>[63,64]) -> Tensor<f32>[63,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..63 tile 32 {
        vectorize 16
        output[i] = input[i] * 16.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_06463.dmk"
