ja source 0.3
module corpus.deepml_kernel.example_06455
use DeepMLKernel
policy no_network

kernel DMK_06455(input: Tensor<f32>[55,64]) -> Tensor<f32>[55,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..55 tile 32 {
        vectorize 16
        output[i] = input[i] * 8.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_06455.dmk"
