module corpus.deepml_kernel.example_06521
use DeepMLKernel
policy no_network

kernel DMK_06521(input: Tensor<f32>[24,32]) -> Tensor<f32>[24,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..24 tile 32 {
        vectorize 16
        output[i] = input[i] * 12.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_06521.dmk"
