module corpus.deepml_kernel.example_06549
use DeepMLKernel
policy no_network

kernel DMK_06549(input: Tensor<f32>[52,32]) -> Tensor<f32>[52,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..52 tile 32 {
        vectorize 16
        output[i] = input[i] * 9.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_06549.dmk"
