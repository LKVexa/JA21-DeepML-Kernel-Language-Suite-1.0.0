module corpus.deepml_kernel.example_06430
use DeepMLKernel
policy no_network

kernel DMK_06430(input: Tensor<f32>[30,48]) -> Tensor<f32>[30,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..30 tile 32 {
        vectorize 16
        output[i] = input[i] * 14.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_06430.dmk"
