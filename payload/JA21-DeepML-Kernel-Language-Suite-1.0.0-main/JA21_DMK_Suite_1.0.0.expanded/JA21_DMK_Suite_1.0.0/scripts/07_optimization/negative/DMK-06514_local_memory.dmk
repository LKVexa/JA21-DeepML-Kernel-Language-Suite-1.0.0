module corpus.deepml_kernel.example_06514
use DeepMLKernel
policy no_network

kernel DMK_06514(input: Tensor<f32>[17,48]) -> Tensor<f32>[17,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..17 tile 32 {
        vectorize 16
        output[i] = input[i] * 5.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_06514.dmk"
