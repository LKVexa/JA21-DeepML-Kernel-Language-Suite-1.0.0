module corpus.deepml_kernel.example_06996
use DeepMLKernel
policy no_network

kernel DMK_06996(input: Tensor<f32>[14,16]) -> Tensor<f32>[14,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..14 tile 16 {
        vectorize 16
        output[i] = input[i] * 22.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06996.dmk"
