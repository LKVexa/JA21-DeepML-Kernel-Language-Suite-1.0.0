module corpus.deepml_kernel.example_06882
use DeepMLKernel
policy no_network

kernel DMK_06882(input: Tensor<f32>[94,48]) -> Tensor<f32>[94,48]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..94 tile 32 {
        vectorize 16
        output[i] = input[i] * 1.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06882.dmk"
