module corpus.deepml_kernel.example_06919
use DeepMLKernel
policy no_network

kernel DMK_06919(input: Tensor<f32>[34,64]) -> Tensor<f32>[34,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..34 tile 32 {
        vectorize 16
        output[i] = input[i] * 7.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06919.dmk"
