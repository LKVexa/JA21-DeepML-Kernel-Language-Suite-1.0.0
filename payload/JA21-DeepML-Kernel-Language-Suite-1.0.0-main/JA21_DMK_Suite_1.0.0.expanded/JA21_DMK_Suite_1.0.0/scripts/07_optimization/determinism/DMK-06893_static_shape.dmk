module corpus.deepml_kernel.example_06893
use DeepMLKernel
policy no_network

kernel DMK_06893(input: Tensor<f32>[8,32]) -> Tensor<f32>[8,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..8 tile 32 {
        vectorize 16
        output[i] = input[i] * 12.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06893.dmk"
