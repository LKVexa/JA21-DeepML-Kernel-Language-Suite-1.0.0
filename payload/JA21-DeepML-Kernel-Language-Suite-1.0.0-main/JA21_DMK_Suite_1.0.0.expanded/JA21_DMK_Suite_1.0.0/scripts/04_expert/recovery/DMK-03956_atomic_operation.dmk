module corpus.deepml_kernel.example_03956
use DeepMLKernel
policy no_network

kernel DMK_03956(input: Tensor<f32>[78,16]) -> Tensor<f32>[78,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..78 tile 16 {
        vectorize 16
        output[i] = input[i] * 20.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_03956.dmk"
