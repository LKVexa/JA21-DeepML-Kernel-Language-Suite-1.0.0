module corpus.deepml_kernel.example_03962
use DeepMLKernel
policy no_network

kernel DMK_03962(input: Tensor<f32>[84,48]) -> Tensor<f32>[84,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..84 tile 32 {
        vectorize 16
        output[i] = input[i] * 26.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_03962.dmk"
