module corpus.deepml_kernel.example_03869
use DeepMLKernel
policy no_network

kernel DMK_03869(input: Tensor<f32>[88,32]) -> Tensor<f32>[88,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..88 tile 32 {
        vectorize 16
        output[i] = input[i] * 26.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03869.dmk"
