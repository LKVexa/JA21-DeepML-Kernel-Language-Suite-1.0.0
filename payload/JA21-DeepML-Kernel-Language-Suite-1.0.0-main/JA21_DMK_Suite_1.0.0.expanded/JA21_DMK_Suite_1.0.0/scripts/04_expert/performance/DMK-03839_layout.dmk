module corpus.deepml_kernel.example_03839
use DeepMLKernel
policy no_network

kernel DMK_03839(input: Tensor<f32>[58,64]) -> Tensor<f32>[58,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..58 tile 32 {
        vectorize 16
        output[i] = input[i] * 27.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03839.dmk"
