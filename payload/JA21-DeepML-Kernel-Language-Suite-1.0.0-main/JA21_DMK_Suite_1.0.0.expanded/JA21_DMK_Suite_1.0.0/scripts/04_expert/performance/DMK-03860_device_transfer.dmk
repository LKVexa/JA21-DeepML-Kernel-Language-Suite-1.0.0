module corpus.deepml_kernel.example_03860
use DeepMLKernel
policy no_network

kernel DMK_03860(input: Tensor<f32>[79,16]) -> Tensor<f32>[79,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..79 tile 16 {
        vectorize 16
        output[i] = input[i] * 17.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03860.dmk"
