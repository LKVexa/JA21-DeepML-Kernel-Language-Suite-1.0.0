module corpus.deepml_kernel.example_03361
use DeepMLKernel
policy no_network

kernel DMK_03361(input: Tensor<f32>[65,32]) -> Tensor<f32>[65,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..65 tile 32 {
        vectorize 16
        output[i] = input[i] * 14.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03361.dmk"
