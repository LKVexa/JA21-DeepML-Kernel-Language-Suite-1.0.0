module corpus.deepml_kernel.example_03369
use DeepMLKernel
policy no_network

kernel DMK_03369(input: Tensor<f32>[73,32]) -> Tensor<f32>[73,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..73 tile 32 {
        vectorize 16
        output[i] = input[i] * 22.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03369.dmk"
