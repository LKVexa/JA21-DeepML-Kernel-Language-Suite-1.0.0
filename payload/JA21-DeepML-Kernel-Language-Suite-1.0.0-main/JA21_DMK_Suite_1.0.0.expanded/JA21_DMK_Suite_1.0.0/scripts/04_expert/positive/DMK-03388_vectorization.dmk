module corpus.deepml_kernel.example_03388
use DeepMLKernel
policy no_network

kernel DMK_03388(input: Tensor<f32>[92,16]) -> Tensor<f32>[92,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..92 tile 16 {
        vectorize 16
        output[i] = input[i] * 10.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03388.dmk"
