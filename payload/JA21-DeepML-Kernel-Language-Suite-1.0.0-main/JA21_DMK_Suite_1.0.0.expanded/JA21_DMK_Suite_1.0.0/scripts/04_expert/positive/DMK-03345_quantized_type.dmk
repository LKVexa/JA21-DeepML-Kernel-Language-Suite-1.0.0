module corpus.deepml_kernel.example_03345
use DeepMLKernel
policy no_network

kernel DMK_03345(input: Tensor<f32>[49,32]) -> Tensor<f32>[49,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..49 tile 32 {
        vectorize 16
        output[i] = input[i] * 29.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03345.dmk"
