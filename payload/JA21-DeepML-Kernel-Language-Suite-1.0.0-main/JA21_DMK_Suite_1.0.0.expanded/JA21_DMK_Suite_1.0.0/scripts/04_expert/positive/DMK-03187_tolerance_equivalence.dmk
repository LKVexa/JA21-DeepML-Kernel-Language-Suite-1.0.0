module corpus.deepml_kernel.example_03187
use DeepMLKernel
policy no_network

kernel DMK_03187(input: Tensor<f32>[85,64]) -> Tensor<f32>[85,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..85 tile 32 {
        vectorize 16
        output[i] = input[i] * 26.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03187.dmk"
