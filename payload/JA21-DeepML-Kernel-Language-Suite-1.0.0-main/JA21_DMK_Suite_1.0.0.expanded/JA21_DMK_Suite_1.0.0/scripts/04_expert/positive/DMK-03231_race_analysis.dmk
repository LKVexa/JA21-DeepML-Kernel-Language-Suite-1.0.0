module corpus.deepml_kernel.example_03231
use DeepMLKernel
policy no_network

kernel DMK_03231(input: Tensor<f32>[32,64]) -> Tensor<f32>[32,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..32 tile 32 {
        vectorize 16
        output[i] = input[i] * 8.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03231.dmk"
