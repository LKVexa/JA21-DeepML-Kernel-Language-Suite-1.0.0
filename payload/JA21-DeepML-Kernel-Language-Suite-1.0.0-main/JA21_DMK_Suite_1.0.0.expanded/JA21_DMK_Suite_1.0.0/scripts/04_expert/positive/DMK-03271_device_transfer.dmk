module corpus.deepml_kernel.example_03271
use DeepMLKernel
policy no_network

kernel DMK_03271(input: Tensor<f32>[72,64]) -> Tensor<f32>[72,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..72 tile 32 {
        vectorize 16
        output[i] = input[i] * 17.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03271.dmk"
