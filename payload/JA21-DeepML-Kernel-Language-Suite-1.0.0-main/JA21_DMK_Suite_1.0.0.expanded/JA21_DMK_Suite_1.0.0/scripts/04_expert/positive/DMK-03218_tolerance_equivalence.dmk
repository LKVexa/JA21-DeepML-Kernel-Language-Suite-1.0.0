module corpus.deepml_kernel.example_03218
use DeepMLKernel
policy no_network

kernel DMK_03218(input: Tensor<f32>[19,48]) -> Tensor<f32>[19,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..19 tile 32 {
        vectorize 16
        output[i] = input[i] * 26.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03218.dmk"
