module corpus.deepml_kernel.example_03255
use DeepMLKernel
policy no_network

kernel DMK_03255(input: Tensor<f32>[56,64]) -> Tensor<f32>[56,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..56 tile 32 {
        vectorize 16
        output[i] = input[i] * 1.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03255.dmk"
