module corpus.deepml_kernel.example_03167
use DeepMLKernel
policy no_network

kernel DMK_03167(input: Tensor<f32>[65,64]) -> Tensor<f32>[65,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..65 tile 32 {
        vectorize 16
        output[i] = input[i] * 6.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03167.dmk"
