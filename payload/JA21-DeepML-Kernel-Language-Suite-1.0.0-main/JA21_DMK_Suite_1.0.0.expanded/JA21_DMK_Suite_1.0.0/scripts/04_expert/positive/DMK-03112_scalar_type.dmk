module corpus.deepml_kernel.example_03112
use DeepMLKernel
policy no_network

kernel DMK_03112(input: Tensor<f32>[10,16]) -> Tensor<f32>[10,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..10 tile 16 {
        vectorize 16
        output[i] = input[i] * 13.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03112.dmk"
