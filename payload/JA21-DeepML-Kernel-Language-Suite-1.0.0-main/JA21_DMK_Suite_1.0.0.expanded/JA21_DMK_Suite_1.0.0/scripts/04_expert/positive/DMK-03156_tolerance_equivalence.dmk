module corpus.deepml_kernel.example_03156
use DeepMLKernel
policy no_network

kernel DMK_03156(input: Tensor<f32>[54,16]) -> Tensor<f32>[54,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..54 tile 16 {
        vectorize 16
        output[i] = input[i] * 26.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03156.dmk"
