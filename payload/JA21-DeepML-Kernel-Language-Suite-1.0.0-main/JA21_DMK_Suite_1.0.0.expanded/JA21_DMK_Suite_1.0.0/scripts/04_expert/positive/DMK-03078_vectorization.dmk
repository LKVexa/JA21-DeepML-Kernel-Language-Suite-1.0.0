module corpus.deepml_kernel.example_03078
use DeepMLKernel
policy no_network

kernel DMK_03078(input: Tensor<f32>[73,48]) -> Tensor<f32>[73,48]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..73 tile 32 {
        vectorize 16
        output[i] = input[i] * 10.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03078.dmk"
