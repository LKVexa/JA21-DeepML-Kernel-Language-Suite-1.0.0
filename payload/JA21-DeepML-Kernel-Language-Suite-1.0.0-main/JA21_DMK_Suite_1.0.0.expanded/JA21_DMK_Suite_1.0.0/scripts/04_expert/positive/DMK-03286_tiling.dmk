module corpus.deepml_kernel.example_03286
use DeepMLKernel
policy no_network

kernel DMK_03286(input: Tensor<f32>[87,48]) -> Tensor<f32>[87,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..87 tile 32 {
        vectorize 16
        output[i] = input[i] * 1.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03286.dmk"
