module corpus.deepml_kernel.example_03262
use DeepMLKernel
policy no_network

kernel DMK_03262(input: Tensor<f32>[63,48]) -> Tensor<f32>[63,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..63 tile 32 {
        vectorize 16
        output[i] = input[i] * 8.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03262.dmk"
