module corpus.deepml_kernel.example_03293
use DeepMLKernel
policy no_network

kernel DMK_03293(input: Tensor<f32>[94,32]) -> Tensor<f32>[94,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..94 tile 32 {
        vectorize 16
        output[i] = input[i] * 8.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03293.dmk"
