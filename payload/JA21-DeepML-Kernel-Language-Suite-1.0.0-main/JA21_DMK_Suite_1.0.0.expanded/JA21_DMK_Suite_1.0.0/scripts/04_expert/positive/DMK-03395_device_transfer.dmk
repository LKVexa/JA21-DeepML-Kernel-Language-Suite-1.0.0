module corpus.deepml_kernel.example_03395
use DeepMLKernel
policy no_network

kernel DMK_03395(input: Tensor<f32>[2,64]) -> Tensor<f32>[2,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..2 tile 32 {
        vectorize 16
        output[i] = input[i] * 17.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03395.dmk"
