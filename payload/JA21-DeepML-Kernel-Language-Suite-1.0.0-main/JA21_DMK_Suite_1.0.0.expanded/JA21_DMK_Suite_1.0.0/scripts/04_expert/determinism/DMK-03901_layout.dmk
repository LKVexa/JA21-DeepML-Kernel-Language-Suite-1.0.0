module corpus.deepml_kernel.example_03901
use DeepMLKernel
policy no_network

kernel DMK_03901(input: Tensor<f32>[23,32]) -> Tensor<f32>[23,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..23 tile 32 {
        vectorize 16
        output[i] = input[i] * 27.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03901.dmk"
