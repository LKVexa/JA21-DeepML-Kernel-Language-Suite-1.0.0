module corpus.deepml_kernel.example_03894
use DeepMLKernel
policy no_network

kernel DMK_03894(input: Tensor<f32>[16,48]) -> Tensor<f32>[16,48]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..16 tile 32 {
        vectorize 16
        output[i] = input[i] * 20.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03894.dmk"
