module corpus.deepml_kernel.example_03922
use DeepMLKernel
policy no_network

kernel DMK_03922(input: Tensor<f32>[44,48]) -> Tensor<f32>[44,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..44 tile 32 {
        vectorize 16
        output[i] = input[i] * 17.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03922.dmk"
