module corpus.deepml_kernel.example_03987
use DeepMLKernel
policy no_network

kernel DMK_03987(input: Tensor<f32>[12,64]) -> Tensor<f32>[12,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..12 tile 32 {
        vectorize 16
        output[i] = input[i] * 20.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03987.dmk"
