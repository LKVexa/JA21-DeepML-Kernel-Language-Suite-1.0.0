module corpus.deepml_kernel.example_03939
use DeepMLKernel
policy no_network

kernel DMK_03939(input: Tensor<f32>[61,64]) -> Tensor<f32>[61,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..61 tile 32 {
        vectorize 16
        output[i] = input[i] * 3.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03939.dmk"
