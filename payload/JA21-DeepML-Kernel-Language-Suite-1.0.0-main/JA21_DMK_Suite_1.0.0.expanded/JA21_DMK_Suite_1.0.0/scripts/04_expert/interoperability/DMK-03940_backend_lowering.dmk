module corpus.deepml_kernel.example_03940
use DeepMLKernel
policy no_network

kernel DMK_03940(input: Tensor<f32>[62,16]) -> Tensor<f32>[62,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..62 tile 16 {
        vectorize 16
        output[i] = input[i] * 4.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03940.dmk"
