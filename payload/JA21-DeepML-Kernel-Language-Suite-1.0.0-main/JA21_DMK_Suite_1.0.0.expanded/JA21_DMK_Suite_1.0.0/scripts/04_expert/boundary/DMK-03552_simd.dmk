module corpus.deepml_kernel.example_03552
use DeepMLKernel
policy no_network

kernel DMK_03552(input: Tensor<f32>[62,1]) -> Tensor<f32>[62,1]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..62 tile 1 {
        vectorize 1
        output[i] = input[i] * 19.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03552.dmk"
