ja source 0.3
module corpus.deepml_kernel.example_03599
use DeepMLKernel
policy no_network

kernel DMK_03599(input: Tensor<f32>[12,1]) -> Tensor<f32>[12,1]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..12 tile 1 {
        vectorize 1
        output[i] = input[i] * 4.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03599.dmk"
