module corpus.deepml_kernel.example_03635
use DeepMLKernel
policy no_network

kernel DMK_03635(input: Tensor<f32>[48,1]) -> Tensor<f32>[48,1]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..48 tile 1 {
        vectorize 1
        output[i] = input[i] * 9.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03635.dmk"
