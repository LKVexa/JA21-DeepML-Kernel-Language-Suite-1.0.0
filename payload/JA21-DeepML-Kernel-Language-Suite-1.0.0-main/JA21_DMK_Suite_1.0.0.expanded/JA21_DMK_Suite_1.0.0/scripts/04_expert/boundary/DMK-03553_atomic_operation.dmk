module corpus.deepml_kernel.example_03553
use DeepMLKernel
policy no_network

kernel DMK_03553(input: Tensor<f32>[63,1]) -> Tensor<f32>[63,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..63 tile 1 {
        vectorize 1
        output[i] = input[i] * 20.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03553.dmk"
