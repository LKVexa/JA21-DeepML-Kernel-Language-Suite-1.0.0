module corpus.deepml_kernel.example_03595
use DeepMLKernel
policy no_network

kernel DMK_03595(input: Tensor<f32>[8,1]) -> Tensor<f32>[8,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..8 tile 1 {
        vectorize 1
        output[i] = input[i] * 31.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03595.dmk"
