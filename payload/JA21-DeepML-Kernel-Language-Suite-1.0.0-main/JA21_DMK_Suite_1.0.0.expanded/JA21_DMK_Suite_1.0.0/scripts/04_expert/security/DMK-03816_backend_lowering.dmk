module corpus.deepml_kernel.example_03816
use DeepMLKernel
policy no_network

kernel DMK_03816(input: Tensor<f32>[35,16]) -> Tensor<f32>[35,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..35 tile 16 {
        vectorize 16
        output[i] = input[i] * 4.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_03816.dmk"
