module corpus.deepml_kernel.example_03768
use DeepMLKernel
policy no_network

kernel DMK_03768(input: Tensor<f32>[84,16]) -> Tensor<f32>[84,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..84 tile 16 {
        vectorize 16
        output[i] = input[i] * 18.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_03768.dmk"
