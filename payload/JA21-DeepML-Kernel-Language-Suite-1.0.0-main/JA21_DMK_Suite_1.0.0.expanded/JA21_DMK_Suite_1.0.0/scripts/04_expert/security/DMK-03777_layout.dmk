module corpus.deepml_kernel.example_03777
use DeepMLKernel
policy no_network

kernel DMK_03777(input: Tensor<f32>[93,32]) -> Tensor<f32>[93,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..93 tile 32 {
        vectorize 16
        output[i] = input[i] * 27.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_03777.dmk"
