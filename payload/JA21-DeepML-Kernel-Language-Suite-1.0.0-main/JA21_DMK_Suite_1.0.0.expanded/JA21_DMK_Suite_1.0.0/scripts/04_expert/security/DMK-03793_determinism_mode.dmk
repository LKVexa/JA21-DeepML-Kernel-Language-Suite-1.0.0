module corpus.deepml_kernel.example_03793
use DeepMLKernel
policy no_network

kernel DMK_03793(input: Tensor<f32>[12,32]) -> Tensor<f32>[12,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..12 tile 32 {
        vectorize 16
        output[i] = input[i] * 12.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_03793.dmk"
