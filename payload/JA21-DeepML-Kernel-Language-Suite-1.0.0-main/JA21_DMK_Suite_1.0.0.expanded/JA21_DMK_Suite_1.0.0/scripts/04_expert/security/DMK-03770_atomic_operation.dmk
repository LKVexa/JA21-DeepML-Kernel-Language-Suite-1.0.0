module corpus.deepml_kernel.example_03770
use DeepMLKernel
policy no_network

kernel DMK_03770(input: Tensor<f32>[86,48]) -> Tensor<f32>[86,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..86 tile 32 {
        vectorize 16
        output[i] = input[i] * 20.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_03770.dmk"
