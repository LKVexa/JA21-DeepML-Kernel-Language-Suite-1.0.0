ja source 0.3
module corpus.deepml_kernel.example_03401
use DeepMLKernel
policy no_network

kernel DMK_03401(input: Tensor<f32>[8,32]) -> Tensor<f32>[8,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..8 tile 32 {
        vectorize 16
        output[i] = input[i] * 23.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_03401.dmk"
