module corpus.deepml_kernel.example_03517
use DeepMLKernel
policy no_network

kernel DMK_03517(input: Tensor<f32>[27,32]) -> Tensor<f32>[27,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..27 tile 32 {
        vectorize 16
        output[i] = input[i] * 15.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_03517.dmk"
