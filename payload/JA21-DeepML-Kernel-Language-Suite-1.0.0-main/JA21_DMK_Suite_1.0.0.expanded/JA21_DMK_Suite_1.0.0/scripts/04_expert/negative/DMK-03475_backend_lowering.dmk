module corpus.deepml_kernel.example_03475
use DeepMLKernel
policy no_network

kernel DMK_03475(input: Tensor<f32>[82,64]) -> Tensor<f32>[82,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..82 tile 32 {
        vectorize 16
        output[i] = input[i] * 4.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_03475.dmk"
