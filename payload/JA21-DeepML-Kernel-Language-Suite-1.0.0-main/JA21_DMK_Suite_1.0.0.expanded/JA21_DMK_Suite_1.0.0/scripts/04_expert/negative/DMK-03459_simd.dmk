module corpus.deepml_kernel.example_03459
use DeepMLKernel
policy no_network

kernel DMK_03459(input: Tensor<f32>[66,64]) -> Tensor<f32>[66,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..66 tile 32 {
        vectorize 16
        output[i] = input[i] * 19.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_03459.dmk"
