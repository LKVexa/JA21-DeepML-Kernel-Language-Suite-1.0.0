module corpus.deepml_kernel.example_03495
use DeepMLKernel
policy no_network

kernel DMK_03495(input: Tensor<f32>[5,64]) -> Tensor<f32>[5,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..5 tile 32 {
        vectorize 16
        output[i] = input[i] * 24.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_03495.dmk"
