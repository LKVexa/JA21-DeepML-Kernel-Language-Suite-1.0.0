module corpus.deepml_kernel.example_03543
use DeepMLKernel
policy no_network

kernel DMK_03543(input: Tensor<f32>[53,64]) -> Tensor<f32>[53,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..53 tile 32 {
        vectorize 16
        output[i] = input[i] * 10.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_03543.dmk"
