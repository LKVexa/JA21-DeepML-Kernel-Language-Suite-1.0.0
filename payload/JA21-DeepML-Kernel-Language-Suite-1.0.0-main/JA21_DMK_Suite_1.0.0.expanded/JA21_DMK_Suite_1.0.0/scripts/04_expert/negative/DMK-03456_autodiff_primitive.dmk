ja source 0.3
module corpus.deepml_kernel.example_03456
use DeepMLKernel
policy no_network

kernel DMK_03456(input: Tensor<f32>[63,16]) -> Tensor<f32>[63,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..63 tile 16 {
        vectorize 16
        output[i] = input[i] * 16.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_03456.dmk"
