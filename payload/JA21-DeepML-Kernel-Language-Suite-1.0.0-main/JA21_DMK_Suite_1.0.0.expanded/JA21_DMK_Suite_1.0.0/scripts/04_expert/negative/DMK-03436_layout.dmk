module corpus.deepml_kernel.example_03436
use DeepMLKernel
policy no_network

kernel DMK_03436(input: Tensor<f32>[43,16]) -> Tensor<f32>[43,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..43 tile 16 {
        vectorize 16
        output[i] = input[i] * 27.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_03436.dmk"
