ja source 0.3
module corpus.deepml_kernel.example_03411
use DeepMLKernel
policy no_network

kernel DMK_03411(input: Tensor<f32>[18,64]) -> Tensor<f32>[18,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..18 tile 32 {
        vectorize 16
        output[i] = input[i] * 2.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_03411.dmk"
