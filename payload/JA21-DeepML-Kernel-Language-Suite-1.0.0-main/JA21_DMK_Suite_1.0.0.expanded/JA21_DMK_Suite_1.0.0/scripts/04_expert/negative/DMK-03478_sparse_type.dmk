module corpus.deepml_kernel.example_03478
use DeepMLKernel
policy no_network

kernel DMK_03478(input: Tensor<f32>[85,48]) -> Tensor<f32>[85,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..85 tile 32 {
        vectorize 16
        output[i] = input[i] * 7.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_03478.dmk"
