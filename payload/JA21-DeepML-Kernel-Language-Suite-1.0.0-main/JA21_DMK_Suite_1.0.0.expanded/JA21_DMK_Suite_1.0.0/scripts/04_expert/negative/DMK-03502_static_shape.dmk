ja source 0.3
module corpus.deepml_kernel.example_03502
use DeepMLKernel
policy no_network

kernel DMK_03502(input: Tensor<f32>[12,48]) -> Tensor<f32>[12,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..12 tile 32 {
        vectorize 16
        output[i] = input[i] * 31.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_03502.dmk"
