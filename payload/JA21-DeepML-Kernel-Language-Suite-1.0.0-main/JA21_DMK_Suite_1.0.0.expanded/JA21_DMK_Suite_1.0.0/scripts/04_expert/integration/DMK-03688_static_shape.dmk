module corpus.deepml_kernel.example_03688
use DeepMLKernel
policy no_network

kernel DMK_03688(input: Tensor<f32>[4,16]) -> Tensor<f32>[4,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..4 tile 16 {
        vectorize 16
        output[i] = input[i] * 31.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03688.dmk"
