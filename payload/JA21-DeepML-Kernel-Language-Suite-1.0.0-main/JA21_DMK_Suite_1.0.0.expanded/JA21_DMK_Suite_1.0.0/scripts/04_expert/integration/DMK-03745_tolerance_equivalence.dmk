module corpus.deepml_kernel.example_03745
use DeepMLKernel
policy no_network

kernel DMK_03745(input: Tensor<f32>[61,32]) -> Tensor<f32>[61,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..61 tile 32 {
        vectorize 16
        output[i] = input[i] * 26.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03745.dmk"
