module corpus.deepml_kernel.example_03680
use DeepMLKernel
policy no_network

kernel DMK_03680(input: Tensor<f32>[93,16]) -> Tensor<f32>[93,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..93 tile 16 {
        vectorize 16
        output[i] = input[i] * 23.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03680.dmk"
