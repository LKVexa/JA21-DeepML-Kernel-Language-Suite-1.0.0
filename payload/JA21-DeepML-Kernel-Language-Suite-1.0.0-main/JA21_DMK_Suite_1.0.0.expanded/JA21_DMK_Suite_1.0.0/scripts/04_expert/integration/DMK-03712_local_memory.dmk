module corpus.deepml_kernel.example_03712
use DeepMLKernel
policy no_network

kernel DMK_03712(input: Tensor<f32>[28,16]) -> Tensor<f32>[28,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..28 tile 16 {
        vectorize 16
        output[i] = input[i] * 24.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_03712.dmk"
