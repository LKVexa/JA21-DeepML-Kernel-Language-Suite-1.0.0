module corpus.deepml_kernel.example_05979
use DeepMLKernel
policy no_network

kernel DMK_05979(input: Tensor<f32>[64,64]) -> Tensor<f32>[64,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..64 tile 32 {
        vectorize 16
        output[i] = input[i] * 28.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05979.dmk"
