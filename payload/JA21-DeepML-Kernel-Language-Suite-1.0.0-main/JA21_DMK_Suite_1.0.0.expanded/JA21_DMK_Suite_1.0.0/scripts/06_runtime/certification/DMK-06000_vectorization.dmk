module corpus.deepml_kernel.example_06000
use DeepMLKernel
policy no_network

kernel DMK_06000(input: Tensor<f32>[85,16]) -> Tensor<f32>[85,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..85 tile 16 {
        vectorize 16
        output[i] = input[i] * 18.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_06000.dmk"
