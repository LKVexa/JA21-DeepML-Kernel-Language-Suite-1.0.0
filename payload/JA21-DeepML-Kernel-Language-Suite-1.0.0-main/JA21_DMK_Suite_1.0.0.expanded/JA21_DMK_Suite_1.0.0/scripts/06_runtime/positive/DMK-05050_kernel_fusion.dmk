ja source 0.3
module corpus.deepml_kernel.example_05050
use DeepMLKernel
policy no_network

kernel DMK_05050(input: Tensor<f32>[8,48]) -> Tensor<f32>[8,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..8 tile 32 {
        vectorize 16
        output[i] = input[i] * 29.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05050.dmk"
