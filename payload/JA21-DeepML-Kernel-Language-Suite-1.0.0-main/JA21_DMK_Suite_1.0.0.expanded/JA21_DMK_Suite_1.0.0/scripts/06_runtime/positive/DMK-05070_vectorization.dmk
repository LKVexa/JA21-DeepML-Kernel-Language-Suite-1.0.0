module corpus.deepml_kernel.example_05070
use DeepMLKernel
policy no_network

kernel DMK_05070(input: Tensor<f32>[28,48]) -> Tensor<f32>[28,48]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..28 tile 32 {
        vectorize 16
        output[i] = input[i] * 18.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05070.dmk"
