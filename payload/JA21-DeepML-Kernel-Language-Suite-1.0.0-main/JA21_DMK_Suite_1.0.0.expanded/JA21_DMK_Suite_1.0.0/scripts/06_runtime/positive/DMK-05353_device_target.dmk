module corpus.deepml_kernel.example_05353
use DeepMLKernel
policy no_network

kernel DMK_05353(input: Tensor<f32>[20,32]) -> Tensor<f32>[20,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..20 tile 32 {
        vectorize 16
        output[i] = input[i] * 22.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05353.dmk"
