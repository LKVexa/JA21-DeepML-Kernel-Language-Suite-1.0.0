module corpus.deepml_kernel.example_05263
use DeepMLKernel
policy no_network

kernel DMK_05263(input: Tensor<f32>[27,64]) -> Tensor<f32>[27,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..27 tile 32 {
        vectorize 16
        output[i] = input[i] * 25.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05263.dmk"
