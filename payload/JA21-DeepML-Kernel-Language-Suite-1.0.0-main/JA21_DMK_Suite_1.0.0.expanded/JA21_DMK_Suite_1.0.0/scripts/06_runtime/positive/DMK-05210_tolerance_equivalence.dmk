ja source 0.3
module corpus.deepml_kernel.example_05210
use DeepMLKernel
policy no_network

kernel DMK_05210(input: Tensor<f32>[71,48]) -> Tensor<f32>[71,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..71 tile 32 {
        vectorize 16
        output[i] = input[i] * 3.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05210.dmk"
