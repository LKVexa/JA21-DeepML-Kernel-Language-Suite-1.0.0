module corpus.deepml_kernel.example_05104
use DeepMLKernel
policy no_network

kernel DMK_05104(input: Tensor<f32>[62,16]) -> Tensor<f32>[62,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..62 tile 16 {
        vectorize 16
        output[i] = input[i] * 21.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05104.dmk"
