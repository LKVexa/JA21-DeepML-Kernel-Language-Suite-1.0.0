module corpus.deepml_kernel.example_05159
use DeepMLKernel
policy no_network

kernel DMK_05159(input: Tensor<f32>[20,64]) -> Tensor<f32>[20,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..20 tile 32 {
        vectorize 16
        output[i] = input[i] * 14.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05159.dmk"
