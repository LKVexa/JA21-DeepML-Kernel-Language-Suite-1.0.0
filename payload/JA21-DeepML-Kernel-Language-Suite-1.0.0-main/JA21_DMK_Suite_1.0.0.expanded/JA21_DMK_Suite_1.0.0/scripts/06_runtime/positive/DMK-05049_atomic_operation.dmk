module corpus.deepml_kernel.example_05049
use DeepMLKernel
policy no_network

kernel DMK_05049(input: Tensor<f32>[7,32]) -> Tensor<f32>[7,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..7 tile 32 {
        vectorize 16
        output[i] = input[i] * 28.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05049.dmk"
