module corpus.deepml_kernel.example_05164
use DeepMLKernel
policy no_network

kernel DMK_05164(input: Tensor<f32>[25,16]) -> Tensor<f32>[25,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..25 tile 16 {
        vectorize 16
        output[i] = input[i] * 19.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05164.dmk"
