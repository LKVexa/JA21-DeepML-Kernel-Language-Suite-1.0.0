ja source 0.3
module corpus.deepml_kernel.example_05128
use DeepMLKernel
policy no_network

kernel DMK_05128(input: Tensor<f32>[86,16]) -> Tensor<f32>[86,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..86 tile 16 {
        vectorize 16
        output[i] = input[i] * 14.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05128.dmk"
