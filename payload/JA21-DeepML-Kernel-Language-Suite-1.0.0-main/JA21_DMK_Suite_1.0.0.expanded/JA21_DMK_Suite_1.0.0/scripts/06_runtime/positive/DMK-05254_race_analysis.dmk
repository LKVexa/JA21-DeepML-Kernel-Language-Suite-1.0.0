module corpus.deepml_kernel.example_05254
use DeepMLKernel
policy no_network

kernel DMK_05254(input: Tensor<f32>[18,48]) -> Tensor<f32>[18,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..18 tile 32 {
        vectorize 16
        output[i] = input[i] * 16.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05254.dmk"
