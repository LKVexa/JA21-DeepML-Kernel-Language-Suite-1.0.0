module corpus.deepml_kernel.example_05340
use DeepMLKernel
policy no_network

kernel DMK_05340(input: Tensor<f32>[7,16]) -> Tensor<f32>[7,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..7 tile 16 {
        vectorize 16
        output[i] = input[i] * 9.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05340.dmk"
