module corpus.deepml_kernel.example_05380
use DeepMLKernel
policy no_network

kernel DMK_05380(input: Tensor<f32>[47,16]) -> Tensor<f32>[47,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..47 tile 16 {
        vectorize 16
        output[i] = input[i] * 18.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05380.dmk"
