ja source 0.3
module corpus.deepml_kernel.example_05102
use DeepMLKernel
policy no_network

kernel DMK_05102(input: Tensor<f32>[60,48]) -> Tensor<f32>[60,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..60 tile 32 {
        vectorize 16
        output[i] = input[i] * 19.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05102.dmk"
