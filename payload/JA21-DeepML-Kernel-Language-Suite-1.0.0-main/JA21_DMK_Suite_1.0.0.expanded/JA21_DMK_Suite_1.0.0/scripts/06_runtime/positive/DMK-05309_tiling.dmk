module corpus.deepml_kernel.example_05309
use DeepMLKernel
policy no_network

kernel DMK_05309(input: Tensor<f32>[73,32]) -> Tensor<f32>[73,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..73 tile 32 {
        vectorize 16
        output[i] = input[i] * 9.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05309.dmk"
