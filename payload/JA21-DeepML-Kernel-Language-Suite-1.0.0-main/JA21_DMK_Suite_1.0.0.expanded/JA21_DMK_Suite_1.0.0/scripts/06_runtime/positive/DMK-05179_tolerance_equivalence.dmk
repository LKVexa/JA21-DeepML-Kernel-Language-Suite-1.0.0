module corpus.deepml_kernel.example_05179
use DeepMLKernel
policy no_network

kernel DMK_05179(input: Tensor<f32>[40,64]) -> Tensor<f32>[40,64]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..40 tile 32 {
        vectorize 16
        output[i] = input[i] * 3.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05179.dmk"
