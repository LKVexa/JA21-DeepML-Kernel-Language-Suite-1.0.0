module corpus.deepml_kernel.example_05278
use DeepMLKernel
policy no_network

kernel DMK_05278(input: Tensor<f32>[42,48]) -> Tensor<f32>[42,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..42 tile 32 {
        vectorize 16
        output[i] = input[i] * 9.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05278.dmk"
