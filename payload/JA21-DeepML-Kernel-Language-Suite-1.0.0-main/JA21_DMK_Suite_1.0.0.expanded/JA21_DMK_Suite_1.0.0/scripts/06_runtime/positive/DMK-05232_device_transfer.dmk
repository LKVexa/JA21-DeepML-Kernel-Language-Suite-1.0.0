module corpus.deepml_kernel.example_05232
use DeepMLKernel
policy no_network

kernel DMK_05232(input: Tensor<f32>[93,16]) -> Tensor<f32>[93,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..93 tile 16 {
        vectorize 16
        output[i] = input[i] * 25.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05232.dmk"
