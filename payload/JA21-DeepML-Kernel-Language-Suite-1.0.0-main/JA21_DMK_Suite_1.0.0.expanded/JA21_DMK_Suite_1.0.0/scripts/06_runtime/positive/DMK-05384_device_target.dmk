module corpus.deepml_kernel.example_05384
use DeepMLKernel
policy no_network

kernel DMK_05384(input: Tensor<f32>[51,16]) -> Tensor<f32>[51,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..51 tile 16 {
        vectorize 16
        output[i] = input[i] * 22.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05384.dmk"
