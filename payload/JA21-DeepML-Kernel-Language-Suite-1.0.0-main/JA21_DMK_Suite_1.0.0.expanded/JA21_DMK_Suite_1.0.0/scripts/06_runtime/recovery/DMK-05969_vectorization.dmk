module corpus.deepml_kernel.example_05969
use DeepMLKernel
policy no_network

kernel DMK_05969(input: Tensor<f32>[54,32]) -> Tensor<f32>[54,32]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..54 tile 32 {
        vectorize 16
        output[i] = input[i] * 18.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_05969.dmk"
