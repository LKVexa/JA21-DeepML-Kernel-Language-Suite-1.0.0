module corpus.deepml_kernel.example_05975
use DeepMLKernel
policy no_network

kernel DMK_05975(input: Tensor<f32>[60,64]) -> Tensor<f32>[60,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..60 tile 32 {
        vectorize 16
        output[i] = input[i] * 24.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_05975.dmk"
