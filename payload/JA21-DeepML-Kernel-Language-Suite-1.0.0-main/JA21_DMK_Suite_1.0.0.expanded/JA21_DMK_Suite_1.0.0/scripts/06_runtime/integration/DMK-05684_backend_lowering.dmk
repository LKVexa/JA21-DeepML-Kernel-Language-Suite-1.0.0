module corpus.deepml_kernel.example_05684
use DeepMLKernel
policy no_network

kernel DMK_05684(input: Tensor<f32>[60,16]) -> Tensor<f32>[60,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..60 tile 16 {
        vectorize 16
        output[i] = input[i] * 12.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05684.dmk"
