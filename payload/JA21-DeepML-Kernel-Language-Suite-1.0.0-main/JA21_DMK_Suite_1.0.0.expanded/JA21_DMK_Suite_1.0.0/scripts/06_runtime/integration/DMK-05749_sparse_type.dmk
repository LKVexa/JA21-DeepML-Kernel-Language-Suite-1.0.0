module corpus.deepml_kernel.example_05749
use DeepMLKernel
policy no_network

kernel DMK_05749(input: Tensor<f32>[28,32]) -> Tensor<f32>[28,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..28 tile 32 {
        vectorize 16
        output[i] = input[i] * 15.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05749.dmk"
