module corpus.deepml_kernel.example_05739
use DeepMLKernel
policy no_network

kernel DMK_05739(input: Tensor<f32>[18,64]) -> Tensor<f32>[18,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..18 tile 32 {
        vectorize 16
        output[i] = input[i] * 5.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05739.dmk"
