module corpus.deepml_kernel.example_05672
use DeepMLKernel
policy no_network

kernel DMK_05672(input: Tensor<f32>[48,16]) -> Tensor<f32>[48,16]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..48 tile 16 {
        vectorize 16
        output[i] = input[i] * 31.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05672.dmk"
