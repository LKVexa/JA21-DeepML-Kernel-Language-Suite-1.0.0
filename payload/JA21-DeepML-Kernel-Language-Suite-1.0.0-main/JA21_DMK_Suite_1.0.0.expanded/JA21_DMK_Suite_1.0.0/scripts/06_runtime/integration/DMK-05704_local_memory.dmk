module corpus.deepml_kernel.example_05704
use DeepMLKernel
policy no_network

kernel DMK_05704(input: Tensor<f32>[80,16]) -> Tensor<f32>[80,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..80 tile 16 {
        vectorize 16
        output[i] = input[i] * 1.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05704.dmk"
