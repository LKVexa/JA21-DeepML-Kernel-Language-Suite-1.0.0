module corpus.deepml_kernel.example_05711
use DeepMLKernel
policy no_network

kernel DMK_05711(input: Tensor<f32>[87,64]) -> Tensor<f32>[87,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..87 tile 32 {
        vectorize 16
        output[i] = input[i] * 8.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05711.dmk"
