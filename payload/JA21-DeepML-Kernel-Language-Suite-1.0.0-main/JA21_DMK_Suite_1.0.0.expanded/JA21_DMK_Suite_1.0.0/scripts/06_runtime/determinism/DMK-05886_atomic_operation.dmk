module corpus.deepml_kernel.example_05886
use DeepMLKernel
policy no_network

kernel DMK_05886(input: Tensor<f32>[68,48]) -> Tensor<f32>[68,48]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..68 tile 32 {
        vectorize 16
        output[i] = input[i] * 28.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05886.dmk"
