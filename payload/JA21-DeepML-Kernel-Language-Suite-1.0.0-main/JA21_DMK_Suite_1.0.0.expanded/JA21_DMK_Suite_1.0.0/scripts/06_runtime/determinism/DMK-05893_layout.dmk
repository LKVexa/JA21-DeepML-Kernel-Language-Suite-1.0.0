module corpus.deepml_kernel.example_05893
use DeepMLKernel
policy no_network

kernel DMK_05893(input: Tensor<f32>[75,32]) -> Tensor<f32>[75,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..75 tile 32 {
        vectorize 16
        output[i] = input[i] * 4.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05893.dmk"
