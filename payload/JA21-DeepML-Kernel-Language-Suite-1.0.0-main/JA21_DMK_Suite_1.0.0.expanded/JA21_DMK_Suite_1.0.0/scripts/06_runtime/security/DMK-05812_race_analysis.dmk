module corpus.deepml_kernel.example_05812
use DeepMLKernel
policy no_network

kernel DMK_05812(input: Tensor<f32>[91,16]) -> Tensor<f32>[91,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..91 tile 16 {
        vectorize 16
        output[i] = input[i] * 16.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_05812.dmk"
