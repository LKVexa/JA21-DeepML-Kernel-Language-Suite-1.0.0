module corpus.deepml_kernel.example_05824
use DeepMLKernel
policy no_network

kernel DMK_05824(input: Tensor<f32>[6,16]) -> Tensor<f32>[6,16]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..6 tile 16 {
        vectorize 16
        output[i] = input[i] * 28.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_05824.dmk"
