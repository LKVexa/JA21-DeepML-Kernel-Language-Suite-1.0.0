module corpus.deepml_kernel.example_05785
use DeepMLKernel
policy no_network

kernel DMK_05785(input: Tensor<f32>[64,32]) -> Tensor<f32>[64,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..64 tile 32 {
        vectorize 16
        output[i] = input[i] * 20.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_05785.dmk"
