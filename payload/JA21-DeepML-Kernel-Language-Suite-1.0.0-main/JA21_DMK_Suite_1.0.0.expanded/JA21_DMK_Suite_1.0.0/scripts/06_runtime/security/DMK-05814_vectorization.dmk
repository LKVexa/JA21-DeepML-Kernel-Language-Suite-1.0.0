module corpus.deepml_kernel.example_05814
use DeepMLKernel
policy no_network

kernel DMK_05814(input: Tensor<f32>[93,48]) -> Tensor<f32>[93,48]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..93 tile 32 {
        vectorize 16
        output[i] = input[i] * 18.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_05814.dmk"
