module corpus.deepml_kernel.example_05760
use DeepMLKernel
policy no_network

kernel DMK_05760(input: Tensor<f32>[39,16]) -> Tensor<f32>[39,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..39 tile 16 {
        vectorize 16
        output[i] = input[i] * 26.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_05760.dmk"
