module corpus.deepml_kernel.example_05762
use DeepMLKernel
policy no_network

kernel DMK_05762(input: Tensor<f32>[41,48]) -> Tensor<f32>[41,48]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..41 tile 32 {
        vectorize 16
        output[i] = input[i] * 28.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_05762.dmk"
