module corpus.deepml_kernel.example_05769
use DeepMLKernel
policy no_network

kernel DMK_05769(input: Tensor<f32>[48,32]) -> Tensor<f32>[48,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..48 tile 32 {
        vectorize 16
        output[i] = input[i] * 4.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_05769.dmk"
