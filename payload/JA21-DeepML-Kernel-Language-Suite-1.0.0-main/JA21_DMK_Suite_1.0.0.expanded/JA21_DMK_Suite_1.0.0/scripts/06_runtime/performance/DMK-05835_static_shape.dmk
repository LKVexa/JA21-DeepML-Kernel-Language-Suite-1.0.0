module corpus.deepml_kernel.example_05835
use DeepMLKernel
policy no_network

kernel DMK_05835(input: Tensor<f32>[17,64]) -> Tensor<f32>[17,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..17 tile 32 {
        vectorize 16
        output[i] = input[i] * 8.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05835.dmk"
