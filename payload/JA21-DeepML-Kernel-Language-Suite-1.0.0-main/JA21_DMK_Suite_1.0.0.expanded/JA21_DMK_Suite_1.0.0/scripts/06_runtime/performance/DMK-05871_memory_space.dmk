module corpus.deepml_kernel.example_05871
use DeepMLKernel
policy no_network

kernel DMK_05871(input: Tensor<f32>[53,64]) -> Tensor<f32>[53,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..53 tile 32 {
        vectorize 16
        output[i] = input[i] * 13.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05871.dmk"
