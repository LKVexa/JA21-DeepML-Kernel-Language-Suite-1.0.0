module corpus.deepml_kernel.example_05855
use DeepMLKernel
policy no_network

kernel DMK_05855(input: Tensor<f32>[37,64]) -> Tensor<f32>[37,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..37 tile 32 {
        vectorize 16
        output[i] = input[i] * 28.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05855.dmk"
