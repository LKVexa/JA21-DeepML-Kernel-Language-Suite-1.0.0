module corpus.deepml_kernel.example_05938
use DeepMLKernel
policy no_network

kernel DMK_05938(input: Tensor<f32>[23,48]) -> Tensor<f32>[23,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..23 tile 32 {
        vectorize 16
        output[i] = input[i] * 18.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05938.dmk"
