module corpus.deepml_kernel.example_05926
use DeepMLKernel
policy no_network

kernel DMK_05926(input: Tensor<f32>[11,48]) -> Tensor<f32>[11,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..11 tile 32 {
        vectorize 16
        output[i] = input[i] * 6.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05926.dmk"
