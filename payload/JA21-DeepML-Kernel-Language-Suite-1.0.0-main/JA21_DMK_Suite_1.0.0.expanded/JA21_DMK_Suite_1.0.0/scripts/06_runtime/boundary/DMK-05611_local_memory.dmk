module corpus.deepml_kernel.example_05611
use DeepMLKernel
policy no_network

kernel DMK_05611(input: Tensor<f32>[84,1]) -> Tensor<f32>[84,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..84 tile 1 {
        vectorize 1
        output[i] = input[i] * 1.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05611.dmk"
