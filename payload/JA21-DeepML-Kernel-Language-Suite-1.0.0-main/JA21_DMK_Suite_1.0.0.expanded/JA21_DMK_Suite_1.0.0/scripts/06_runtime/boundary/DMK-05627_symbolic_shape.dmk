module corpus.deepml_kernel.example_05627
use DeepMLKernel
policy no_network

kernel DMK_05627(input: Tensor<f32>[3,1]) -> Tensor<f32>[3,1]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..3 tile 1 {
        vectorize 1
        output[i] = input[i] * 17.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05627.dmk"
