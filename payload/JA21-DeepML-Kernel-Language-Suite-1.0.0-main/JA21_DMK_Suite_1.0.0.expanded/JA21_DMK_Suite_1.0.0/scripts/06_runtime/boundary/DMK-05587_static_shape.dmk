module corpus.deepml_kernel.example_05587
use DeepMLKernel
policy no_network

kernel DMK_05587(input: Tensor<f32>[60,1]) -> Tensor<f32>[60,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..60 tile 1 {
        vectorize 1
        output[i] = input[i] * 8.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05587.dmk"
