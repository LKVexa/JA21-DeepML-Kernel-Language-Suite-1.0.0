module corpus.deepml_kernel.example_05576
use DeepMLKernel
policy no_network

kernel DMK_05576(input: Tensor<f32>[49,1]) -> Tensor<f32>[49,1]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..49 tile 1 {
        vectorize 1
        output[i] = input[i] * 28.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05576.dmk"
