module corpus.deepml_kernel.example_05579
use DeepMLKernel
policy no_network

kernel DMK_05579(input: Tensor<f32>[52,1]) -> Tensor<f32>[52,1]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..52 tile 1 {
        vectorize 1
        output[i] = input[i] * 31.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05579.dmk"
