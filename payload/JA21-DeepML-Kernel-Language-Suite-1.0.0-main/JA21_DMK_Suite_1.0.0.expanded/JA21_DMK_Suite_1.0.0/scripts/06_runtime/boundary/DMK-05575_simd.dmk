module corpus.deepml_kernel.example_05575
use DeepMLKernel
policy no_network

kernel DMK_05575(input: Tensor<f32>[48,1]) -> Tensor<f32>[48,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..48 tile 1 {
        vectorize 1
        output[i] = input[i] * 27.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05575.dmk"
