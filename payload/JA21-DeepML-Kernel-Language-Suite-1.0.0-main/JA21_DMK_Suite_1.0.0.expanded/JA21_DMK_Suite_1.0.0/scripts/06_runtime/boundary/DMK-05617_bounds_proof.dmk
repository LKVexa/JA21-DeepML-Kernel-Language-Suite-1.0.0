module corpus.deepml_kernel.example_05617
use DeepMLKernel
policy no_network

kernel DMK_05617(input: Tensor<f32>[90,1]) -> Tensor<f32>[90,1]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..90 tile 1 {
        vectorize 1
        output[i] = input[i] * 7.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05617.dmk"
