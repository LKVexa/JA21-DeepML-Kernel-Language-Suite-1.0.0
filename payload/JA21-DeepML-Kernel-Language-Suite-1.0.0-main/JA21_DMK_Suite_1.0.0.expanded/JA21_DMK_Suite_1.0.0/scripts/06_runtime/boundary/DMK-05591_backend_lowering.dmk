module corpus.deepml_kernel.example_05591
use DeepMLKernel
policy no_network

kernel DMK_05591(input: Tensor<f32>[64,1]) -> Tensor<f32>[64,1]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..64 tile 1 {
        vectorize 1
        output[i] = input[i] * 12.0
    }
}
verify bounds with checked
assert kernel.race_free == true
emit kernel "DMK_05591.dmk"
