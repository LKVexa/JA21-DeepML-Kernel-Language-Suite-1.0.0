module corpus.deepml_kernel.example_05490
use DeepMLKernel
policy no_network

kernel DMK_05490(input: Tensor<f32>[60,48]) -> Tensor<f32>[60,48]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..60 tile 32 {
        vectorize 16
        output[i] = input[i] * 4.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_05490.dmk"
