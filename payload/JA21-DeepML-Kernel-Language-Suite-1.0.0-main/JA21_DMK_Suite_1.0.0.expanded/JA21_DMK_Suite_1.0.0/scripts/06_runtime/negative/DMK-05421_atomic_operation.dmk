module corpus.deepml_kernel.example_05421
use DeepMLKernel
policy no_network

kernel DMK_05421(input: Tensor<f32>[88,32]) -> Tensor<f32>[88,32]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..88 tile 32 {
        vectorize 16
        output[i] = input[i] * 28.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_05421.dmk"
