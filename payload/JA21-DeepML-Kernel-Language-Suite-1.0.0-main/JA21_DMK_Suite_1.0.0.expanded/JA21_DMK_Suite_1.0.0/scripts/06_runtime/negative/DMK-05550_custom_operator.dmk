module corpus.deepml_kernel.example_05550
use DeepMLKernel
policy no_network

kernel DMK_05550(input: Tensor<f32>[23,48]) -> Tensor<f32>[23,48]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..23 tile 32 {
        vectorize 16
        output[i] = input[i] * 2.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_05550.dmk"
