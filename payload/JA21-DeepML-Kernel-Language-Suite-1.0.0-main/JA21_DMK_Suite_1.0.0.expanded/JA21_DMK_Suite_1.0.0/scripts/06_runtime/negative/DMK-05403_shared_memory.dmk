module corpus.deepml_kernel.example_05403
use DeepMLKernel
policy no_network

kernel DMK_05403(input: Tensor<f32>[70,64]) -> Tensor<f32>[70,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..70 tile 32 {
        vectorize 16
        output[i] = input[i] * 10.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_05403.dmk"
