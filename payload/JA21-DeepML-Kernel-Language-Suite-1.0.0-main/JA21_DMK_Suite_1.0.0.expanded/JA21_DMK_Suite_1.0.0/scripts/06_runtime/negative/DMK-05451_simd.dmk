module corpus.deepml_kernel.example_05451
use DeepMLKernel
policy no_network

kernel DMK_05451(input: Tensor<f32>[21,64]) -> Tensor<f32>[21,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..21 tile 32 {
        vectorize 16
        output[i] = input[i] * 27.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_05451.dmk"
