module corpus.deepml_kernel.example_05518
use DeepMLKernel
policy no_network

kernel DMK_05518(input: Tensor<f32>[88,48]) -> Tensor<f32>[88,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..88 tile 32 {
        vectorize 16
        output[i] = input[i] * 1.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_05518.dmk"
