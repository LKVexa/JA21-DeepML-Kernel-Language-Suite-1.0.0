module corpus.deepml_kernel.example_05535
use DeepMLKernel
policy no_network

kernel DMK_05535(input: Tensor<f32>[8,64]) -> Tensor<f32>[8,64]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..8 tile 32 {
        vectorize 16
        output[i] = input[i] * 18.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_05535.dmk"
