module corpus.deepml_kernel.example_05459
use DeepMLKernel
policy no_network

kernel DMK_05459(input: Tensor<f32>[29,64]) -> Tensor<f32>[29,64]
target npu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..29 tile 32 {
        vectorize 16
        output[i] = input[i] * 4.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_05459.dmk"
