module corpus.deepml_kernel.example_05470
use DeepMLKernel
policy no_network

kernel DMK_05470(input: Tensor<f32>[40,48]) -> Tensor<f32>[40,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..40 tile 32 {
        vectorize 16
        output[i] = input[i] * 15.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_05470.dmk"
