module corpus.deepml_kernel.example_05494
use DeepMLKernel
policy no_network

kernel DMK_05494(input: Tensor<f32>[64,48]) -> Tensor<f32>[64,48]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..64 tile 32 {
        vectorize 16
        output[i] = input[i] * 8.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_05494.dmk"
