ja source 0.3
module corpus.deepml_kernel.example_05533
use DeepMLKernel
policy no_network

kernel DMK_05533(input: Tensor<f32>[6,32]) -> Tensor<f32>[6,32]
target gpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..6 tile 32 {
        vectorize 16
        output[i] = input[i] * 16.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_05533.dmk"
