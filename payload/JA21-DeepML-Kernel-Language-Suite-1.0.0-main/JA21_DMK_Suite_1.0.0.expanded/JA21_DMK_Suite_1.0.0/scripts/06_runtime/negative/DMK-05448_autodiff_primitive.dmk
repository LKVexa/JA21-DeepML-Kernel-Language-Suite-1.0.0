ja source 0.3
module corpus.deepml_kernel.example_05448
use DeepMLKernel
policy no_network

kernel DMK_05448(input: Tensor<f32>[18,16]) -> Tensor<f32>[18,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..18 tile 16 {
        vectorize 16
        output[i] = input[i] * 24.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_05448.dmk"
