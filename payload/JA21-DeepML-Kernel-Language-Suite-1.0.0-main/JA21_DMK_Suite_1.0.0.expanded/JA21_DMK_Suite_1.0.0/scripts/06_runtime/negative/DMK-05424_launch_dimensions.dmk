module corpus.deepml_kernel.example_05424
use DeepMLKernel
policy no_network

kernel DMK_05424(input: Tensor<f32>[91,16]) -> Tensor<f32>[91,16]
target cpu
precision strict
determinism reproducible
memory global
{
    parallel for i in 0..91 tile 16 {
        vectorize 16
        output[i] = input[i] * 31.0
    }
}
verify bounds with unchecked
assert kernel.race_free == false
emit kernel "DMK_05424.dmk"
